diff --git a/src/zune_music.h b/src/zune_music.h
new file mode 100644
index 0000000..73b58d6
--- /dev/null
+++ b/src/zune_music.h
@@ -0,0 +1,1498 @@
+/* SPDX-License-Identifier: MIT */
+/* The Zune theme's music: the Zune HD's collection, on Muse.
+ *
+ * CODE, NOT A HEADER: included once into main.c, not compiled alone, and
+ * named .h only so the builds' wildcard of .c files does not pick it up,
+ * while their wildcard of .h files still sees it change. It is Muse's screens, and it
+ * needs Muse's state (the library, covers, the queue, the lock) the way the
+ * rest of Muse's screens in main.c do. Drawing is src/zune.c's.
+ *
+ *   music     artists  albums  songs  playlists  genres  audiobooks
+ *     artist    albums  songs
+ *     genre     albums  songs
+ *     album / playlist: the cover, and its tracks
+ *   now playing, its list, ratings, smart dj; quickplay on the hub
+ *
+ * Left and right swing the pivots, as a swipe did on the Zune; Y is the jump
+ * list; X is what holding a finger on something did - the context menu.
+ *
+ * What the folders cannot say - a song's own title, its genre, its year and
+ * length - comes from Music/.zune/library.tsv, which scripts/moodlists.py
+ * writes from the tags and the public databases. Without it everything still
+ * works from the folder names, and the genres pivot is simply not there.
+ * Plays and ratings are kept beside it, in plays.log and ratings.tsv. */
+
+#define ZX_DIR "Music/.zune"
+
+/* ---- what is known about each track --------------------------------------- */
+
+typedef struct {
+	const char *title, *artist, *album, *genre, *tags;
+	int year, secs, num, bpm;
+} zx_meta;
+
+static unsigned    zx_gen = (unsigned)-1;    /* g_muse_gen this was built for */
+static zx_meta    *zx_m;                     /* per real track */
+static char       *zx_blob;                  /* library.tsv, owning the strings */
+static int        *zx_real;                  /* track -> the real track it is */
+static int        *zx_alb;                   /* real track -> its album */
+static int        *zx_plays;
+static long       *zx_last;                  /* when last heard, per real track */
+static signed char *zx_rate;
+static long       *zx_added;                 /* per album: its folder's mtime */
+static long       *zx_heard;                 /* per album: last heard */
+static int        *zx_hash, zx_hcap;         /* path -> real track */
+static char      **zx_genre;                 /* the distinct genres, sorted */
+static int         zx_ngenre;
+static bool        zx_have_index;
+
+static unsigned zx_fnv(const char *s)
+{
+	unsigned h = 2166136261u;
+
+	while (*s) { h ^= (unsigned char)*s++; h *= 16777619u; }
+	return h;
+}
+
+static int zx_find(const char *path)
+{
+	unsigned h;
+
+	if (!zx_hash || !path) return -1;
+	for (h = zx_fnv(path) & (unsigned)(zx_hcap - 1); zx_hash[h] >= 0;
+	     h = (h + 1) & (unsigned)(zx_hcap - 1))
+		if (!strcmp(g_muse.tracks[zx_hash[h]].path, path)) return zx_hash[h];
+	return -1;
+}
+
+static void zx_free(void)
+{
+	int i;
+
+	free(zx_m); free(zx_blob); free(zx_real); free(zx_alb); free(zx_plays);
+	free(zx_last); free(zx_rate); free(zx_added); free(zx_heard); free(zx_hash);
+	for (i = 0; i < zx_ngenre; i++) free(zx_genre[i]);
+	free(zx_genre);
+	zx_m = NULL; zx_blob = NULL; zx_real = zx_alb = zx_plays = NULL;
+	zx_last = zx_added = zx_heard = NULL; zx_rate = NULL; zx_hash = NULL;
+	zx_genre = NULL; zx_ngenre = 0; zx_hcap = 0; zx_have_index = false;
+}
+
+static char *zx_slurp(const char *rel, size_t *len)
+{
+	char path[LIB_PATH * 2];
+	FILE *f;
+	char *b = NULL;
+	long n;
+
+	snprintf(path, sizeof path, "%s/%s/%s", P_CARD, ZX_DIR, rel);
+	if (!(f = fopen(path, "rb"))) return NULL;
+	if (fseek(f, 0, SEEK_END) == 0 && (n = ftell(f)) >= 0 && n < 64L * 1024 * 1024 &&
+	    fseek(f, 0, SEEK_SET) == 0 && (b = malloc((size_t)n + 1)) &&
+	    fread(b, 1, (size_t)n, f) == (size_t)n) {
+		b[n] = '\0';
+		if (len) *len = (size_t)n;
+	} else {
+		free(b);
+		b = NULL;
+	}
+	fclose(f);
+	return b;
+}
+
+/* The next tab-separated field of `*p`, cut out in place. */
+static char *zx_field(char **p)
+{
+	char *s = *p, *t;
+
+	if (!s) return "";
+	if ((t = strchr(s, '\t'))) { *t = '\0'; *p = t + 1; }
+	else *p = NULL;
+	return s;
+}
+
+static int zx_cmp_str(const void *a, const void *b)
+{
+	return strcasecmp(*(char *const *)a, *(char *const *)b);
+}
+
+static bool zx_is_music(int al)
+{
+	return al >= 0 && al < g_muse.nalbums && !g_muse.albums[al].book &&
+	       !g_muse.albums[al].playlist;
+}
+
+static void zx_build(void)
+{
+	int n = g_muse.ntracks, i, al;
+	char *b, *line, *next;
+
+	zx_free();
+	zx_gen = g_muse_gen;
+	if (n <= 0) return;
+	for (zx_hcap = 64; zx_hcap < n * 2; zx_hcap *= 2) { }
+	zx_hash = malloc(sizeof *zx_hash * (size_t)zx_hcap);
+	zx_m = calloc((size_t)n, sizeof *zx_m);
+	zx_real = malloc(sizeof *zx_real * (size_t)n);
+	zx_alb = malloc(sizeof *zx_alb * (size_t)n);
+	zx_plays = calloc((size_t)n, sizeof *zx_plays);
+	zx_last = calloc((size_t)n, sizeof *zx_last);
+	zx_rate = calloc((size_t)n, sizeof *zx_rate);
+	zx_added = calloc((size_t)(g_muse.nalbums + 1), sizeof *zx_added);
+	zx_heard = calloc((size_t)(g_muse.nalbums + 1), sizeof *zx_heard);
+	if (!zx_hash || !zx_m || !zx_real || !zx_alb || !zx_plays || !zx_last || !zx_rate ||
+	    !zx_added || !zx_heard) {
+		zx_free();
+		zx_gen = g_muse_gen;
+		return;
+	}
+	for (i = 0; i < zx_hcap; i++) zx_hash[i] = -1;
+	for (i = 0; i < n; i++) zx_alb[i] = -1;
+	/* Real tracks first - playlists come last in the library, so a path's
+	 * first appearance is its album's. */
+	for (i = 0; i < n; i++) {
+		int r = zx_find(g_muse.tracks[i].path);
+
+		if (r < 0) {
+			unsigned h = zx_fnv(g_muse.tracks[i].path) & (unsigned)(zx_hcap - 1);
+
+			while (zx_hash[h] >= 0) h = (h + 1) & (unsigned)(zx_hcap - 1);
+			zx_hash[h] = i;
+			r = i;
+		}
+		zx_real[i] = r;
+	}
+	for (al = 0; al < g_muse.nalbums; al++) {
+		const ml_album *a = &g_muse.albums[al];
+		char dir[LIB_PATH * 2];
+		struct stat st;
+
+		if (a->playlist || a->n <= 0) continue;
+		for (i = a->first; i < a->first + a->n; i++) zx_alb[i] = al;
+		snprintf(dir, sizeof dir, "%s/%s", P_CARD, g_muse.tracks[a->first].path);
+		if (strrchr(dir, '/')) *strrchr(dir, '/') = '\0';
+		if (stat(dir, &st) == 0) zx_added[al] = (long)st.st_mtime;
+	}
+
+	/* library.tsv: path title artist album genre year seconds track bpm tags */
+	if ((zx_blob = zx_slurp("library.tsv", NULL))) {
+		for (line = zx_blob; line; line = next) {
+			char *p = line, *path;
+			int r;
+
+			next = strchr(line, '\n');
+			if (next) *next++ = '\0';
+			if (line[0] == '#' || !line[0]) continue;
+			if (strchr(line, '\r')) *strchr(line, '\r') = '\0';
+			path = zx_field(&p);
+			if ((r = zx_find(path)) < 0) continue;
+			zx_m[r].title  = zx_field(&p);
+			zx_m[r].artist = zx_field(&p);
+			zx_m[r].album  = zx_field(&p);
+			zx_m[r].genre  = zx_field(&p);
+			zx_m[r].year   = atoi(zx_field(&p));
+			zx_m[r].secs   = atoi(zx_field(&p));
+			zx_m[r].num    = atoi(zx_field(&p));
+			zx_m[r].bpm    = atoi(zx_field(&p));
+			zx_m[r].tags   = zx_field(&p);
+			zx_have_index = true;
+		}
+	}
+	/* plays.log: <unix time> TAB <path>, one line a listen. */
+	if ((b = zx_slurp("plays.log", NULL))) {
+		for (line = b; line; line = next) {
+			char *p = line;
+			long t;
+			int r;
+
+			next = strchr(line, '\n');
+			if (next) *next++ = '\0';
+			if (strchr(line, '\r')) *strchr(line, '\r') = '\0';
+			t = atol(zx_field(&p));
+			if (!p || (r = zx_find(p)) < 0) continue;
+			zx_plays[r]++;
+			if (t > zx_last[r]) zx_last[r] = t;
+			if (zx_alb[r] >= 0 && t > zx_heard[zx_alb[r]]) zx_heard[zx_alb[r]] = t;
+		}
+		free(b);
+	}
+	/* ratings.tsv: <path> TAB 1 | -1 */
+	if ((b = zx_slurp("ratings.tsv", NULL))) {
+		for (line = b; line; line = next) {
+			char *p = line, *path;
+			int r;
+
+			next = strchr(line, '\n');
+			if (next) *next++ = '\0';
+			if (strchr(line, '\r')) *strchr(line, '\r') = '\0';
+			path = zx_field(&p);
+			if (p && (r = zx_find(path)) >= 0) zx_rate[r] = (signed char)(atoi(p) > 0 ? 1 : atoi(p) < 0 ? -1 : 0);
+		}
+		free(b);
+	}
+	/* The genres, once each, whatever their case. */
+	if (zx_have_index) {
+		zx_genre = calloc((size_t)n, sizeof *zx_genre);
+		for (i = 0; zx_genre && i < n; i++) {
+			const char *g = zx_m[i].genre;
+			int k;
+
+			if (zx_real[i] != i || !g || !g[0] || !zx_is_music(zx_alb[i])) continue;
+			for (k = 0; k < zx_ngenre; k++) if (!strcasecmp(zx_genre[k], g)) break;
+			if (k == zx_ngenre && (zx_genre[zx_ngenre] = strdup(g))) zx_ngenre++;
+		}
+		if (zx_ngenre) qsort(zx_genre, (size_t)zx_ngenre, sizeof *zx_genre, zx_cmp_str);
+	}
+}
+
+static void zx_ensure(void)
+{
+	if (zx_gen != g_muse_gen) zx_build();
+}
+
+static int zx_r(int t) { return zx_real && t >= 0 && t < g_muse.ntracks ? zx_real[t] : t; }
+
+static const char *zx_title(int t)
+{
+	int r = zx_r(t);
+
+	if (zx_m && zx_m[r].title && zx_m[r].title[0]) return zx_m[r].title;
+	return g_muse.tracks[r].name;
+}
+
+static const char *zx_track_artist(int t)
+{
+	int r = zx_r(t), al = zx_alb ? zx_alb[r] : -1;
+
+	if (zx_m && zx_m[r].artist && zx_m[r].artist[0]) return zx_m[r].artist;
+	return al >= 0 ? g_muse.artists[muse_artist_of(al)].name : "";
+}
+
+static int zx_album_year(int al)
+{
+	const ml_album *a = &g_muse.albums[al];
+
+	return zx_m && a->n > 0 ? zx_m[zx_r(a->first)].year : 0;
+}
+
+static const char *zx_album_genre(int al)
+{
+	const ml_album *a = &g_muse.albums[al];
+
+	return zx_m && a->n > 0 && zx_m[zx_r(a->first)].genre ? zx_m[zx_r(a->first)].genre : "";
+}
+
+/* A listen, from musec: into the log on the card, and the counts. */
+static void zx_on_played(const char *path)
+{
+	char dir[LIB_PATH * 2], file[LIB_PATH * 2 + 16];
+	long now = (long)time(NULL);
+	FILE *f;
+	int r;
+
+	snprintf(dir, sizeof dir, "%s/%s", P_CARD, ZX_DIR);
+	mkdir(dir, 0755);
+	snprintf(file, sizeof file, "%s/plays.log", dir);
+	if ((f = fopen(file, "a"))) {
+		fprintf(f, "%ld\t%s\n", now, path);
+		fflush(f);
+		fsync(fileno(f));
+		fclose(f);
+	}
+	if (zx_gen == g_muse_gen && (r = zx_find(path)) >= 0) {
+		zx_plays[r]++;
+		zx_last[r] = now;
+		if (zx_alb[r] >= 0) zx_heard[zx_alb[r]] = now;
+	}
+}
+
+static void zx_rate_set(int t, int v)
+{
+	char dir[LIB_PATH * 2], file[LIB_PATH * 2 + 16], tmp[LIB_PATH * 2 + 24];
+	FILE *f;
+	int i;
+
+	zx_ensure();
+	if (!zx_rate) return;
+	zx_rate[zx_r(t)] = (signed char)v;
+	snprintf(dir, sizeof dir, "%s/%s", P_CARD, ZX_DIR);
+	mkdir(dir, 0755);
+	snprintf(file, sizeof file, "%s/ratings.tsv", dir);
+	snprintf(tmp, sizeof tmp, "%s.new", file);
+	if (!(f = fopen(tmp, "w"))) return;
+	for (i = 0; i < g_muse.ntracks; i++)
+		if (zx_real[i] == i && zx_rate[i])
+			fprintf(f, "%s\t%d\n", g_muse.tracks[i].path, zx_rate[i]);
+	fflush(f);
+	fsync(fileno(f));
+	fclose(f);
+	rename(tmp, file);
+}
+
+/* ---- covers, small, for lists ---------------------------------------------- */
+
+#define ZC_SLOTS 64
+#define ZC_SIDE 208
+static struct { int al; unsigned gen; SDL_Texture *t; int w, h; bool none; unsigned used; } zc[ZC_SLOTS];
+static unsigned zc_clock;
+static int zc_budget;                /* loads left this frame */
+static bool zc_pending;              /* something was put off: draw again */
+
+static SDL_Texture *zx_blur, *zx_blur_src;
+
+static void zc_flush(void)
+{
+	int i;
+
+	for (i = 0; i < ZC_SLOTS; i++)
+		if (zc[i].t) SDL_DestroyTexture(zc[i].t);
+	memset(zc, 0, sizeof zc);
+	if (zx_blur) SDL_DestroyTexture(zx_blur);
+	zx_blur = zx_blur_src = NULL;
+}
+
+/* A cover blurred: drawn into a texture a few pixels across and stretched
+ * back up with linear filtering, which is a blur for the price of two
+ * copies. Made once per cover. */
+static SDL_Texture *zx_blur_of(app *a, SDL_Texture *src)
+{
+	if (!src) return NULL;
+	if (src == zx_blur_src && zx_blur) return zx_blur;
+	if (!zx_blur) {
+		zx_blur = SDL_CreateTexture(a->r, SDL_PIXELFORMAT_ARGB8888, SDL_TEXTUREACCESS_TARGET, 12, 9);
+		if (!zx_blur) return NULL;
+		SDL_SetTextureScaleMode(zx_blur, SDL_ScaleModeLinear);
+		SDL_SetTextureBlendMode(zx_blur, SDL_BLENDMODE_BLEND);
+	}
+	SDL_SetRenderTarget(a->r, zx_blur);
+	SDL_RenderCopy(a->r, src, NULL, NULL);
+	plat_draw_to_screen();
+	zx_blur_src = src;
+	return zx_blur;
+}
+
+static SDL_Texture *zc_get(app *a, int al, int *w, int *h)
+{
+	char path[LIB_PATH * 2 + 8];
+	SDL_Surface *s, *small;
+	int i, slot = 0;
+
+	*w = *h = 0;
+	if (al < 0 || al >= g_muse.nalbums) return NULL;
+	for (i = 0; i < ZC_SLOTS; i++) {
+		if (zc[i].used && zc[i].al == al && zc[i].gen == g_muse_gen) {
+			zc[i].used = ++zc_clock;
+			*w = zc[i].w;
+			*h = zc[i].h;
+			return zc[i].t;
+		}
+		if (zc[i].used < zc[slot].used) slot = i;
+	}
+	if (zc_budget <= 0) { zc_pending = true; return NULL; }
+	if (!cover_file(al, path, sizeof path) &&
+	    !ml_folder_image(g_muse_root, &g_muse, al, path, sizeof path)) {
+		/* Asked of Muse and not answered yet: come back for it. Known to
+		 * have none: remember that, and draw the empty tile. A picture in
+		 * the album's folder does not wait for Muse - it is the answer Muse
+		 * would give for a record with none in its files. */
+		if (g_cov && g_cov[al].st != COV_NONE) { zc_pending = true; return NULL; }
+		s = NULL;
+	} else {
+		zc_budget--;
+		s = IMG_Load(path);
+	}
+	if (zc[slot].t) SDL_DestroyTexture(zc[slot].t);
+	memset(&zc[slot], 0, sizeof zc[slot]);
+	zc[slot].al = al;
+	zc[slot].gen = g_muse_gen;
+	zc[slot].used = ++zc_clock;
+	if (!s) { zc[slot].none = true; return NULL; }
+	/* Down to the size a list draws it, so sixty-four of them are a few MB
+	 * rather than sixty-four full covers. */
+	small = SDL_CreateRGBSurfaceWithFormat(0, ZC_SIDE, ZC_SIDE * s->h / (s->w > 0 ? s->w : 1),
+	                                       32, SDL_PIXELFORMAT_ARGB8888);
+	if (small) {
+		SDL_BlitScaled(s, NULL, small, NULL);
+		zc[slot].t = SDL_CreateTextureFromSurface(a->r, small);
+		zc[slot].w = small->w;
+		zc[slot].h = small->h;
+		SDL_FreeSurface(small);
+	}
+	SDL_FreeSurface(s);
+	*w = zc[slot].w;
+	*h = zc[slot].h;
+	return zc[slot].t;
+}
+
+/* ---- lists ----------------------------------------------------------------- */
+
+typedef enum {
+	ZL_ARTISTS, ZL_ALBUMS, ZL_SONGS, ZL_PLAYLISTS, ZL_GENRES, ZL_BOOKS,
+	ZL_ARTIST_ALBUMS, ZL_ARTIST_SONGS, ZL_GENRE_ALBUMS, ZL_GENRE_SONGS, ZL_TRACKS,
+} zl_kind;
+
+static const char *const ZL_NAME[] = {
+	[ZL_ARTISTS] = "artists", [ZL_ALBUMS] = "albums", [ZL_SONGS] = "songs",
+	[ZL_PLAYLISTS] = "playlists", [ZL_GENRES] = "genres", [ZL_BOOKS] = "audiobooks",
+	[ZL_ARTIST_ALBUMS] = "albums", [ZL_ARTIST_SONGS] = "songs",
+	[ZL_GENRE_ALBUMS] = "albums", [ZL_GENRE_SONGS] = "songs", [ZL_TRACKS] = "songs",
+};
+
+typedef struct {
+	zl_kind kind;
+	int *ids, n;          /* what each row is: artist, album, track, genre */
+	bool shuffle_row;     /* row 0 is "shuffle all" and ids start at row 1 */
+	int album;            /* ZL_TRACKS: whose */
+	int cursor;
+	coverflow cf;
+} zlist;
+
+static int zl_rows(const zlist *l) { return l->n + (l->shuffle_row ? 1 : 0); }
+
+/* For qsort: the key each kind sorts by. */
+static const char *zl_key_kind;
+static int zl_by_name(const void *x, const void *y)
+{
+	int a = *(const int *)x, b = *(const int *)y;
+	const char *p, *q;
+
+	if (!strcmp(zl_key_kind, "artist")) { p = g_muse.artists[a].name; q = g_muse.artists[b].name; }
+	else if (!strcmp(zl_key_kind, "album")) { p = g_muse.albums[a].name; q = g_muse.albums[b].name; }
+	else { p = zx_title(a); q = zx_title(b); }
+	{
+		int c = strcasecmp(p, q);
+
+		return c ? c : a - b;
+	}
+}
+
+static int zl_by_year(const void *x, const void *y)
+{
+	int a = *(const int *)x, b = *(const int *)y;
+	int ya = zx_album_year(a), yb = zx_album_year(b);
+
+	if (ya != yb) return ya && yb ? ya - yb : (ya ? -1 : 1);
+	return strcasecmp(g_muse.albums[a].name, g_muse.albums[b].name);
+}
+
+static void zl_sort(int *v, int n, const char *by)
+{
+	zl_key_kind = by;
+	if (n > 1) qsort(v, (size_t)n, sizeof *v, zl_by_name);
+}
+
+/* Fill `l` with its kind's rows. `id` is the artist, genre or album. */
+static void zl_fill(zlist *l, zl_kind kind, int id)
+{
+	int cap = g_muse.ntracks + g_muse.nalbums + g_muse.nartists + zx_ngenre + 1, i, al;
+
+	free(l->ids);
+	memset(l, 0, sizeof *l);
+	l->kind = kind;
+	l->ids = malloc(sizeof *l->ids * (size_t)cap);
+	if (!l->ids) return;
+	switch (kind) {
+	case ZL_ARTISTS:
+		for (i = 0; i < g_muse.nartists; i++) {
+			const ml_artist *ar = &g_muse.artists[i];
+			int k;
+
+			for (k = ar->first; k < ar->first + ar->n; k++)
+				if (zx_is_music(k)) { l->ids[l->n++] = i; break; }
+		}
+		zl_sort(l->ids, l->n, "artist");
+		break;
+	case ZL_ALBUMS:
+		for (al = 0; al < g_muse.nalbums; al++) if (zx_is_music(al)) l->ids[l->n++] = al;
+		zl_sort(l->ids, l->n, "album");
+		break;
+	case ZL_PLAYLISTS:
+		for (al = 0; al < g_muse.nalbums; al++)
+			if (g_muse.albums[al].playlist) l->ids[l->n++] = al;
+		break;
+	case ZL_BOOKS:
+		for (al = 0; al < g_muse.nalbums; al++)
+			if (g_muse.albums[al].book) l->ids[l->n++] = al;
+		zl_sort(l->ids, l->n, "album");
+		break;
+	case ZL_GENRES:
+		for (i = 0; i < zx_ngenre; i++) l->ids[l->n++] = i;
+		break;
+	case ZL_SONGS:
+		for (i = 0; i < g_muse.ntracks; i++)
+			if (zx_real[i] == i && zx_is_music(zx_alb[i])) l->ids[l->n++] = i;
+		zl_sort(l->ids, l->n, "song");
+		l->shuffle_row = l->n > 1;
+		break;
+	case ZL_ARTIST_ALBUMS: {
+		const ml_artist *ar = &g_muse.artists[id];
+
+		for (al = ar->first; al < ar->first + ar->n; al++)
+			if (zx_is_music(al)) l->ids[l->n++] = al;
+		if (l->n > 1) qsort(l->ids, (size_t)l->n, sizeof *l->ids, zl_by_year);
+		break;
+	}
+	case ZL_ARTIST_SONGS: {
+		const ml_artist *ar = &g_muse.artists[id];
+
+		for (al = ar->first; al < ar->first + ar->n; al++)
+			if (zx_is_music(al))
+				for (i = g_muse.albums[al].first; i < g_muse.albums[al].first + g_muse.albums[al].n; i++)
+					l->ids[l->n++] = i;
+		zl_sort(l->ids, l->n, "song");
+		l->shuffle_row = l->n > 1;
+		break;
+	}
+	case ZL_GENRE_ALBUMS:
+		for (al = 0; al < g_muse.nalbums; al++)
+			if (zx_is_music(al) && !strcasecmp(zx_album_genre(al), zx_genre[id]))
+				l->ids[l->n++] = al;
+		zl_sort(l->ids, l->n, "album");
+		break;
+	case ZL_GENRE_SONGS:
+		for (i = 0; i < g_muse.ntracks; i++)
+			if (zx_real[i] == i && zx_is_music(zx_alb[i]) && zx_m[i].genre &&
+			    !strcasecmp(zx_m[i].genre, zx_genre[id]))
+				l->ids[l->n++] = i;
+		zl_sort(l->ids, l->n, "song");
+		l->shuffle_row = l->n > 1;
+		break;
+	case ZL_TRACKS: {
+		const ml_album *a = &g_muse.albums[id];
+
+		for (i = a->first; i < a->first + a->n; i++) l->ids[l->n++] = i;
+		break;
+	}
+	}
+	l->album = kind == ZL_TRACKS ? id : -1;
+	cf_reset(&l->cf, 0);
+}
+
+/* The first letter a row is filed under, for the jump list: 0 for '#'. */
+static int zl_letter(const zlist *l, int row)
+{
+	const char *s = "";
+	int id;
+
+	if (l->shuffle_row) { if (row == 0) return -1; row--; }
+	if (row < 0 || row >= l->n) return -1;
+	id = l->ids[row];
+	switch (l->kind) {
+	case ZL_ARTISTS: s = g_muse.artists[id].name; break;
+	case ZL_GENRES:  s = zx_genre[id]; break;
+	case ZL_SONGS: case ZL_ARTIST_SONGS: case ZL_GENRE_SONGS: case ZL_TRACKS:
+		s = zx_title(id); break;
+	default:         s = g_muse.albums[id].name; break;
+	}
+	return (s[0] >= 'a' && s[0] <= 'z') ? s[0] - 'a' + 1
+	     : (s[0] >= 'A' && s[0] <= 'Z') ? s[0] - 'A' + 1 : 0;
+}
+
+/* ---- pages ----------------------------------------------------------------- */
+
+typedef enum { ZP_MUSIC, ZP_ARTIST, ZP_GENRE, ZP_ALBUM } zp_type;
+
+#define ZP_PIVOTS 6
+typedef struct {
+	zp_type type;
+	int id;
+	char title[160];
+	zlist l[ZP_PIVOTS];
+	int n, piv;
+	int slide_dir;          /* the pivot animation: which way, and since when */
+	unsigned slide_t0;
+} zpage;
+
+static void zp_free(zpage *p)
+{
+	int i;
+
+	for (i = 0; i < ZP_PIVOTS; i++) free(p->l[i].ids);
+	memset(p, 0, sizeof *p);
+}
+
+static void zp_add(zpage *p, zl_kind kind, int id, bool keep_empty)
+{
+	if (p->n >= ZP_PIVOTS) return;
+	zl_fill(&p->l[p->n], kind, id);
+	if (zl_rows(&p->l[p->n]) > 0 || keep_empty) p->n++;
+	else { free(p->l[p->n].ids); memset(&p->l[p->n], 0, sizeof p->l[p->n]); }
+}
+
+static void zp_open(zpage *p, zp_type type, int id)
+{
+	zp_free(p);
+	p->type = type;
+	p->id = id;
+	switch (type) {
+	case ZP_MUSIC:
+		snprintf(p->title, sizeof p->title, "music");
+		zp_add(p, ZL_ARTISTS, 0, true);
+		zp_add(p, ZL_ALBUMS, 0, true);
+		zp_add(p, ZL_SONGS, 0, true);
+		zp_add(p, ZL_PLAYLISTS, 0, false);
+		zp_add(p, ZL_GENRES, 0, false);
+		zp_add(p, ZL_BOOKS, 0, false);
+		break;
+	case ZP_ARTIST:
+		snprintf(p->title, sizeof p->title, "%s", g_muse.artists[id].name);
+		zp_add(p, ZL_ARTIST_ALBUMS, id, true);
+		zp_add(p, ZL_ARTIST_SONGS, id, true);
+		break;
+	case ZP_GENRE:
+		snprintf(p->title, sizeof p->title, "%s", zx_genre[id]);
+		zp_add(p, ZL_GENRE_ALBUMS, id, true);
+		zp_add(p, ZL_GENRE_SONGS, id, true);
+		break;
+	case ZP_ALBUM:
+		snprintf(p->title, sizeof p->title, "%s", g_muse.albums[id].name);
+		zp_add(p, ZL_TRACKS, id, true);
+		break;
+	}
+}
+
+/* ---- rows ------------------------------------------------------------------ */
+
+typedef struct { app *a; zlist *l; } zrow_ctx;
+
+static bool zrow_get(void *ctx, int i, zune_row *out)
+{
+	static char sub[256], num[16], right[16];
+	zrow_ctx *c = ctx;
+	zlist *l = c->l;
+	int id, k;
+
+	if (l->shuffle_row) {
+		if (i == 0) { out->title = "shuffle all"; return true; }
+		i--;
+	}
+	if (i < 0 || i >= l->n) return false;
+	id = l->ids[i];
+	switch (l->kind) {
+	case ZL_ARTISTS: {
+		const ml_artist *ar = &g_muse.artists[id];
+		int albums = 0, songs = 0;
+
+		for (k = ar->first; k < ar->first + ar->n; k++)
+			if (zx_is_music(k)) { albums++; songs += g_muse.albums[k].n; }
+		out->title = ar->name;
+		snprintf(sub, sizeof sub, "%d album%s, %d song%s", albums, albums == 1 ? "" : "s",
+		         songs, songs == 1 ? "" : "s");
+		out->sub = sub;
+		break;
+	}
+	case ZL_GENRES: {
+		int albums = 0;
+
+		for (k = 0; k < g_muse.nalbums; k++)
+			if (zx_is_music(k) && !strcasecmp(zx_album_genre(k), zx_genre[id])) albums++;
+		out->title = zx_genre[id];
+		snprintf(sub, sizeof sub, "%d album%s", albums, albums == 1 ? "" : "s");
+		out->sub = sub;
+		break;
+	}
+	case ZL_ALBUMS: case ZL_PLAYLISTS: case ZL_BOOKS: case ZL_ARTIST_ALBUMS: case ZL_GENRE_ALBUMS: {
+		const ml_album *al = &g_muse.albums[id];
+		int y = zx_album_year(id);
+
+		out->art = zc_get(c->a, id, &out->aw, &out->ah);
+		out->title = al->name;
+		if (al->playlist)
+			snprintf(sub, sizeof sub, "%d song%s", al->n, al->n == 1 ? "" : "s");
+		else if (l->kind == ZL_ARTIST_ALBUMS && y)
+			snprintf(sub, sizeof sub, "%d, %d song%s", y, al->n, al->n == 1 ? "" : "s");
+		else if (l->kind == ZL_ARTIST_ALBUMS)
+			snprintf(sub, sizeof sub, "%d song%s", al->n, al->n == 1 ? "" : "s");
+		else if (al->book && g_book_done && g_book_done[id])
+			snprintf(sub, sizeof sub, "finished");
+		else
+			snprintf(sub, sizeof sub, "%s", g_muse.artists[muse_artist_of(id)].name);
+		out->sub = sub;
+		break;
+	}
+	case ZL_TRACKS: {
+		int r = zx_r(id);
+
+		out->title = zx_title(id);
+		/* A playlist's songs are many artists': say whose. Its numbers are
+		 * its own order, not the albums' track numbers. */
+		if (l->album >= 0 && g_muse.albums[l->album].playlist) {
+			snprintf(sub, sizeof sub, "%s", zx_track_artist(id));
+			out->sub = sub;
+			snprintf(num, sizeof num, "%d", i + 1);
+		} else {
+			snprintf(num, sizeof num, "%d", zx_m[r].num > 0 ? zx_m[r].num : i + 1);
+		}
+		out->num = num;
+		if (zx_m[r].secs > 0) {
+			snprintf(right, sizeof right, "%d:%02d", zx_m[r].secs / 60, zx_m[r].secs % 60);
+			out->right = right;
+		}
+		out->rating = zx_rate[r];
+		break;
+	}
+	default: {           /* songs */
+		int r = zx_r(id);
+
+		out->title = zx_title(id);
+		snprintf(sub, sizeof sub, "%s", zx_track_artist(id));
+		out->sub = sub;
+		out->rating = zx_rate[r];
+		break;
+	}
+	}
+	return true;
+}
+
+/* ---- playing ----------------------------------------------------------------- */
+
+static void zx_play_tracks(const int *t, int n, int start, bool shuffle, int album)
+{
+	const char **paths;
+	int i;
+
+	if (n <= 0) return;
+	paths = malloc(sizeof *paths * (size_t)n);
+	if (!paths) return;
+	for (i = 0; i < n; i++) paths[i] = g_muse.tracks[t[i]].path;
+	if (shuffle) {
+		/* Ours, not the play mode's: "shuffle" here is this once. */
+		unsigned s = plat_now_ms() * 2654435761u + 7;
+
+		for (i = n - 1; i > 0; i--) {
+			int j;
+			const char *x;
+
+			s ^= s << 13; s ^= s >> 17; s ^= s << 5;
+			j = (int)(s % (unsigned)(i + 1));
+			x = paths[i]; paths[i] = paths[j]; paths[j] = x;
+		}
+		start = 0;
+	}
+	muse_play(paths, n, start, 0, false, 1.0, "", "");
+	g_queue_album = album;
+	free(paths);
+}
+
+static void zx_queue_tracks(const int *t, int n, bool next)
+{
+	const char **paths;
+	int i;
+
+	if (n <= 0 || !(paths = malloc(sizeof *paths * (size_t)n))) return;
+	for (i = 0; i < n; i++) paths[i] = g_muse.tracks[t[i]].path;
+	musec_append(paths, n, next);
+	free(paths);
+}
+
+/* The tracks a row stands for: an artist's, an album's, a genre's, or one. */
+static int zx_row_tracks(const zlist *l, int row, int *out, int cap, int *album)
+{
+	int n = 0, id, i, al;
+
+	*album = -1;
+	if (l->shuffle_row) { if (row == 0) { for (i = 0; i < l->n && n < cap; i++) out[n++] = l->ids[i]; return n; } row--; }
+	if (row < 0 || row >= l->n) return 0;
+	id = l->ids[row];
+	switch (l->kind) {
+	case ZL_ARTISTS: {
+		const ml_artist *ar = &g_muse.artists[id];
+
+		for (al = ar->first; al < ar->first + ar->n; al++)
+			if (zx_is_music(al))
+				for (i = 0; i < g_muse.albums[al].n && n < cap; i++)
+					out[n++] = g_muse.albums[al].first + i;
+		break;
+	}
+	case ZL_GENRES:
+		for (i = 0; i < g_muse.ntracks && n < cap; i++)
+			if (zx_real[i] == i && zx_is_music(zx_alb[i]) && zx_m[i].genre &&
+			    !strcasecmp(zx_m[i].genre, zx_genre[id]))
+				out[n++] = i;
+		break;
+	case ZL_ALBUMS: case ZL_PLAYLISTS: case ZL_BOOKS: case ZL_ARTIST_ALBUMS: case ZL_GENRE_ALBUMS:
+		*album = id;
+		for (i = 0; i < g_muse.albums[id].n && n < cap; i++) out[n++] = g_muse.albums[id].first + i;
+		break;
+	default:
+		out[n++] = id;
+		break;
+	}
+	return n;
+}
+
+/* Smart DJ: songs like the seed, from what library.tsv knows - shared tags
+ * and genre first, then era and tempo - played in a shuffled order. Without
+ * the index it can only go by artist, and does. */
+static void zx_smart_dj(const int *seed, int ns)
+{
+	int n = g_muse.ntracks, i, k, *pick, np = 0;
+	float *score;
+	int seed_year = 0, seed_bpm = 0, ny = 0, nb = 0;
+
+	if (ns <= 0 || n <= 0) return;
+	score = calloc((size_t)n, sizeof *score);
+	pick = malloc(sizeof *pick * (size_t)n);
+	if (!score || !pick) { free(score); free(pick); return; }
+	for (k = 0; k < ns; k++) {
+		int r = zx_r(seed[k]);
+
+		if (zx_m[r].year) { seed_year += zx_m[r].year; ny++; }
+		if (zx_m[r].bpm)  { seed_bpm += zx_m[r].bpm; nb++; }
+	}
+	if (ny) seed_year /= ny;
+	if (nb) seed_bpm /= nb;
+	for (i = 0; i < n; i++) {
+		float s = 0;
+		const char *art = zx_track_artist(i);
+
+		if (zx_real[i] != i || !zx_is_music(zx_alb[i]) || zx_rate[i] < 0) continue;
+		for (k = 0; k < ns && k < 64; k++) {
+			int r = zx_r(seed[k]);
+
+			if (zx_m[r].genre && zx_m[i].genre && zx_m[r].genre[0] &&
+			    !strcasecmp(zx_m[r].genre, zx_m[i].genre)) s += 2.0f / (ns < 64 ? ns : 64);
+			if (zx_m[r].tags && zx_m[i].tags && zx_m[r].tags[0]) {
+				/* Each tag of the seed that this song has too. */
+				char tags[512], *save = NULL, *tok;
+
+				snprintf(tags, sizeof tags, "%s", zx_m[r].tags);
+				for (tok = strtok_r(tags, ",", &save); tok; tok = strtok_r(NULL, ",", &save))
+					if (tok[0] && strcasestr(zx_m[i].tags, tok)) s += 1.0f / (ns < 64 ? ns : 64);
+			}
+			if (!strcasecmp(art, zx_track_artist(seed[k]))) s += 1.5f / (ns < 64 ? ns : 64);
+		}
+		if (ny && zx_m[i].year) s += fmaxf(0, 1.0f - fabsf((float)(zx_m[i].year - seed_year)) / 8.0f);
+		if (nb && zx_m[i].bpm)  s += 0.5f * fmaxf(0, 1.0f - fabsf((float)(zx_m[i].bpm - seed_bpm)) / 20.0f);
+		if (zx_rate[i] > 0) s += 0.3f;
+		/* A little chance, so two mixes from one seed are not the same. */
+		s += (float)(rand() % 100) / 400.0f;
+		score[i] = s;
+		if (s > 0.6f) pick[np++] = i;
+	}
+	/* The best fifty, then shuffled. */
+	for (i = 0; i < np; i++)
+		for (k = i + 1; k < np; k++)
+			if (score[pick[k]] > score[pick[i]]) { int t = pick[i]; pick[i] = pick[k]; pick[k] = t; }
+	if (np > 50) np = 50;
+	if (np < 5) {          /* nothing to go by: the seed itself, shuffled */
+		np = 0;
+		for (k = 0; k < ns && np < n; k++) pick[np++] = zx_r(seed[k]);
+	}
+	fprintf(stderr, "zune: smart dj, %d songs from %d seeds\n", np, ns);
+	zx_play_tracks(pick, np, 0, true, -1);
+	free(score);
+	free(pick);
+}
+
+/* ---- drawing ------------------------------------------------------------------ */
+
+static float zp_ease(unsigned t0, unsigned ms)
+{
+	float u = (float)(plat_now_ms() - t0) / ms;
+
+	if (u >= 1) return 1;
+	u = 1 - u;
+	return 1 - u * u * u;
+}
+
+static const zune_list_style *zl_style(zl_kind k, bool playlist_tracks)
+{
+	static const zune_list_style PL = { 78, 0, ZF_SUB, ZF_SMALL, 58 };
+
+	switch (k) {
+	case ZL_ALBUMS: case ZL_PLAYLISTS: case ZL_BOOKS: case ZL_ARTIST_ALBUMS: case ZL_GENRE_ALBUMS:
+		return &ZUNE_ART_ROWS;
+	case ZL_TRACKS:
+		return playlist_tracks ? &PL : &ZUNE_TRACK_ROWS;
+	default:
+		return &ZUNE_TEXT_ROWS;
+	}
+}
+
+static bool zp_draw(app *a, zpage *p)
+{
+	SDL_Renderer *r = a->r;
+	zlist *l = &p->l[p->piv];
+	zrow_ctx c = { a, l };
+	bool moving = false;
+
+	zc_budget = 3;
+	zc_pending = false;
+	zune_clear(r);
+	if (p->type == ZP_ALBUM) {
+		const ml_album *al = &g_muse.albums[p->id];
+		SDL_Rect cov = { 48, 176, 264, 264 };
+		SDL_Texture *t;
+		int w, h, y = zx_album_year(p->id), secs = 0, i;
+		char line[96], low[256];
+		bool pl = al->playlist;
+
+		/* The artist across the top, as the Zune's album page had it. */
+		zune_panorama(r, pl ? "playlist" : g_muse.artists[muse_artist_of(p->id)].name,
+		              -40, 0, (SDL_Color){ 255, 255, 255, 70 });
+		t = zc_get(a, p->id, &w, &h);
+		zune_tile(r, t, w, h, &cov, 255);
+		zune_lower(al->name, low, sizeof low);
+		zune_text_fit(r, zune_font(ZF_ROW), low, cov.x, cov.y + cov.h + 18, cov.w, ZUNE_WHITE);
+		for (i = 0; i < al->n; i++) secs += zx_m[zx_r(al->first + i)].secs;
+		{
+			char yr[16] = "", mins[24] = "";
+
+			if (y && !pl) snprintf(yr, sizeof yr, "%d  -  ", y);
+			if (secs) snprintf(mins, sizeof mins, ", %d min", (secs + 30) / 60);
+			snprintf(line, sizeof line, "%s%d song%s%s", yr, al->n, al->n == 1 ? "" : "s", mins);
+		}
+		zune_text(r, zune_font(ZF_SMALL), line, cov.x, cov.y + cov.h + 76, -1, ZUNE_GRAY);
+		cf_tick(&l->cf, zl_rows(l));
+		moving = l->cf.active;
+		zune_list_ex(r, zl_style(ZL_TRACKS, pl), &(SDL_Rect){ 352, 176, TORTOS_SCREEN_W - 352 - 40,
+		             TORTOS_SCREEN_H - 176 - 24 }, zl_rows(l), l->cf.pos, l->cursor, zrow_get, &c,
+		             ZUNE_ACCENT);
+	} else {
+		const char *labels[ZP_PIVOTS];
+		float e = p->slide_t0 ? zp_ease(p->slide_t0, 260) : 1;
+		int off = (int)((1 - e) * 320) * p->slide_dir, i;
+
+		for (i = 0; i < p->n; i++) labels[i] = ZL_NAME[p->l[i].kind];
+		/* The heading moves with the pivots, a little: the Zune's parallax. */
+		zune_panorama(r, p->title, -40, (p->piv - (1 - e) * p->slide_dir) * 40.0f,
+		              (SDL_Color){ 255, 255, 255, 230 });
+		zune_pivots(r, labels, p->n, p->piv, 48 + off / 3, 150, ZUNE_ACCENT);
+		cf_tick(&l->cf, zl_rows(l));
+		moving = l->cf.active || e < 1;
+		if (zl_rows(l) == 0) {
+			zune_text(r, zune_font(ZF_SUB), "nothing here yet", 48 + off, 250, -1, ZUNE_GRAY);
+		} else {
+			zune_list_ex(r, zl_style(l->kind, false),
+			             &(SDL_Rect){ 46 + off, 232, TORTOS_SCREEN_W - 92, TORTOS_SCREEN_H - 232 - 16 },
+			             zl_rows(l), l->cf.pos, l->cursor, zrow_get, &c, ZUNE_ACCENT);
+		}
+	}
+	zune_clock(r);
+	if (battery_low()) draw_low_battery_dot(r);
+	return moving || zc_pending;
+}
+
+/* ---- the context menu ---------------------------------------------------------- */
+
+enum { ZA_PLAY, ZA_SHUFFLE, ZA_ADD, ZA_NEXT, ZA_DJ, ZA_LIKE, ZA_DISLIKE, ZA_COUNT };
+
+/* X on a row: what it can do, as a menu over the page. Returns the action
+ * chosen, or -1 for none. */
+static int zx_context(app *a, zpage *p, const char *what, bool song, int rating)
+{
+	const char *items[ZA_COUNT];
+	int acts[ZA_COUNT], n = 0, sel = 0;
+
+	items[n] = "play"; acts[n++] = ZA_PLAY;
+	if (!song) { items[n] = "shuffle"; acts[n++] = ZA_SHUFFLE; }
+	items[n] = "add to now playing"; acts[n++] = ZA_ADD;
+	items[n] = "play next"; acts[n++] = ZA_NEXT;
+	items[n] = "smart dj"; acts[n++] = ZA_DJ;
+	if (song) {
+		items[n] = rating > 0 ? "unlike" : "like"; acts[n++] = ZA_LIKE;
+		items[n] = rating < 0 ? "undislike" : "dislike"; acts[n++] = ZA_DISLIKE;
+	}
+	plat_input_flush();
+	memset(&a->in, 0, sizeof a->in);
+	while (!want_quit && a->running) {
+		muse_screen_poll();
+		plat_input_poll(&a->in);
+		if (a->in.quit_requested) { a->running = false; return -1; }
+		if (a->in.pressed[IN_BACK] || a->in.pressed[IN_X]) return -1;
+		if (in_repeat(&a->in, IN_UP))   sel = (sel + n - 1) % n;
+		if (in_repeat(&a->in, IN_DOWN)) sel = (sel + 1) % n;
+		if (a->in.pressed[IN_ACCEPT]) return acts[sel];
+		zp_draw(a, p);
+		zune_menu(a->r, what, items, n, sel, ZUNE_ACCENT);
+		plat_draw_osd(a->r);
+		plat_present();
+		SDL_Delay(12);
+	}
+	return -1;
+}
+
+/* ---- the jump list ---------------------------------------------------------------- */
+
+static void zx_jump(app *a, zpage *p)
+{
+	zlist *l = &p->l[p->piv];
+	bool avail[ZUNE_JUMP_KEYS] = { false };
+	int first[ZUNE_JUMP_KEYS], i, sel;
+
+	for (i = 0; i < ZUNE_JUMP_KEYS; i++) first[i] = -1;
+	for (i = 0; i < zl_rows(l); i++) {
+		int k = zl_letter(l, i);
+
+		if (k >= 0 && first[k] < 0) { first[k] = i; avail[k] = true; }
+	}
+	sel = zl_letter(l, l->cursor);
+	if (sel < 0) sel = 0;
+	plat_input_flush();
+	memset(&a->in, 0, sizeof a->in);
+	while (!want_quit && a->running) {
+		muse_screen_poll();
+		plat_input_poll(&a->in);
+		if (a->in.quit_requested) { a->running = false; return; }
+		if (a->in.pressed[IN_BACK] || a->in.pressed[IN_Y]) return;
+		if (in_repeat(&a->in, IN_LEFT))  sel = (sel + ZUNE_JUMP_KEYS - 1) % ZUNE_JUMP_KEYS;
+		if (in_repeat(&a->in, IN_RIGHT)) sel = (sel + 1) % ZUNE_JUMP_KEYS;
+		if (in_repeat(&a->in, IN_UP))    sel = (sel + ZUNE_JUMP_KEYS - 7) % ZUNE_JUMP_KEYS;
+		if (in_repeat(&a->in, IN_DOWN))  sel = (sel + 7) % ZUNE_JUMP_KEYS;
+		if (a->in.pressed[IN_ACCEPT] && avail[sel]) {
+			l->cursor = first[sel];
+			cf_reset(&l->cf, l->cursor);
+			return;
+		}
+		zp_draw(a, p);
+		zune_jump(a->r, avail, sel, ZUNE_ACCENT);
+		plat_draw_osd(a->r);
+		plat_present();
+		SDL_Delay(12);
+	}
+}
+
+/* ---- the screen ------------------------------------------------------------------- */
+
+#define ZP_DEPTH 5
+
+/* Rebuild every page on the stack after a rescan, keeping each where it was
+ * as best it can; a page whose subject is gone is dropped. */
+static int zp_rebuild(zpage *st, int depth)
+{
+	int i;
+
+	zx_ensure();
+	for (i = 0; i < depth; i++) {
+		zpage old = st[i];
+		int piv = old.piv, cur = old.l[piv].cursor, ok;
+
+		ok = old.type == ZP_MUSIC ||
+		     (old.type == ZP_ARTIST && old.id < g_muse.nartists) ||
+		     (old.type == ZP_GENRE && old.id < zx_ngenre) ||
+		     (old.type == ZP_ALBUM && old.id < g_muse.nalbums);
+		memset(&st[i], 0, sizeof st[i]);
+		if (!ok) { zp_free(&old); return i; }
+		zp_open(&st[i], old.type, old.id);
+		zp_free(&old);
+		if (piv < st[i].n) {
+			st[i].piv = piv;
+			if (cur < zl_rows(&st[i].l[piv])) { st[i].l[piv].cursor = cur; cf_reset(&st[i].l[piv].cf, cur); }
+		}
+	}
+	return depth;
+}
+
+/* Muse in the Zune theme. `now` opens on Now Playing, with the collection
+ * underneath it, as SELECT does while something plays; `album` (or -1) opens
+ * on that album's page, one level into the collection - quickplay's way in. */
+static void zune_music_from(app *a, bool now, int album_page)
+{
+	zpage st[ZP_DEPTH];
+	int depth = 1, i, *tmp;
+	unsigned last_draw = 0;
+	bool dirty = true;
+
+	zx_ensure();
+	if (!zx_m) return;
+	memset(st, 0, sizeof st);
+	zp_open(&st[0], ZP_MUSIC, 0);
+	if (album_page >= 0 && album_page < g_muse.nalbums) {
+		zp_open(&st[1], ZP_ALBUM, album_page);
+		depth = 2;
+	}
+	tmp = malloc(sizeof *tmp * (size_t)(g_muse.ntracks + 1));
+	if (!tmp) { zp_free(&st[0]); return; }
+	plat_input_flush();
+	memset(&a->in, 0, sizeof a->in);
+	if (now) {
+		muse_exit how = muse_now_screen(a);
+
+		if (how == MUSE_CLOSE || g_muse_gone) goto out;
+		if (how == MUSE_REBUILT) depth = zp_rebuild(st, depth);
+	}
+	while (!want_quit && a->running && depth > 0) {
+		zpage *p = &st[depth - 1];
+		zlist *l = &p->l[p->piv];
+		int rows = zl_rows(l), dir = 0, album, n;
+
+		muse_screen_poll();
+		if (cover_answers()) dirty = true;
+		plat_input_poll(&a->in);
+		if (a->in.quit_requested) { a->running = false; break; }
+		if (a->in.pressed[IN_POWER] || idle_due(a)) { muse_power(a); break; }
+		if (a->in.pressed[IN_SELECT]) break;
+		if (muse_keys(a)) {
+			muse_locked(a);
+			if (!a->running || g_muse_gone) break;
+			dirty = true;
+			continue;
+		}
+		for (i = 0; i < IN_COUNT; i++) if (a->in.pressed[i] || a->in.down[i]) dirty = true;
+
+		if (a->in.pressed[IN_BACK]) {
+			zp_free(p);
+			depth--;
+			continue;
+		}
+		if (a->in.pressed[IN_MENU]) {
+			muse_exit how = muse_menu(a);
+
+			if (how == MUSE_CLOSE) break;
+			if (how == MUSE_REBUILT) {
+				zc_flush();
+				depth = zp_rebuild(st, depth);
+				if (depth == 0) break;
+			}
+			continue;
+		}
+		/* START: what is playing, from anywhere in the collection. */
+		if (a->in.pressed[IN_START] && (musec_now()->state == MU_PLAYING ||
+		                                musec_now()->state == MU_PAUSED)) {
+			muse_exit how = muse_now_screen(a);
+
+			if (how == MUSE_CLOSE || g_muse_gone) break;
+			if (how == MUSE_REBUILT) { zc_flush(); depth = zp_rebuild(st, depth); }
+			continue;
+		}
+		/* The pivots: left and right, as the Zune swiped. */
+		{
+			bool left = in_repeat(&a->in, IN_LEFT), right = in_repeat(&a->in, IN_RIGHT);
+
+			if (p->n > 1 && (left || right)) {
+				int d = right ? 1 : -1;
+
+				p->piv = (p->piv + d + p->n) % p->n;
+				p->slide_dir = d;
+				p->slide_t0 = plat_now_ms();
+				dirty = true;
+				continue;
+			}
+		}
+		if (rows > 0) {
+			if (in_repeat(&a->in, IN_UP))   { l->cursor = (l->cursor - 1 + rows) % rows; dir = -1; }
+			if (in_repeat(&a->in, IN_DOWN)) { l->cursor = (l->cursor + 1) % rows; dir = +1; }
+			if (in_repeat(&a->in, IN_L1))   l->cursor = l->cursor > 5 ? l->cursor - 5 : 0;
+			if (in_repeat(&a->in, IN_R1))   l->cursor = l->cursor + 5 < rows ? l->cursor + 5 : rows - 1;
+			cf_set_cursor_dir(&l->cf, l->cursor, rows, dir);
+		}
+		if (a->in.pressed[IN_Y] && rows > 8 && l->kind != ZL_TRACKS) { zx_jump(a, p); continue; }
+
+		if (a->in.pressed[IN_X] && rows > 0) {
+			bool song = l->kind == ZL_SONGS || l->kind == ZL_ARTIST_SONGS ||
+			            l->kind == ZL_GENRE_SONGS || l->kind == ZL_TRACKS;
+			int row = l->cursor, t, act;
+			zune_row zr;
+			zrow_ctx c = { a, l };
+
+			if (l->shuffle_row && row == 0) song = false;
+			memset(&zr, 0, sizeof zr);
+			zrow_get(&c, row, &zr);
+			t = song ? l->ids[row - (l->shuffle_row ? 1 : 0)] : -1;
+			act = zx_context(a, p, zr.title, song, song ? zx_rate[zx_r(t)] : 0);
+			n = zx_row_tracks(l, row, tmp, g_muse.ntracks, &album);
+			switch (act) {
+			case ZA_PLAY: case ZA_SHUFFLE:
+				zx_play_tracks(tmp, n, 0, act == ZA_SHUFFLE, album);
+				if (muse_now_screen(a) == MUSE_CLOSE || g_muse_gone) goto out;
+				break;
+			case ZA_ADD:  zx_queue_tracks(tmp, n, false); break;
+			case ZA_NEXT: zx_queue_tracks(tmp, n, true); break;
+			case ZA_DJ:
+				zx_smart_dj(tmp, n);
+				if (muse_now_screen(a) == MUSE_CLOSE || g_muse_gone) goto out;
+				break;
+			case ZA_LIKE:    zx_rate_set(t, zx_rate[zx_r(t)] > 0 ? 0 : 1); break;
+			case ZA_DISLIKE: zx_rate_set(t, zx_rate[zx_r(t)] < 0 ? 0 : -1); break;
+			default: break;
+			}
+			plat_input_flush();
+			memset(&a->in, 0, sizeof a->in);
+			dirty = true;
+			continue;
+		}
+
+		if (a->in.pressed[IN_ACCEPT] && rows > 0) {
+			int row = l->cursor, id;
+
+			if (l->shuffle_row && row == 0) {
+				zx_play_tracks(l->ids, l->n, 0, true, -1);
+				if (muse_now_screen(a) == MUSE_CLOSE || g_muse_gone) break;
+				continue;
+			}
+			id = l->ids[row - (l->shuffle_row ? 1 : 0)];
+			switch (l->kind) {
+			case ZL_ARTISTS:
+			case ZL_GENRES:
+			case ZL_ALBUMS: case ZL_PLAYLISTS: case ZL_ARTIST_ALBUMS: case ZL_GENRE_ALBUMS:
+				if (depth < ZP_DEPTH) {
+					zp_open(&st[depth], l->kind == ZL_ARTISTS ? ZP_ARTIST
+					                    : l->kind == ZL_GENRES ? ZP_GENRE : ZP_ALBUM, id);
+					depth++;
+				}
+				break;
+			case ZL_BOOKS: {
+				muse_exit how = muse_book(a, id);
+
+				if (how == MUSE_CLOSE || g_muse_gone) goto out;
+				if (how == MUSE_REBUILT) { zc_flush(); depth = zp_rebuild(st, depth); }
+				break;
+			}
+			default: {
+				/* A song: this list from it, the way the Zune played on from
+				 * where you touched. An album's or a playlist's is that album;
+				 * every other list plays as itself. */
+				int start = row - (l->shuffle_row ? 1 : 0);
+
+				zx_play_tracks(l->ids, l->n, start, false,
+				               l->kind == ZL_TRACKS ? p->id : -1);
+				if (muse_now_screen(a) == MUSE_CLOSE || g_muse_gone) goto out;
+				break;
+			}
+			}
+			plat_input_flush();
+			memset(&a->in, 0, sizeof a->in);
+			dirty = true;
+			continue;
+		}
+
+		if (dirty || plat_now_ms() - last_draw > 1000) {
+			dirty = zp_draw(a, p);
+			plat_draw_osd(a->r);
+			plat_present();
+			last_draw = plat_now_ms();
+			SDL_Delay(8);
+		} else {
+			SDL_Delay(16);
+		}
+	}
+out:
+	for (i = 0; i < ZP_DEPTH; i++) zp_free(&st[i]);
+	free(tmp);
+	plat_input_flush();
+	memset(&a->in, 0, sizeof a->in);
+}
+
+/* ---- now playing, its list -------------------------------------------------------- */
+
+/* DOWN on Now Playing: the queue, in the order it plays, the one playing lit.
+ * A plays the one chosen. */
+static bool zq_get(void *ctx, int i, zune_row *out)
+{
+	static char sub[256];
+	const char *t = musec_track(i);
+	int r;
+
+	(void)ctx;
+	if (!t) return false;
+	zx_ensure();
+	if (!zx_m) { out->title = t; return true; }
+	r = zx_find(t);
+	if (r >= 0) {
+		out->title = zx_title(r);
+		snprintf(sub, sizeof sub, "%s", zx_track_artist(r));
+		out->sub = sub;
+		out->rating = zx_rate[r];
+	} else {
+		out->title = strrchr(t, '/') ? strrchr(t, '/') + 1 : t;
+	}
+	return true;
+}
+
+static void zune_queue_screen(app *a)
+{
+	coverflow cf;
+	int n = musec_now()->count, cur = musec_now()->index;
+
+	if (n <= 0) return;
+	cf_reset(&cf, cur);
+	plat_input_flush();
+	memset(&a->in, 0, sizeof a->in);
+	while (!want_quit && a->running) {
+		int dir = 0;
+
+		muse_screen_poll();
+		plat_input_poll(&a->in);
+		if (a->in.quit_requested) { a->running = false; return; }
+		if (a->in.pressed[IN_BACK] || a->in.pressed[IN_SELECT]) return;
+		if (in_repeat(&a->in, IN_UP))   { cur = (cur - 1 + n) % n; dir = -1; }
+		if (in_repeat(&a->in, IN_DOWN)) { cur = (cur + 1) % n; dir = 1; }
+		cf_set_cursor_dir(&cf, cur, n, dir);
+		if (a->in.pressed[IN_ACCEPT]) { musec_jump(cur); return; }
+		cf_tick(&cf, n);
+		zune_clear(a->r);
+		zune_panorama(a->r, "now playing", -40, 0, (SDL_Color){ 255, 255, 255, 230 });
+		zune_list_ex(a->r, &ZUNE_TEXT_ROWS, &(SDL_Rect){ 46, 170, TORTOS_SCREEN_W - 92,
+		             TORTOS_SCREEN_H - 186 }, n, cf.pos, cur, zq_get, NULL, ZUNE_ACCENT);
+		{
+			/* The one playing, marked whichever row is selected. */
+			char line[32];
+
+			snprintf(line, sizeof line, "%d of %d", musec_now()->index + 1, n);
+			zune_text(a->r, zune_font(ZF_SMALL), line, 48, 128, -1, zune_rgb(ZUNE_ACCENT, 255));
+		}
+		zune_clock(a->r);
+		plat_draw_osd(a->r);
+		plat_present();
+		SDL_Delay(12);
+	}
+}
+
+/* Rating the song playing, from Now Playing: X steps like, dislike, neither. */
+static void zx_rate_now(void)
+{
+	const char *t = musec_track(musec_now()->index);
+	int r;
+
+	zx_ensure();
+	if (!zx_rate || !t || (r = zx_find(t)) < 0) return;
+	zx_rate_set(r, zx_rate[r] > 0 ? -1 : zx_rate[r] < 0 ? 0 : 1);
+}
+
+static int zx_rating_now(void)
+{
+	const char *t = musec_track(musec_now()->index);
+	int r;
+
+	if (zx_gen != g_muse_gen || !zx_rate || !t || (r = zx_find(t)) < 0) return 0;
+	return zx_rate[r];
+}
+
+/* ---- quickplay, on the hub ---------------------------------------------------------- */
+
+/* The hub's tiles when music is focused: what was heard last, and what is new
+ * on the card - the Zune's quickplay "history" and "new". */
+#define ZQ_TILES 4
+static int zq_history[ZQ_TILES], zq_nhistory, zq_new[ZQ_TILES], zq_nnew;
+
+static void zq_build(void)
+{
+	int al, k;
+
+	zx_ensure();
+	zq_nhistory = zq_nnew = 0;
+	if (!zx_heard || !zx_added) return;
+	for (k = 0; k < ZQ_TILES; k++) {
+		int best = -1, bestn = -1;
+		long bt = 0, bn = 0;
+
+		for (al = 0; al < g_muse.nalbums; al++) {
+			int j, seen = 0;
+
+			if (!zx_is_music(al)) continue;
+			for (j = 0; j < zq_nhistory; j++) if (zq_history[j] == al) seen = 1;
+			if (!seen && zx_heard[al] > bt) { bt = zx_heard[al]; best = al; }
+			seen = 0;
+			for (j = 0; j < zq_nnew; j++) if (zq_new[j] == al) seen = 1;
+			if (!seen && zx_added[al] > bn) { bn = zx_added[al]; bestn = al; }
+		}
+		if (best >= 0) zq_history[zq_nhistory++] = best;
+		if (bestn >= 0) zq_new[zq_nnew++] = bestn;
+	}
+}
+
+static void zq_draw(app *a, int x, int y)
+{
+	TTF_Font *fs = zune_font(ZF_SMALL);
+	int tile = 128, gap = 12, k;
+
+	zc_budget = 2 * ZQ_TILES;          /* the whole panel in one frame */
+	zq_build();
+	if (zq_nhistory) {
+		zune_text(a->r, fs, "history", x, y, -1, ZUNE_GRAY);
+		for (k = 0; k < zq_nhistory; k++) {
+			int w, h;
+			SDL_Texture *t = zc_get(a, zq_history[k], &w, &h);
+			SDL_Rect q = { x + (k % 2) * (tile + gap), y + 40 + (k / 2) * (tile + gap), tile, tile };
+
+			zune_tile(a->r, t, w, h, &q, g_qp_sel == k || g_qp_sel < 0 ? 255 : 150);
+			if (g_qp_sel == k) {
+				SDL_SetRenderDrawColor(a->r, (Uint8)(ZUNE_ACCENT >> 16), (Uint8)(ZUNE_ACCENT >> 8),
+				                       (Uint8)ZUNE_ACCENT, 255);
+				for (int b = 0; b < 5; b++)
+					SDL_RenderDrawRect(a->r, &(SDL_Rect){ q.x - b, q.y - b, q.w + 2 * b, q.h + 2 * b });
+			}
+		}
+		y += 40 + 2 * (tile + gap) + 10;
+	}
+	zune_text(a->r, fs, "new", x, y, -1, ZUNE_GRAY);
+	for (k = 0; k < zq_nnew; k++) {
+		int w, h, sel = zq_nhistory + k;
+		SDL_Texture *t = zc_get(a, zq_new[k], &w, &h);
+		SDL_Rect q = { x + k * (tile / 2 + 8), y + 40, tile / 2, tile / 2 };
+
+		zune_tile(a->r, t, w, h, &q, g_qp_sel == sel || g_qp_sel < 0 ? 255 : 150);
+		if (g_qp_sel == sel) {
+			SDL_SetRenderDrawColor(a->r, (Uint8)(ZUNE_ACCENT >> 16), (Uint8)(ZUNE_ACCENT >> 8),
+			                       (Uint8)ZUNE_ACCENT, 255);
+			for (int b = 0; b < 4; b++)
+				SDL_RenderDrawRect(a->r, &(SDL_Rect){ q.x - b, q.y - b, q.w + 2 * b, q.h + 2 * b });
+		}
+	}
+}
+
+static void zune_music(app *a, bool now) { zune_music_from(a, now, -1); }
+
+static int zq_count(void) { return zq_nhistory + zq_nnew; }
+
+/* A on a quickplay tile: the album's page, inside the collection, so B
+ * comes back through music as it would have on the Zune. */
+static void zq_open(app *a, int sel)
+{
+	int al = sel < zq_nhistory ? zq_history[sel] : sel - zq_nhistory < zq_nnew
+	         ? zq_new[sel - zq_nhistory] : -1;
+
+	if (al < 0) return;
+	g_muse_over = NULL;
+	g_muse_gone = false;
+	zune_music_from(a, false, al);
+	g_menu_closing = false;
+}
+
+/* ---- the shot harness ------------------------------------------------------------------ */
+
+/* --zmusic SPEC: one frame of the collection. SPEC is a pivot name (artists,
+ * albums, songs, playlists, genres), "artist:N", "genre:N", "album:N", and
+ * "+jump" or "+menu" after any of them for the overlay. */
+static void zune_music_shot(app *a, const char *spec)
+{
+	zpage p;
+	char kind[32] = "";
+	int id = 0, i;
+	const char *over = strchr(spec, '+');
+
+	zx_ensure();
+	if (!zx_m) return;
+	memset(&p, 0, sizeof p);
+	sscanf(spec, "%31[a-z]:%d", kind, &id);
+	if (!strcmp(kind, "artist") && id < g_muse.nartists) zp_open(&p, ZP_ARTIST, id);
+	else if (!strcmp(kind, "genre") && id < zx_ngenre) zp_open(&p, ZP_GENRE, id);
+	else if (!strcmp(kind, "album") && id < g_muse.nalbums) zp_open(&p, ZP_ALBUM, id);
+	else {
+		zp_open(&p, ZP_MUSIC, 0);
+		for (i = 0; i < p.n; i++) if (!strcmp(ZL_NAME[p.l[i].kind], kind)) p.piv = i;
+	}
+	if (p.n > 0 && zl_rows(&p.l[p.piv]) > 2) {
+		p.l[p.piv].cursor = 1;
+		cf_reset(&p.l[p.piv].cf, 1);
+	}
+	/* Covers are loaded on demand, a few a frame: draw until they are in. */
+	for (i = 0; i < 40 && zp_draw(a, &p); i++) cover_answers();
+	if (over && !strcmp(over, "+jump")) {
+		bool avail[ZUNE_JUMP_KEYS] = { false };
+
+		for (i = 0; i < zl_rows(&p.l[p.piv]); i++) {
+			int k = zl_letter(&p.l[p.piv], i);
+
+			if (k >= 0) avail[k] = true;
+		}
+		zune_jump(a->r, avail, 4, ZUNE_ACCENT);
+	} else if (over && !strcmp(over, "+menu")) {
+		static const char *const items[] = { "play", "shuffle", "add to now playing",
+		                                     "play next", "smart dj" };
+
+		zune_menu(a->r, "discovery", items, 5, 0, ZUNE_ACCENT);
+	}
+	zp_free(&p);
+}
