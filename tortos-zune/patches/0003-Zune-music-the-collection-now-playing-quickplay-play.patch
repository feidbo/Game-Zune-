diff --git a/src/musec.c b/src/musec.c
index 619045b..25f681e 100644
--- a/src/musec.c
+++ b/src/musec.c
@@ -50,6 +50,21 @@ static bool    g_book;              /* the queue is a book: in order, always */
 static double  g_start_at;          /* where the first PLAY of a queue starts */
 static bool    g_ran_out;           /* see musec_take_ran_out */
 static double  g_speed = 1.0;       /* see musec_set_speed */
+/* How much of the current track has actually been heard - played forward,
+ * not sought past - for musec_on_played. */
+static char    g_heard_path[LIB_PATH * 2];
+static double  g_heard, g_heard_at;
+static bool    g_heard_book;
+static void  (*g_on_played)(const char *path);
+
+static void heard_settle(void)
+{
+	if (g_heard_path[0] && !g_heard_book && g_on_played &&
+	    (g_heard >= 30.0 || (g_now.len > 0 && g_heard >= g_now.len * 0.5)))
+		g_on_played(g_heard_path);
+	g_heard_path[0] = '\0';
+	g_heard = 0;
+}
 /* The playing file's chapters, from the daemon's CHAPTER lines. */
 #define MAX_CHAPTERS 256
 static double  g_ch_at[MAX_CHAPTERS];
@@ -178,6 +193,10 @@ static void play_current(void)
 	/* Only the queue's first PLAY starts part way: every track after it is
 	 * one the queue moved on to, from its beginning. */
 	sendf("PLAY\tpath=%s/%s\tat=%.1f\tspeed=%.2f", g_root, q, g_start_at, g_speed);
+	heard_settle();
+	snprintf(g_heard_path, sizeof g_heard_path, "%s", q);
+	g_heard_at = g_start_at;
+	g_heard_book = g_book;
 	g_nch = 0;                     /* the new file says its own */
 	/* Until META says otherwise, the name the file has. */
 	ml_track_name(strrchr(q, '/') ? strrchr(q, '/') + 1 : q,
@@ -201,6 +220,7 @@ static void advance(bool failed)
 		play_current();
 		g_advanced = true;
 	} else {
+		heard_settle();
 		g_now.state = MU_STOPPED;
 		if (!failed) g_ran_out = true;
 	}
@@ -294,6 +314,11 @@ static void event(const char *line)
 			else
 				g_seeking = false;
 		}
+		/* Heard, when it moved forward by about the time between two
+		 * reports; a jump is a seek, and a seek is not listening. */
+		if (g_now.state == MU_PLAYING && at > g_heard_at && at - g_heard_at < 3.5)
+			g_heard += at - g_heard_at;
+		g_heard_at = at;
 		g_now.at = at;
 	} else if (!strncmp(line, "END", 3)) {
 		advance(false);
@@ -559,9 +584,44 @@ void musec_seek_by(double delta)
 
 void musec_stop(void)
 {
+	heard_settle();
 	sendf("STOP");
 }
 
+void musec_on_played(void (*fn)(const char *path)) { g_on_played = fn; }
+
+void musec_jump(int i)
+{
+	if (i < 0 || i >= g_order.n) return;
+	g_order.pos = i;
+	play_current();
+}
+
+void musec_append(const char *const *paths, int n, bool next)
+{
+	char **q;
+	int i, k = 0;
+
+	if (n <= 0) return;
+	if (g_qn == 0 || g_book || (g_now.state != MU_PLAYING && g_now.state != MU_PAUSED)) {
+		musec_play(paths, n, 0, 0, false, 1.0, "", "");
+		return;
+	}
+	q = realloc(g_q, sizeof *q * (size_t)(g_qn + n));
+	if (!q) return;
+	g_q = q;
+	for (i = 0; i < n; i++) {
+		if (strpbrk(paths[i], "\t\n")) continue;
+		if ((g_q[g_qn + k] = strdup(paths[i]))) k++;
+	}
+	if (!muq_append(&g_order, k, next)) {
+		for (i = 0; i < k; i++) free(g_q[g_qn + i]);
+		return;
+	}
+	g_qn += k;
+	g_now.count = g_qn;
+}
+
 bool musec_cover_ask(const char *track, const char *base)
