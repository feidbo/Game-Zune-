+/* Called with a track's path once it has been listened to: thirty seconds of
+ * it, or half when it is shorter - the scrobbling rule. Not for a book. The
+ * play counts, history and "heavy rotation" are built from these. */
+void musec_on_played(void (*fn)(const char *path));
+
+/* Add to the queue without stopping what plays: after the current track when
+ * `next`, else at the end. With nothing loaded it starts playing them. */
+void musec_append(const char *const *paths, int n, bool next);
+
+/* Play the queue's track `i`, in play order - musec_track's numbering. */
+void musec_jump(int i);
+
 /* The queue's track `i` in PLAY order - shuffled, the i-th to be heard -
  * relative to the music root, or NULL past either end. */
 const char *musec_track(int i);
diff --git a/src/musequeue.c b/src/musequeue.c
index 49ce0b1..cf7de05 100644
--- a/src/musequeue.c
+++ b/src/musequeue.c
@@ -161,3 +161,18 @@ int muq_upcoming(const muq *q)
 	if (q->mode == MUQ_REPEAT_ALL) return q->order[0];
 	return -1;
 }
+
+bool muq_append(muq *q, int k, bool next)
+{
+	int *o, i, at;
+
+	if (k <= 0) return true;
+	o = realloc(q->order, sizeof *o * (size_t)(q->n + k));
+	if (!o) return false;
+	q->order = o;
+	at = next && q->n > 0 ? q->pos + 1 : q->n;
+	for (i = q->n - 1; i >= at; i--) q->order[i + k] = q->order[i];
+	for (i = 0; i < k; i++) q->order[at + i] = q->n + i;
+	q->n += k;
+	return true;
+}
