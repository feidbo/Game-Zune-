+
+void musec_append(const char *const *paths, int n, bool next)
+{
+	char **q;
+	int i, k = 0;
+
+	if (n <= 0) return;
+	/* Something is loaded - playing, paused, or a PLAY on its way - unless
+	 * that is a book: songs are not put on the end of a book, they start. */
+	if (g_qn == 0 || g_book || (!g_pending && !g_asked &&
+	                            g_now.state != MU_PLAYING && g_now.state != MU_PAUSED)) {
+		musec_play(paths, n, 0, 0, false, 1.0, "", "");
+		return;
+	}
+	q = realloc(g_q, sizeof *q * (size_t)(g_qn + n));
+	if (!q) return;
+	g_q = q;
+	for (i = 0; i < n; i++) {
+		if (strpbrk(paths[i], "\t\n")) continue;
+		if ((g_q[g_qn + k] = strdup(paths[i]))) k++;
+	}
+	if (!muq_append(&g_order, k, next)) {
+		for (i = 0; i < k; i++) free(g_q[g_qn + i]);
+		return;
+	}
+	g_qn += k;
+	g_now.count = g_qn;
+}
