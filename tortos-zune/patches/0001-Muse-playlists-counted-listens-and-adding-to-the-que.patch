 static const struct { const char *name, *label, *book; } ORDERS[ML_ORDERS] = {
 	[ML_BY_ARTIST] = { "artist", "Artist", "Author" },
 	[ML_BY_ALBUM]  = { "album",  "Album",  "Title"  },
+	[ML_PLAYLISTS] = { "playlists", "Playlists", "Playlists" },
 };
 
