+/* ---------- the Zune theme ----------------------------------------------- *
+ *
+ * The shelf as the original Zune's main menu: very large lowercase words over
+ * your background picture. The top has three - "zune", for the music,
+ * "game boy", for the games, and "settings", last, as on the Zune; it is
+ * TortOS's own menu, for the whole device. Under "game boy" the systems are
+ * words of the same kind, and a system's games are the twist: the systems
+ * across the top, left and right to change, the games in a list under them.
+ * Everything here gathers what to show; src/zune.c draws it, and the music
+ * is src/zune_music.h. (Its names are zt_/zx_/zm_; these are ztop_/zg_.) */
+
+enum { ZTOP_ZUNE, ZTOP_GAMES, ZTOP_SETTINGS, ZTOP_MAX };
+
+static int      g_zlevel;          /* 0 the top, 1 the game boy menu */
+static int      g_ztop = ZTOP_ZUNE;  /* the top's selection: which word, not
+                                        where - "zune" comes and goes */
+static float    g_zpos;            /* a menu's selection, eased */
+static int      g_zslide_dir;      /* the games' twist moving */
+static unsigned g_zslide_t0;
+static unsigned g_zletter_until;   /* the fast-scroll letter showing */
+static char     g_zletter;
+
+static int zg_systems(app *a, int *out)
+{
+	int i, n = 0;
+
+	for (i = 0; i < a->sys.count; i++)
+		if (!is_muse(&a->sys.systems[i])) out[n++] = i;
+	return n;
+}
+
+static int zg_index(const int *sys, int n, int s)
+{
+	int i;
+
+	for (i = 0; i < n; i++) if (sys[i] == s) return i;
+	return 0;
+}
+
+/* The top's words: what is on the card, then settings. */
+static int ztop_items(app *a, const char **names, int *what)
+{
+	int sys[CFG_MAX_SYSTEMS], n = 0;
+
+	if (g_muse.ntracks > 0) { names[n] = "zune"; what[n++] = ZTOP_ZUNE; }
+	if (zg_systems(a, sys) > 0) { names[n] = "game boy"; what[n++] = ZTOP_GAMES; }
+	names[n] = "settings"; what[n++] = ZTOP_SETTINGS;
+	return n;
+}
+
+/* Where the top's selection is now, 0 if its word has gone. */
+static int ztop_index(const int *what, int n)
+{
+	int i;
+
+	for (i = 0; i < n; i++) if (what[i] == g_ztop) return i;
+	return 0;
+}
+
+/* The theme has just changed. Each theme moves the same cursors its own
+ * way, so the one switched to starts from where they are: the stock shelf's
+ * row on the current system and its games, and the Zune's menus at the
+ * level that holds them - never on the Muse shelf, which the Zune theme
+ * opens from its own menu. */
+static void theme_switched(app *a)
+{
+	sysview *v = &a->view[a->sys_cursor];
+
+	if (zune_ui()) {
+		bool games = a->screen == SCREEN_GAMES && !is_muse(&a->sys.systems[a->sys_cursor]);
+
+		g_zlevel = games ? 1 : 0;
+		if (!games) a->screen = SCREEN_SYSTEMS;
+		g_zpos = 0;
+	}
+	cf_reset(&a->cf_sys, a->sys_cursor);
+	cf_reset(&v->cf, v->cursor);
+}
+
+static void zg_ease(float sel)
+{
+	g_zpos += (sel - g_zpos) * ZUNE_MENU_EASE;
+	if (fabsf(sel - g_zpos) < 0.01f) g_zpos = sel;
+	else redraw_now();
+}
+
+static void zune_draw_top(app *a)
+{
+	const char *names[CFG_MAX_SYSTEMS];
+	int what[ZTOP_MAX], sys[CFG_MAX_SYSTEMS], n, sel, i;
+
+	zune_backdrop(a->r, 60);
+	if (g_zlevel == 0) {
+		n = ztop_items(a, names, what);
+		sel = ztop_index(what, n);
+	} else {
+		n = zg_systems(a, sys);
+		for (i = 0; i < n; i++) names[i] = a->sys.systems[sys[i]].name;
+		sel = zg_index(sys, n, a->sys_cursor);
+	}
+	zg_ease((float)sel);
+	zune_menu_words(a->r, names, n, sel, g_zpos);
+	zm_playing_line(a);
+	zune_clock(a->r);
+}
+
+/* The game boy menu's cursor on a game system: the Muse shelf is in the list
+ * of systems too, and a stock theme may have left it there. */
+static void zg_on_a_system(app *a, const int *sys, int n)
+{
+	if (n > 0 && is_muse(&a->sys.systems[a->sys_cursor])) a->sys_cursor = sys[0];
+}
+
+/* The shelf's keys in the Zune theme, on the menus. */
+static void zune_update_top(app *a)
+{
+	const char *names[ZTOP_MAX];
+	int what[ZTOP_MAX], sys[CFG_MAX_SYSTEMS], n, cur, step;
+
+	if (g_zlevel == 0) {
+		n = ztop_items(a, names, what);
+		cur = ztop_index(what, n);
+		if (in_repeat(&a->in, IN_UP))   g_ztop = what[(cur + n - 1) % n];
+		if (in_repeat(&a->in, IN_DOWN)) g_ztop = what[(cur + 1) % n];
+		if (a->in.pressed[IN_ACCEPT]) {
+			if (what[cur] == ZTOP_ZUNE) {
+				zune_menu_screen(a);
+			} else if (what[cur] == ZTOP_SETTINGS) {
+				tortos_menu(a);
+			} else {
+				n = zg_systems(a, sys);
+				zg_on_a_system(a, sys, n);
+				g_zlevel = 1;
+				g_zpos = (float)zg_index(sys, n, a->sys_cursor);
+				cf_reset(&a->cf_sys, a->sys_cursor);
+				load_ahead(a);
+			}
+		}
+		return;
+	}
+	n = zg_systems(a, sys);
+	if (n <= 0 || a->in.pressed[IN_BACK]) {
+		g_zlevel = 0;
+		n = ztop_items(a, names, what);
+		g_zpos = (float)ztop_index(what, n);
+		return;
+	}
+	zg_on_a_system(a, sys, n);
+	cur = zg_index(sys, n, a->sys_cursor);
+	step = in_repeat(&a->in, IN_UP) ? n - 1 : in_repeat(&a->in, IN_DOWN) ? 1 : 0;
+	if (step) {
+		a->sys_cursor = sys[(cur + step) % n];
+		/* The stock shelf's row follows, so a theme switched to from
+		 * here shows the system this one is on. */
+		cf_reset(&a->cf_sys, a->sys_cursor);
+		load_ahead(a);
+	}
+	if (a->in.pressed[IN_ACCEPT]) enter_system(a);
+}
+
+/* A game's second line: on Favorites its system, else its region. */
+static void zune_game_sub(app *a, const sysview *v, int i, char *out, size_t n)
+{
+	const game_entry *g = &v->list.items[i];
+	const char *open, *close;
+	size_t k;
+
+	out[0] = '\0';
+	if (v->owner) {
+		zune_lower(a->sys.systems[shelf_owner(a, a->sys_cursor, i)].name, out, n);
+		return;
+	}
+	open = strchr(g->name, '(');
+	close = open ? strchr(open, ')') : NULL;
+	if (!open || !close || close - open < 2) return;
+	k = (size_t)(close - open - 1);
+	if (k >= n) k = n - 1;
+	memcpy(out, open + 1, k);
+	out[k] = '\0';
+	zune_lower(out, out, n);
+}
+
+static bool zune_game_row(void *ctx, int i, zune_row *out)
+{
+	static char sub[LIB_NAME];
+	app *a = ctx;
+	sysview *v = &a->view[a->sys_cursor];
+	const game_entry *g;
+	float cb;
+
+	if (i < 0 || i >= v->list.count) return false;
+	g = &v->list.items[i];
+	out->art = game_get_tex(a, i, &out->aw, &out->ah, &cb);
+	out->title = g->title;
+	zune_game_sub(a, v, i, sub, sizeof sub);
+	out->sub = sub;
+	out->marked = fav_is(a->sys.systems[shelf_owner(a, a->sys_cursor, i)].tag, g->file);
+	return true;
+}
