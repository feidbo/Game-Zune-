+
+/* Sizes are in the launcher's 1024x768, which the Pixel 2 shows at 640x480:
+ * multiply by 0.625 for what reaches the panel. ZF_SMALL is the floor - 26
+ * here is 16 there, and anything under that stops being read at arm's
+ * length. */
+static const struct { int file; int pt; } ZF_SPEC[ZF_COUNT] = {
+	[ZF_MENU]   = { 0, 100 },
+	[ZF_TWIST]  = { 1,  42 },
+	[ZF_ROW]    = { 1,  44 },
+	[ZF_SUB]    = { 2,  30 },
+	[ZF_SMALL]  = { 2,  26 },
+	[ZF_LETTER] = { 0, 260 },
+};
+static const char *const ZF_FILES[3] = {
+	"zune-light.ttf", "zune-semilight.ttf", "zune-regular.ttf",
+};
+
+/* Drawn only here. */
+static SDL_Color zune_rgb(unsigned rgb, Uint8 alpha);
+static void zune_tile(SDL_Renderer *r, SDL_Texture *art, int aw, int ah,
+                      const SDL_Rect *q, Uint8 alpha);
+static void zune_heart_tile(SDL_Renderer *r, const SDL_Rect *q, Uint8 alpha);
+static void zune_pattern(SDL_Renderer *r, const SDL_Rect *q, unsigned seed);
+static void zune_heart(SDL_Renderer *r, int cx, int cy, int size, SDL_Color col, bool broken);
+
+static TTF_Font *fonts[ZF_COUNT];
+static bool fonts_tried, wall_tried;     /* opened on first use, not at boot */
+static SDL_Renderer *zr;
+static char z_root[512], z_fallback[512];
+static SDL_Texture *wall;
+static int wall_w, wall_h;
+
+bool zune_init(SDL_Renderer *r, const char *root, const char *fallback)
+{
+	zr = r;
+	snprintf(z_root, sizeof z_root, "%s", root ? root : "");
+	snprintf(z_fallback, sizeof z_fallback, "%s", fallback ? fallback : "");
+	return true;
+}
+
+static void open_fonts(void)
+{
+	char path[600];
+	int i;
+
+	fonts_tried = true;
+	for (i = 0; i < ZF_COUNT; i++) {
+		snprintf(path, sizeof path, "%s/fonts/%s", z_root, ZF_FILES[ZF_SPEC[i].file]);
+		fonts[i] = TTF_OpenFont(path, ZF_SPEC[i].pt);
+		if (!fonts[i] && z_fallback[0])
+			fonts[i] = TTF_OpenFont(z_fallback, ZF_SPEC[i].pt);
+		if (!fonts[i])
+			fprintf(stderr, "zune: no font for role %d: %s\n", i, TTF_GetError());
+	}
+}
+
+/* The background: yours first, then the theme's own - brought down to what
+ * covers the screen, so a camera's photo is not kept at its own size. */
+static void open_wall(void)
+{
+	static const char *const WALLS[] = { "wallpaper.jpg", "wallpaper.png", "zune-wallpaper.jpg" };
+	char path[600];
+	int i;
+
+	wall_tried = true;
+	for (i = 0; !wall && zr && i < (int)(sizeof WALLS / sizeof WALLS[0]); i++) {
+		SDL_Surface *s, *fit = NULL;
+		float k;
+
+		snprintf(path, sizeof path, "%s/%s", z_root, WALLS[i]);
+		if (!(s = IMG_Load(path))) continue;
+		k = fmaxf((float)TORTOS_SCREEN_W / s->w, (float)TORTOS_SCREEN_H / s->h);
+		if (k < 1 && (fit = SDL_CreateRGBSurfaceWithFormat(0, (int)ceilf(s->w * k),
+		              (int)ceilf(s->h * k), 32, SDL_PIXELFORMAT_ARGB8888))) {
+			SDL_Surface *conv = SDL_ConvertSurfaceFormat(s, SDL_PIXELFORMAT_ARGB8888, 0);
+
+			if (!conv || SDL_BlitScaled(conv, NULL, fit, NULL) != 0) {
+				SDL_FreeSurface(fit);
+				fit = NULL;
+			}
+			SDL_FreeSurface(conv);
+		}
+		if ((wall = SDL_CreateTextureFromSurface(zr, fit ? fit : s))) {
+			wall_w = fit ? fit->w : s->w;
+			wall_h = fit ? fit->h : s->h;
+		}
+		SDL_FreeSurface(fit);
+		SDL_FreeSurface(s);
+	}
+}
+
+/* ---- text ------------------------------------------------------------------ */
+
+/* Rendered text, kept: a screen of the Zune theme is mostly words, the same
+ * ones frame after frame. Keyed by font, the width it was fitted to (0: as
+ * it is) and the string - the first 255 bytes, its length and a hash of all
+ * of it. */
+#define ZT_CACHE 96
+
+static struct zt_entry {
+	TTF_Font *font;
+	int maxw;
+	size_t len;
+	unsigned hash;
+	char str[256];
+	SDL_Texture *tex;
+	int w, h;
+	unsigned used;
+} zt[ZT_CACHE];
+static unsigned zt_clock;
+
+void zune_quit(void)
+{
+	int i;
+
+	for (i = 0; i < ZT_CACHE; i++)
+		if (zt[i].tex) SDL_DestroyTexture(zt[i].tex);
+	memset(zt, 0, sizeof zt);
+	for (i = 0; i < ZF_COUNT; i++)
+		if (fonts[i]) { TTF_CloseFont(fonts[i]); fonts[i] = NULL; }
+	if (wall) SDL_DestroyTexture(wall);
+	wall = NULL;
+	fonts_tried = wall_tried = false;
+}
+
+TTF_Font *zune_font(zune_font_role role)
+{
+	if (role < 0 || role >= ZF_COUNT) return NULL;
+	if (!fonts_tried) open_fonts();
+	return fonts[role];
+}
+
+static unsigned zt_hash(const char *s)
+{
+	unsigned h = 2166136261u;
+
+	while (*s) { h ^= (unsigned char)*s++; h *= 16777619u; }
+	return h;
+}
+
+/* `s` in `f`, cut to `maxw` with an ellipsis when it is wider (0: never). */
+static struct zt_entry *zt_get(SDL_Renderer *r, TTF_Font *f, const char *s, int maxw)
+{
+	int i, slot = 0, w = 0;
+	size_t len;
+	unsigned h;
+	char fit[256];
+	const char *draw = s;
+	SDL_Surface *surf;
+	SDL_Texture *tex;
+
+	if (!f || !s || !*s) return NULL;
+	len = strlen(s);
+	h = zt_hash(s);
+	for (i = 0; i < ZT_CACHE; i++) {
+		if (zt[i].tex && zt[i].font == f && zt[i].maxw == maxw && zt[i].len == len &&
+		    zt[i].hash == h && !strncmp(zt[i].str, s, sizeof zt[i].str - 1)) {
+			zt[i].used = ++zt_clock;
+			return &zt[i];
+		}
+		if (!zt[slot].tex) continue;              /* an empty slot is the one to use */
+		if (!zt[i].tex || zt[i].used < zt[slot].used) slot = i;
+	}
+	/* Not kept: measured and rendered once, and only then is a slot given
+	 * up for it - a string that cannot be drawn costs no good entry. */
+	if (maxw > 0 && TTF_SizeUTF8(f, s, &w, NULL) == 0 && w > maxw) {
+		ui_fit_text(f, s, fit, sizeof fit, maxw);
+		draw = fit;
+	}
+	if (!(surf = TTF_RenderUTF8_Blended(f, draw, (SDL_Color){ 255, 255, 255, 255 }))) return NULL;
+	tex = SDL_CreateTextureFromSurface(r, surf);
+	if (!tex) { SDL_FreeSurface(surf); return NULL; }
+	SDL_SetTextureBlendMode(tex, SDL_BLENDMODE_BLEND);
+	if (zt[slot].tex) SDL_DestroyTexture(zt[slot].tex);
+	zt[slot].font = f;
+	zt[slot].maxw = maxw;
+	zt[slot].len = len;
+	zt[slot].hash = h;
+	snprintf(zt[slot].str, sizeof zt[slot].str, "%s", s);
+	zt[slot].tex = tex;
+	zt[slot].w = surf->w;
+	zt[slot].h = surf->h;
+	zt[slot].used = ++zt_clock;
+	SDL_FreeSurface(surf);
+	return &zt[slot];
+}
+
+static int zt_put(SDL_Renderer *r, const struct zt_entry *e, int x, int y, int anchor, SDL_Color col)
+{
+	SDL_Rect dst;
+
+	if (!e) return 0;
+	dst.w = e->w;
+	dst.h = e->h;
+	dst.x = anchor == 0 ? x - e->w / 2 : (anchor > 0 ? x - e->w : x);
+	dst.y = y;
+	SDL_SetTextureColorMod(e->tex, col.r, col.g, col.b);
+	SDL_SetTextureAlphaMod(e->tex, col.a);
+	SDL_RenderCopy(r, e->tex, NULL, &dst);
+	return e->w;
+}
+
+int zune_text(SDL_Renderer *r, TTF_Font *f, const char *s, int x, int y,
+              int anchor, SDL_Color col)
+{
+	return zt_put(r, zt_get(r, f, s, 0), x, y, anchor, col);
+}
+
+int zune_text_fit(SDL_Renderer *r, TTF_Font *f, const char *s, int x, int y,
+                  int maxw, SDL_Color col)
+{
+	return zt_put(r, zt_get(r, f, s, maxw > 0 ? maxw : 1), x, y, -1, col);
+}
+
+/* Lowercase, as the Zune set everything: ASCII, and the accented capitals
+ * of Latin-1 (À-Þ) as UTF-8 writes them. Cut short only between characters. */
+void zune_lower(const char *in, char *out, size_t n)
+{
+	size_t i = 0, k;
+
+	if (!n) return;
+	while (in && in[i]) {
+		unsigned char c = (unsigned char)in[i];
+		size_t len = c < 0x80 ? 1 : (c >> 5) == 6 ? 2 : (c >> 4) == 14 ? 3 : (c >> 3) == 30 ? 4 : 1;
+
+		for (k = 1; k < len; k++) if (!in[i + k]) len = k;
+		if (i + len >= n) break;
+		memcpy(out + i, in + i, len);
+		if (len == 1 && c >= 'A' && c <= 'Z') out[i] = (char)(c + 32);
+		if (len == 2 && c == 0xC3) {
+			unsigned char d = (unsigned char)in[i + 1];
+
+			if (d >= 0x80 && d <= 0x9E && d != 0x97) out[i + 1] = (char)(d + 0x20);
+		}
+		i += len;
+	}
+	out[i] = '\0';
+}
+
+static SDL_Color zune_rgb(unsigned rgb, Uint8 alpha)
+{
+	return (SDL_Color){ (Uint8)(rgb >> 16), (Uint8)(rgb >> 8), (Uint8)rgb, alpha };
+}
+
+/* ---- chrome ---------------------------------------------------------------- */
+
+void zune_clear(SDL_Renderer *r)
+{
+	SDL_SetRenderDrawBlendMode(r, SDL_BLENDMODE_BLEND);
+	SDL_SetRenderDrawColor(r, 0, 0, 0, 255);
+	SDL_RenderClear(r);
+}
+
+void zune_backdrop(SDL_Renderer *r, Uint8 shade)
+{
+	if (!wall_tried) open_wall();
+	zune_clear(r);
+	if (wall && wall_w > 0 && wall_h > 0) {
+		/* Cover the screen, cropping what does not fit. */
+		float k = fmaxf((float)TORTOS_SCREEN_W / wall_w, (float)TORTOS_SCREEN_H / wall_h);
+		SDL_Rect q = { 0, 0, (int)(wall_w * k + 0.5f), (int)(wall_h * k + 0.5f) };
+
+		q.x = (TORTOS_SCREEN_W - q.w) / 2;
+		q.y = (TORTOS_SCREEN_H - q.h) / 2;
+		SDL_RenderCopy(r, wall, NULL, &q);
+	}
+	SDL_SetRenderDrawColor(r, 0, 0, 0, shade);
+	SDL_RenderFillRect(r, NULL);
+}
+
+/* The battery, read every five seconds: two sysfs files every frame would
+ * be the dearest thing on the screen, and the level moves a percent at a
+ * time. False where there is none to read. */
+static bool zune_batt(int *pct, bool *charging)
+{
+	static unsigned last;
+	static int      level;
+	static bool     on, ok, primed;
+	unsigned now = plat_now_ms();
+
+	if (!primed || now - last >= 5000) {
+		primed = true;
+		last = now;
+		on = false;
+		ok = plat_battery(&level, &on);
+	}
+	*pct = level < 0 ? 0 : level > 100 ? 100 : level;
+	*charging = on;
+	return ok;
+}
+
+/* The Zune's battery: an outline with a nub that empties toward the nub's
+ * far side, red when nearly flat, and a bolt beside it on the charger. Drawn
+ * with its right edge at `right`, centred on `cy`; returns where it starts,
+ * so the time goes to its left. */
+static int zune_battery(SDL_Renderer *r, int right, int cy)
+{
+	const int bw = 40, bh = 20, nub = 4, in = 4;
+	int pct, x, y, fill;
+	bool charging;
+	SDL_Color c = ZUNE_SOFT;
+
+	if (!zune_batt(&pct, &charging)) return right;
+	x = right - nub - bw;
+	y = cy - bh / 2;
+	SDL_SetRenderDrawBlendMode(r, SDL_BLENDMODE_BLEND);
+	SDL_SetRenderDrawColor(r, c.r, c.g, c.b, 255);
+	SDL_RenderFillRect(r, &(SDL_Rect){ x, y, bw, 2 });
+	SDL_RenderFillRect(r, &(SDL_Rect){ x, y + bh - 2, bw, 2 });
+	SDL_RenderFillRect(r, &(SDL_Rect){ x, y, 2, bh });
+	SDL_RenderFillRect(r, &(SDL_Rect){ x + bw - 2, y, 2, bh });
+	SDL_RenderFillRect(r, &(SDL_Rect){ x + bw, cy - 5, nub, 10 });
+	fill = (bw - 2 * in) * pct / 100;
+	if (pct > 0 && fill < 3) fill = 3;
+	if (pct <= ZUNE_BATT_LOW && !charging)
+		SDL_SetRenderDrawColor(r, 224, 72, 72, 255);
+	if (fill > 0) SDL_RenderFillRect(r, &(SDL_Rect){ x + in, y + in, fill, bh - 2 * in });
+	if (charging) {
+		/* Two triangles: the top stroke and the bottom one. */
+		float bx = (float)(x - 18), by = (float)(cy - 10);
+		SDL_Vertex v[6];
+		const float pts[6][2] = { { 8, 0 }, { 1, 12 }, { 6, 12 }, { 6, 8 }, { 11, 8 }, { 4, 20 } };
+		int i;
+
+		for (i = 0; i < 6; i++)
+			v[i] = (SDL_Vertex){ { bx + pts[i][0], by + pts[i][1] }, c, { 0, 0 } };
+		SDL_RenderGeometry(r, NULL, v, 6, NULL, 0);
+		x -= 18;
+	}
+	return x;
+}
+
+void zune_clock(SDL_Renderer *r)
+{
+	TTF_Font *f = zune_font(ZF_SMALL);
+	char buf[16];
+	time_t now = time(NULL);
+	struct tm tm;
+	int h, right = zune_battery(r, TORTOS_SCREEN_W - 24, 8 + (f ? TTF_FontHeight(f) / 2 : 15));
+
+	if (!localtime_r(&now, &tm)) return;
+	h = tm.tm_hour % 12;
+	snprintf(buf, sizeof buf, "%d:%02d", h ? h : 12, tm.tm_min);
+	zune_text(r, f, buf, right == TORTOS_SCREEN_W - 24 ? right : right - 14, 8, 1, ZUNE_SOFT);
+}
+
+void zune_menu_words(SDL_Renderer *r, const char *const *items, int n, int sel, float pos)
+{
+	TTF_Font *f = zune_font(ZF_MENU);
+	int line = f ? TTF_FontLineSkip(f) : 124, top = 70, fit = (TORTOS_SCREEN_H - top - 40) / line;
+	float first = 0;
+	char low[160];
+	int i;
+
+	if (n <= 0) return;
+	/* Long menus scroll so the selection keeps one item above it - the
+	 * Zune's words were too big for the whole menu to fit, and it moved. */
+	if (n > fit) first = fminf(fmaxf(pos - 1, 0), (float)(n - fit));
+	for (i = 0; i < n; i++) {
+		float y = top + (i - first) * line;
+		float near = 1.0f - fminf(1.0f, fabsf(pos - i));
+		Uint8 al = (Uint8)(105 + (255 - 105) * (i == sel ? fmaxf(near, 0.5f) : near));
+
+		if (y < -line || y > TORTOS_SCREEN_H) continue;
+		zune_lower(items[i], low, sizeof low);
+		zune_text(r, f, low, 50, (int)y, -1, (SDL_Color){ 255, 255, 255, al });
+	}
+}
+
+const char *zune_names_at(void *names, int i)
+{
+	return ((const char *const *)names)[i];
+}
+
+void zune_twist_text(SDL_Renderer *r, int n, int sel, float slide, zune_name_fn get, void *ctx)
+{
+	TTF_Font *f = zune_font(ZF_TWIST);
+	int x = 48 + (int)(slide * 140), y = 22, k;
+	char low[160];
+
+	if (n <= 0) return;
+	SDL_RenderSetClipRect(r, &(SDL_Rect){ 0, 0, TORTOS_SCREEN_W - 96, 120 });
+	if (n > 1) {
+		/* The one before, faint, against the left edge: there is more that
+		 * way too. */
+		zune_lower(get(ctx, (sel + n - 1) % n), low, sizeof low);
+		zune_text(r, f, low, x - 26, y, 1, (SDL_Color){ 255, 255, 255, 60 });
+	}
+	for (k = 0; k < n && x < TORTOS_SCREEN_W; k++) {
+		Uint8 al = k == 0 ? 255 : (Uint8)(k == 1 ? 130 : 95);
+
+		zune_lower(get(ctx, (sel + k) % n), low, sizeof low);
+		x += zune_text(r, f, low, x, y, -1, (SDL_Color){ 255, 255, 255, al }) + 30;
+		if (k + 1 >= n) break;
+	}
+	SDL_RenderSetClipRect(r, NULL);
+}
+
+static void cover_tile(SDL_Renderer *r, const zune_cover *c, const SDL_Rect *q, Uint8 alpha)
+{
+	if (c->heart) zune_heart_tile(r, q, alpha);
+	else zune_tile(r, c->art, c->w, c->h, q, alpha);
+}
+
+void zune_twist_covers(SDL_Renderer *r, int n, int sel, const char *name, float slide,
+                       zune_cover_fn get, void *ctx)
+{
+	zune_cover c;
+	TTF_Font *f = zune_font(ZF_TWIST);
+	int big = 92, small = 62, y = 16, x = 48 + (int)(slide * 140), k;
+	char low[160];
+
+	if (n <= 0) return;
+	SDL_RenderSetClipRect(r, &(SDL_Rect){ 0, 0, TORTOS_SCREEN_W - 96, 124 });
+	if (n > 1) {
+		get(ctx, (sel + n - 1) % n, &c);
+		cover_tile(r, &c, &(SDL_Rect){ x - small - 14, y + (big - small) / 2, small, small }, 70);
+	}
+	get(ctx, sel, &c);
+	cover_tile(r, &c, &(SDL_Rect){ x, y, big, big }, 255);
+	x += big + 18;
+	if (name && name[0]) {
+		zune_lower(name, low, sizeof low);
+		x += zune_text_fit(r, f, low, x, y + (big - (f ? TTF_FontHeight(f) : 50)) / 2, 380, ZUNE_WHITE) + 24;
+	}
+	for (k = 1; k < n && x < TORTOS_SCREEN_W; k++) {
+		get(ctx, (sel + k) % n, &c);
+		cover_tile(r, &c, &(SDL_Rect){ x, y + (big - small) / 2, small, small },
+		           k == 1 ? 150 : 100);
+		x += small + 12;
+	}
+	SDL_RenderSetClipRect(r, NULL);
+}
+
+void zune_letter(SDL_Renderer *r, char c, Uint8 alpha)
+{
+	TTF_Font *f = zune_font(ZF_LETTER);
+	char s[2] = { c, 0 };
+
+	if (!c) return;
+	zune_text(r, f, s, 40, (TORTOS_SCREEN_H - (f ? TTF_FontHeight(f) : 300)) / 2, -1,
+	          (SDL_Color){ 255, 255, 255, alpha });
+}
+
+static void zune_tile(SDL_Renderer *r, SDL_Texture *art, int aw, int ah,
+                      const SDL_Rect *q, Uint8 alpha)
+{
+	SDL_Rect in;
+	float k;
+
+	SDL_SetRenderDrawBlendMode(r, SDL_BLENDMODE_BLEND);
+	SDL_SetRenderDrawColor(r, 40, 40, 44, alpha);
+	SDL_RenderFillRect(r, q);
+	if (!art || aw <= 0 || ah <= 0) return;
+	k = fminf((float)q->w / aw, (float)q->h / ah);
+	in.w = (int)(aw * k + 0.5f);
+	in.h = (int)(ah * k + 0.5f);
+	in.x = q->x + (q->w - in.w) / 2;
+	in.y = q->y + (q->h - in.h) / 2;
+	SDL_SetTextureAlphaMod(art, alpha);
+	SDL_RenderCopy(r, art, NULL, &in);
+	SDL_SetTextureAlphaMod(art, 255);
+}
+
+static void zune_heart_tile(SDL_Renderer *r, const SDL_Rect *q, Uint8 alpha)
+{
+	SDL_SetRenderDrawBlendMode(r, SDL_BLENDMODE_BLEND);
+	SDL_SetRenderDrawColor(r, (Uint8)(ZUNE_ACCENT >> 16), (Uint8)(ZUNE_ACCENT >> 8),
+	                       (Uint8)ZUNE_ACCENT, alpha);
+	SDL_RenderFillRect(r, q);
+	zune_heart(r, q->x + q->w / 2, q->y + q->h / 2, q->w / 2, (SDL_Color){ 255, 255, 255, alpha }, false);
+}
+
+static void zune_pattern(SDL_Renderer *r, const SDL_Rect *q, unsigned seed)
+{
+	/* The Zune's own colors: orange, magenta, the blues and greens of its
+	 * shells and its software. */
+	static const unsigned PAL[] = { 0xF26522, 0xEC008C, 0x00A99D, 0x8DC63F, 0x00AEEF,
+	                                0x92278F, 0xFFC20E, 0x2E3192 };
+	int n = 4, i, j;
+	unsigned s = seed ? seed : 1;
+
+	for (j = 0; j < n; j++)
+		for (i = 0; i < n; i++) {
+			unsigned c;
+			SDL_Rect b = { q->x + i * q->w / n, q->y + j * q->h / n,
+			               (i + 1) * q->w / n - i * q->w / n, (j + 1) * q->h / n - j * q->h / n };
+
+			s ^= s << 13; s ^= s >> 17; s ^= s << 5;
+			c = PAL[s % (sizeof PAL / sizeof PAL[0])];
+			SDL_SetRenderDrawColor(r, (Uint8)(c >> 16), (Uint8)(c >> 8), (Uint8)c,
+			                       (Uint8)(150 + (s >> 8) % 106));
+			SDL_RenderFillRect(r, &b);
+		}
+}
+
+static void zune_heart(SDL_Renderer *r, int cx, int cy, int size, SDL_Color col, bool broken)
+{
+	SDL_Vertex v[66];
+	int i, n = 64, k = 0, idx[64 * 3], m = 0;
+	float sc = size / 34.0f;
+
+	v[k++] = (SDL_Vertex){ { (float)cx, (float)cy }, col, { 0, 0 } };
+	for (i = 0; i <= n; i++) {
+		float t = (float)i / n * 6.2831853f;
+		float x = 16 * powf(sinf(t), 3);
+		float y = 13 * cosf(t) - 5 * cosf(2 * t) - 2 * cosf(3 * t) - cosf(4 * t);
+
+		v[k++] = (SDL_Vertex){ { cx + x * sc, cy - y * sc - 1 }, col, { 0, 0 } };
+	}
+	for (i = 1; i < k - 1; i++) { idx[m++] = 0; idx[m++] = i; idx[m++] = i + 1; }
+	SDL_RenderGeometry(r, NULL, v, k, idx, m);
+	if (broken) {
+		SDL_SetRenderDrawColor(r, 0, 0, 0, 255);
+		for (i = -1; i <= 1; i++) {
+			SDL_RenderDrawLine(r, cx + i, cy - size / 2, cx - size / 6 + i, cy - size / 8);
+			SDL_RenderDrawLine(r, cx - size / 6 + i, cy - size / 8, cx + size / 8 + i, cy + size / 8);
+			SDL_RenderDrawLine(r, cx + size / 8 + i, cy + size / 8, cx + i, cy + size / 2);
+		}
+	}
+}
+
+/* ---- lists ----------------------------------------------------------------- */
+
+const zune_list_style ZUNE_ART_ROWS   = { 112,  92, ZF_ROW, ZF_SUB,   0 };
+const zune_list_style ZUNE_TEXT_ROWS  = {  92,   0, ZF_ROW, ZF_SMALL, 0 };
+const zune_list_style ZUNE_TRACK_ROWS = {  70,   0, ZF_ROW, ZF_SMALL, 64 };
+const zune_list_style ZUNE_LIST_ROWS  = {  92,   0, ZF_ROW, ZF_SMALL, 64 };
+
+static void list_row(SDL_Renderer *r, const zune_list_style *st, const zune_row *row,
+                     int x, int y, int w, bool sel)
+{
+	TTF_Font *ft = zune_font(st->title), *fs = zune_font(st->sub);
+	int th = ft ? TTF_FontHeight(ft) : 52, sh = fs ? TTF_FontHeight(fs) : 32;
+	bool two = row->sub && row->sub[0];
+	int tx = x + 16, tw = w - 32, ty, rw = 0;
+	SDL_Color tc = sel ? ZUNE_WHITE : ZUNE_SOFT;
+	SDL_Color sc = sel ? ZUNE_SOFT : ZUNE_GRAY;
+
+	if (sel) {
+		/* The selection: a band of light across the row. */
+		SDL_SetRenderDrawBlendMode(r, SDL_BLENDMODE_BLEND);
+		SDL_SetRenderDrawColor(r, 255, 255, 255, 46);
+		SDL_RenderFillRect(r, &(SDL_Rect){ x, y + 3, w, st->row_h - 6 });
+	}
+	if (st->art) {
+		SDL_Rect art = { tx, y + (st->row_h - st->art) / 2, st->art, st->art };
+
+		if (row->heart) zune_heart_tile(r, &art, 255);
+		else if (!row->lead) zune_tile(r, row->art, row->aw, row->ah, &art, 255);
+		tx += st->art + 22;
+		tw -= st->art + 22;
+	}
+	if (st->num_w) {
+		if (row->num && row->num[0])
+			zune_text(r, fs, row->num, tx, y + (st->row_h - sh) / 2, -1, sc);
+		tx += st->num_w;
+		tw -= st->num_w;
+	}
+	if (row->right && row->right[0]) {
+		rw = zune_text(r, fs, row->right, x + w - 16, y + (st->row_h - sh) / 2, 1, sc) + 24;
+		tw -= rw;
+	}
+	if (row->rating) {
+		int hs = sh * 2 / 3;
+
+		zune_heart(r, x + w - 16 - rw - hs / 2 - 4, y + st->row_h / 2, hs,
+		           row->rating > 0 ? zune_rgb(ZUNE_ACCENT, 255) : ZUNE_GRAY, row->rating < 0);
+		tw -= hs + 20;
+	}
+	ty = two || row->marked ? y + (st->row_h - th - sh) / 2 : y + (st->row_h - th) / 2;
+	zune_text_fit(r, ft, row->title, tx, ty, tw, tc);
+	if (!two && !row->marked) return;
+	ty += th - 2;
+	if (row->marked) {
+		int sz = fs ? TTF_FontAscent(fs) / 2 : 10;
+
+		SDL_SetRenderDrawColor(r, (Uint8)(ZUNE_ACCENT >> 16), (Uint8)(ZUNE_ACCENT >> 8),
+		                       (Uint8)ZUNE_ACCENT, 255);
+		SDL_RenderFillRect(r, &(SDL_Rect){ tx, ty + (fs ? TTF_FontAscent(fs) : 20) - sz - 3, sz, sz });
+		if (two) zune_text_fit(r, fs, row->sub, tx + sz + 12, ty, tw - sz - 12, sc);
+	} else {
+		zune_text_fit(r, fs, row->sub, tx, ty, tw, sc);
+	}
+}
+
+void zune_list(SDL_Renderer *r, const zune_list_style *st, const SDL_Rect *area,
+               int count, float pos, int cursor, zune_row_fn get, void *ctx)
+{
+	int rh = st->row_h, fit = area->h / rh, i, first;
+	float top = 0;
+	zune_row row;
+
+	if (count <= 0) return;
+	/* A list runs top to bottom and stays in order - "shuffle all" is always
+	 * its first row. A long one scrolls to keep a row above the selection;
+	 * `pos` (which wraps with the cursor) is taken back into the list. */
+	if (count > fit) {
+		float p = fmodf(pos, (float)count);
+
+		if (p < 0) p += count;
+		top = fminf(fmaxf(p - 1, 0), (float)(count - fit));
+	}
+	first = (int)floorf(top);
+	SDL_RenderSetClipRect(r, area);
+	for (i = first; i < count && i <= first + fit + 1; i++) {
+		int y = area->y + (int)lroundf((i - top) * rh);
+
+		memset(&row, 0, sizeof row);
+		if (get(ctx, i, &row))
+			list_row(r, st, &row, area->x, y, area->w, i == cursor);
+	}
+	SDL_RenderSetClipRect(r, NULL);
+}
+
+void zune_options(SDL_Renderer *r, const char *title, const char *const *items, int n, int sel)
+{
+	TTF_Font *ft = zune_font(ZF_ROW), *fs = zune_font(ZF_SUB);
+	int line = ft ? TTF_FontLineSkip(ft) + 22 : 76, y, i;
+	char low[256];
+
+	SDL_SetRenderDrawBlendMode(r, SDL_BLENDMODE_BLEND);
+	SDL_SetRenderDrawColor(r, 0, 0, 0, 215);
+	SDL_RenderFillRect(r, NULL);
+	y = (TORTOS_SCREEN_H - n * line) / 2;
+	if (title && title[0]) {
+		zune_lower(title, low, sizeof low);
+		zune_text_fit(r, fs, low, 64, y - 64, TORTOS_SCREEN_W - 128, ZUNE_GRAY);
+	}
+	for (i = 0; i < n; i++, y += line) {
+		if (i == sel) {
+			SDL_SetRenderDrawColor(r, 255, 255, 255, 46);
+			SDL_RenderFillRect(r, &(SDL_Rect){ 48, y - 8, TORTOS_SCREEN_W - 96, line - 6 });
+		}
+		zune_lower(items[i], low, sizeof low);
+		zune_text(r, ft, low, 64, y, -1, i == sel ? ZUNE_WHITE : ZUNE_SOFT);
+	}
+}
+
+/* ---- now playing ----------------------------------------------------------- */
+
+static void mmss(char *out, size_t n, double s)
+{
+	long t = s > 0 ? (long)(s + 0.5) : 0;
+
+	if (t >= 3600) snprintf(out, n, "%ld:%02ld:%02ld", t / 3600, t / 60 % 60, t % 60);
+	else snprintf(out, n, "%ld:%02ld", t / 60, t % 60);
+}
+
+unsigned zune_now_playing(SDL_Renderer *r, const zune_np *np)
+{
+	TTF_Font *ft = zune_font(ZF_ROW), *fs = zune_font(ZF_SUB), *fm = zune_font(ZF_SMALL);
+	/* The art over two thirds of the screen, as on the Zune; the words in
+	 * the third under it. */
+	SDL_Rect art = { (TORTOS_SCREEN_W - 500) / 2, 18, 500, 500 };
+	int y = art.y + art.h + 22, x = 48, w = TORTOS_SCREEN_W - 96;
+	char low[256], t0[24], t1[32];
+	double k = np->len > 0 ? np->at / np->len : 0;
+	int bar = TORTOS_SCREEN_H - 34, fill, gx;
+
+	zune_clear(r);
+	if (np->cover) {
+		int aw, ah;
+
+		SDL_QueryTexture(np->cover, NULL, NULL, &aw, &ah);
+		zune_tile(r, np->cover, aw, ah, &art, 255);
+	} else {
+		zune_pattern(r, &art, np->seed);
+	}
+
+	zune_lower(np->title, low, sizeof low);
+	zune_text_fit(r, ft, low, x, y, w - 200, ZUNE_WHITE);
+	/* The status icons, at the right of the title: shuffle and repeat as the
+	 * Zune marked them, and the rating. */
+	gx = x + w;
+	if (np->rating) {
+		zune_heart(r, gx - 16, y + 26, 30, np->rating > 0 ? zune_rgb(ZUNE_ACCENT, 255) : ZUNE_GRAY,
+		           np->rating < 0);
+		gx -= 50;
+	}
+	if (np->repeat) {
+		ui_glyph_draw(r, np->repeat == 2 ? UI_GLYPH_REPEAT_ONE : UI_GLYPH_REPEAT, gx - 16, y + 26, 34, ZUNE_SOFT);
+		gx -= 50;
+	}
+	if (np->shuffle) ui_glyph_draw(r, UI_GLYPH_SHUFFLE, gx - 16, y + 26, 34, ZUNE_SOFT);
+	y += ft ? TTF_FontLineSkip(ft) : 56;
+	zune_lower(np->artist, low, sizeof low);
+	zune_text_fit(r, fs, low, x, y, w, ZUNE_SOFT);
+	y += fs ? TTF_FontLineSkip(fs) : 38;
+	zune_lower(np->album, low, sizeof low);
+	zune_text_fit(r, fs, low, x, y, w, ZUNE_GRAY);
+
+	/* Where in the song: a thin line along the foot, times at its ends. */
+	mmss(t0, sizeof t0, np->at);
+	zune_text(r, fm, t0, x, bar - 34, -1, ZUNE_SOFT);
+	if (np->len > 0) {
+		char rem[24];
+
+		mmss(rem, sizeof rem, np->len > np->at ? np->len - np->at : 0);
+		snprintf(t1, sizeof t1, "-%s", rem);
+		zune_text(r, fm, t1, x + w, bar - 34, 1, ZUNE_SOFT);
+	}
+	if (np->note) {
+		zune_lower(np->note, low, sizeof low);
+		zune_text(r, fm, low, TORTOS_SCREEN_W / 2, bar - 34, 0, zune_rgb(ZUNE_ACCENT, 255));
+	} else if (np->state || (np->where && np->where[0])) {
+		char mid[96];
+
+		snprintf(mid, sizeof mid, "%s%s%s", np->state ? np->state : "",
+		         np->state && np->where && np->where[0] ? "  -  " : "", np->where ? np->where : "");
+		zune_lower(mid, low, sizeof low);
+		zune_text(r, fm, low, TORTOS_SCREEN_W / 2, bar - 34, 0, ZUNE_GRAY);
+	}
+	SDL_SetRenderDrawColor(r, 255, 255, 255, 60);
+	SDL_RenderFillRect(r, &(SDL_Rect){ x, bar, w, 5 });
+	fill = (int)(w * (k < 0 ? 0 : k > 1 ? 1 : k) + 0.5);
+	if (fill > 0) {
+		SDL_SetRenderDrawColor(r, 255, 255, 255, 230);
+		SDL_RenderFillRect(r, &(SDL_Rect){ x, bar, fill, 5 });
+	}
+	zune_clock(r);
+	return np->state ? 1000 : 500;
+}
