+{
+	static char path[CFG_STR * 2];
+
+	if (!zune_ui()) return P_FONT;
+	snprintf(path, sizeof path, "%s/fonts/zune-regular.ttf", P_ROOT);
+	return access(path, R_OK) == 0 ? path : P_FONT;
+}
