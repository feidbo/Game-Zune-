+#ifndef TORTOS_ZUNE_H
+#define TORTOS_ZUNE_H
+
+#include <SDL.h>
+#include <SDL_ttf.h>
+#include <stdbool.h>
+
+/* The Zune theme: the original Zune's look - the Zune 30, 80 and 120, the
+ * players with buttons, not the touchscreen Zune HD - drawn by TortOS.
+ *
+ * What that looked like, as the reviews of the time describe it:
+ *
+ *   - The main menu is a column of very large lowercase words over a
+ *     background picture of your choosing.
+ *   - The "twist": choose something and its sub-menus run across the top of
+ *     the screen, with the list beneath. Left and right move along the top
+ *     row, up and down through the list. Inside an album the other albums
+ *     are that row, as tiny covers.
+ *   - Every list starts with "shuffle all" (or "play all" under an artist or
+ *     an album).
+ *   - Scrolling fast shows the letter you are at, large, on the left.
+ *   - Now Playing is the album art over two thirds of the screen and the
+ *     song, artist and album under it - a colorful pattern where there is
+ *     no art. The center button there brings up rating, the song list,
+ *     shuffle and repeat.
+ *
+ * This file is the drawing only; src/zune_music.h and main.c gather what a
+ * screen shows. Sizes are in the launcher's 1024x768. */
+
+#define ZUNE_ACCENT 0xEC008Cu      /* Zune magenta: hearts and the progress */
+#define ZUNE_MENU_EASE 0.35f       /* how far a menu's selection eases a frame */
+#define ZUNE_SCAN_MS   500         /* the pad held this long scans, not skips */
+#define ZUNE_HOLD_MS   1000        /* START held this long locks the screen */
+
+typedef enum {
+	ZF_MENU,    /* the main menu's words                      */
+	ZF_TWIST,   /* the row across the top                     */
+	ZF_ROW,     /* a list row's title                         */
+	ZF_SUB,     /* a row's second line; Now Playing's artist  */
+	ZF_SMALL,   /* counts, times, the clock                   */
+	ZF_LETTER,  /* the letter shown while scrolling fast      */
+	ZF_COUNT
+} zune_font_role;
+
+/* Where the fonts and the background are: <root>/fonts/ (zune-light.ttf,
+ * zune-semilight.ttf, zune-regular.ttf), falling back to `fallback`; and
+ * <root>/wallpaper.jpg or .png if you put one there, else the theme's own
+ * <root>/zune-wallpaper.jpg. Nothing is opened until the theme first draws,
+ * so the other themes pay nothing for it. Again after zune_quit, with the
+ * new renderer. */
+bool zune_init(SDL_Renderer *r, const char *root, const char *fallback);
+void zune_quit(void);
+TTF_Font *zune_font(zune_font_role role);
+
+/* Text, from a cache sized for screens that are mostly words. Rendered white
+ * once and tinted as drawn. anchor: -1 left, 0 center, 1 right. */
+int zune_text(SDL_Renderer *r, TTF_Font *f, const char *s, int x, int y,
+              int anchor, SDL_Color col);
+int zune_text_fit(SDL_Renderer *r, TTF_Font *f, const char *s, int x, int y,
+                  int maxw, SDL_Color col);
+void zune_lower(const char *in, char *out, size_t n);
+
+#define ZUNE_WHITE ((SDL_Color){ 255, 255, 255, 255 })
+#define ZUNE_SOFT  ((SDL_Color){ 205, 205, 205, 255 })
+#define ZUNE_GRAY  ((SDL_Color){ 150, 150, 150, 255 })
+
+/* The background picture, cover-fitted, darkened by `shade` (0-255) so
+ * words read over it. Black where there is none. */
+void zune_backdrop(SDL_Renderer *r, Uint8 shade);
+void zune_clear(SDL_Renderer *r);
+
+/* At or below this the battery is drawn red: the stock launcher's warning,
+ * BATT_LOW_PCT in src/main.c. */
+#define ZUNE_BATT_LOW 10
+
+/* The time and the battery, top right, on every Zune screen. */
+void zune_clock(SDL_Renderer *r);
+
+/* The main menu: `items` (drawn lowercase) down the left in the largest type,
+ * the selected one white and the rest faded. `pos` is the selection's
+ * continuous position, so the column glides when the menu is longer than the
+ * screen. */
+void zune_menu_words(SDL_Renderer *r, const char *const *items, int n, int sel, float pos);
+
+/* The twist's row across the top: the current item first and bright, the
+ * ones after it fading off to the right, the one before it faint at the left
+ * edge. `slide` (-1..1) eases the row when it has just moved. Item i is
+ * get(ctx, i), asked only for the few that fit; zune_names_at reads a plain
+ * array of strings. Leaves the clip rect unset. */
+typedef const char *(*zune_name_fn)(void *ctx, int i);
+const char *zune_names_at(void *names, int i);
+void zune_twist_text(SDL_Renderer *r, int n, int sel, float slide, zune_name_fn get, void *ctx);
+
+/* The same row for albums: tiny covers, the current one larger with its
+ * name beside it. */
+typedef struct { SDL_Texture *art; int w, h; bool heart; } zune_cover;
+typedef void (*zune_cover_fn)(void *ctx, int i, zune_cover *out);
+void zune_twist_covers(SDL_Renderer *r, int n, int sel, const char *name, float slide,
+                       zune_cover_fn get, void *ctx);
+
+/* The letter scrolling has reached, large and translucent on the left. */
+void zune_letter(SDL_Renderer *r, char c, Uint8 alpha);
+
+/* Art is drawn contain-fitted on a dark square; "liked songs" has a white
+ * heart on Zune magenta for its cover; and missing art is the first Zune's
+ * colorful pattern, from a seed (the album's name) so an album always gets
+ * the same one. Hearts mark ratings; a broken one is "dislike". */
+
+/* ---- lists ----------------------------------------------------------------- */
+
+typedef struct {
+	SDL_Texture *art;   /* NULL draws an empty tile until it arrives */
+	int aw, ah;
+	const char *title;
+	const char *sub;    /* may be NULL or empty */
+	bool marked;        /* a favorite: a small mark before the sub */
+	const char *num;    /* a track number, in its own column */
+	const char *right;  /* right-aligned and quiet: a duration */
+	int rating;         /* 1 a heart, -1 a broken one, 0 nothing */
+	bool lead;          /* "shuffle all" / "play all": no art, no number */
+	bool heart;         /* the heart tile in place of art: liked songs */
+} zune_row;
+
+typedef bool (*zune_row_fn)(void *ctx, int i, zune_row *out);
+
+/* Row height, art side (0 for none), and a track-number column (0 none). */
+typedef struct { int row_h, art; zune_font_role title, sub; int num_w; } zune_list_style;
+extern const zune_list_style ZUNE_ART_ROWS;    /* albums, games: art and two lines */
+extern const zune_list_style ZUNE_TEXT_ROWS;   /* artists, songs, genres */
+extern const zune_list_style ZUNE_TRACK_ROWS;  /* an album's tracks */
+extern const zune_list_style ZUNE_LIST_ROWS;   /* a playlist's: two lines, numbered */
+
+/* A list of `count` rows in `area`, scrolled so `pos` is in view, `cursor`
+ * selected: a band of light behind it and its words white, the rest grey. */
+void zune_list(SDL_Renderer *r, const zune_list_style *st, const SDL_Rect *area,
+               int count, float pos, int cursor, zune_row_fn get, void *ctx);
+
+/* A menu over the dimmed screen - the center button held, or pressed on Now
+ * Playing: what it is about, quietly, then the choices. */
+void zune_options(SDL_Renderer *r, const char *title, const char *const *items, int n, int sel);
+
+/* ---- now playing ------------------------------------------------------------- */
+
+typedef struct {
+	const char *artist, *album, *title;
+	const char *where;      /* "2 of 12" */
+	const char *state;      /* NULL while playing, else "paused" and so on */
+	double at, len;         /* seconds */
+	SDL_Texture *cover;
+	unsigned seed;          /* the pattern, when there is no cover */
+	int rating;             /* 1 liked, -1 disliked */
+	bool shuffle;
+	int repeat;             /* 0 off, 1 all, 2 one */
+	const char *note;       /* for a moment, in place of `state` and `where`:
+	                           "added to liked songs" */
+} zune_np;
+
+/* Returns how long until the picture would change by itself, in ms. */
+unsigned zune_now_playing(SDL_Renderer *r, const zune_np *np);
+
+#endif
diff --git a/src/zune_music.h b/src/zune_music.h
new file mode 100644
index 0000000..e7a1aea
--- /dev/null
+++ b/src/zune_music.h
@@ -0,0 +1,1900 @@
+/* SPDX-License-Identifier: MIT */
+/* The Zune theme's music: the original Zune's, on Muse.
+ *
+ * CODE, NOT A HEADER: included once into main.c, not compiled alone, and
+ * named .h only so the builds' wildcard of .c files does not pick it up,
+ * while their wildcard of .h files still sees it change. It is Muse's screens, and it
+ * needs Muse's state (the library, covers, the queue, the lock) the way the
+ * rest of Muse's screens in main.c do. Drawing is src/zune.c's.
+ *
+ *   zune       now playing / artists / albums / songs / playlists / genres /
+ *              audiobooks - each opens the twist at itself
+ *   twist      artists  albums  songs  playlists  genres
+ *     artist     the other artists across the top; their albums below
+ *     album      the other albums across the top, as tiny covers; its songs
+ *   now playing: the center button for rate, song list, shuffle, repeat
+ *
+ * Left and right twist along the row across the top, up and down go through
+ * the list under it, A goes in and B comes back. X is what holding the center
+ * button did: play, shuffle, add to now playing, rate.
+ *
+ * What the folders cannot say - a song's own title, its genre, its year and
+ * length - comes from Music/.zune/library.tsv, which scripts/zunesync.py
+ * writes from the tags and the public databases. Without it everything still
+ * works from the folder names, and genres is simply not offered.
+ * Plays and ratings are kept beside it, in plays.log and ratings.tsv.
+ *
+ * Liked songs: a song rated "like" goes on Playlists/liked songs.m3u8, in the
+ * order liked, kept by this file - the card's own playlist, so the computer
+ * and other players see it too. ratings.tsv says what is liked; the playlist
+ * is the order. A song put on the playlist by hand counts as liked, and one
+ * disliked comes off it. The menu shows the list from memory, so a like is
+ * there at once, without the rescan a new playlist file would need. */
+
+#define ZX_DIR "Music/.zune"
+
+/* ---- what is known about each track --------------------------------------- */
+
+typedef struct {
+	const char *title, *artist, *genre;   /* into zx_blob; NULL when unknown */
+	int year, secs, num;
+} zx_meta;
+
+static unsigned    zx_gen = (unsigned)-1;    /* g_muse_gen this was built for */
+static zx_meta    *zx_m;                     /* per real track */
+static char       *zx_blob;                  /* library.tsv, owning the strings */
+static int        *zx_real;                  /* track -> the real track it is */
+static int        *zx_alb;                   /* real track -> its album */
+static signed char *zx_rate;                 /* per real track: 1 liked, -1 disliked */
+static int        *zx_liked, zx_nliked;      /* real tracks, in the order liked */
+static char      **zx_kept;                  /* liked songs' lines not on the card */
+static int         zx_nkept;
+static unsigned    zx_liked_ver;             /* changes when zx_liked does */
+static int        *zx_hash, zx_hcap;         /* path -> real track */
+static const char **zx_genre;                /* the distinct album genres, sorted */
+static int        *zx_genre_n;               /* per genre: how many albums */
+static int         zx_ngenre;
+static int        *zx_al_genre;              /* per album: its genre, or -1 */
+
+static unsigned zx_fnv(const char *s)
+{
+	unsigned h = 2166136261u;
+
+	while (*s) { h ^= (unsigned char)*s++; h *= 16777619u; }
+	return h;
+}
+
+static int zx_find(const char *path)
+{
+	unsigned h;
+
+	if (!zx_hash || !path) return -1;
+	for (h = zx_fnv(path) & (unsigned)(zx_hcap - 1); zx_hash[h] >= 0;
+	     h = (h + 1) & (unsigned)(zx_hcap - 1))
+		if (!strcmp(g_muse.tracks[zx_hash[h]].path, path)) return zx_hash[h];
+	return -1;
+}
+
+static void zx_free(void)
+{
+	int i;
+
+	for (i = 0; i < zx_nkept; i++) free(zx_kept[i]);
+	free(zx_kept); free(zx_m); free(zx_blob); free(zx_real); free(zx_alb); free(zx_rate);
+	free(zx_liked); free(zx_hash); free(zx_genre); free(zx_genre_n); free(zx_al_genre);
+	zx_kept = NULL; zx_nkept = 0;
+	zx_m = NULL; zx_blob = NULL; zx_real = zx_alb = NULL; zx_rate = NULL;
+	zx_liked = NULL; zx_nliked = 0; zx_liked_ver++;
+	zx_hash = NULL; zx_hcap = 0;
+	zx_genre = NULL; zx_genre_n = NULL; zx_ngenre = 0; zx_al_genre = NULL;
+}
+
+/* A file on the card, whole and NUL-terminated; `rel` is from the card. */
+static char *zx_slurp_card(const char *rel)
+{
+	char path[LIB_PATH * 2];
+	FILE *f;
+	char *b = NULL;
+	long n;
+
+	snprintf(path, sizeof path, "%s/%s", P_CARD, rel);
+	if (!(f = fopen(path, "rb"))) return NULL;
+	if (fseek(f, 0, SEEK_END) == 0 && (n = ftell(f)) >= 0 && n < 64L * 1024 * 1024 &&
+	    fseek(f, 0, SEEK_SET) == 0 && (b = malloc((size_t)n + 1)) &&
+	    fread(b, 1, (size_t)n, f) == (size_t)n) {
+		b[n] = '\0';
+	} else {
+		free(b);
+		b = NULL;
+	}
+	fclose(f);
+	return b;
+}
+
+/* `body(f)` as the card's `rel`, whole or not at all (src/atomic.h). */
+static bool zx_write_card(const char *rel, void (*body)(FILE *f))
+{
+	char file[LIB_PATH * 2], *slash;
+	FILE *f;
+
+	snprintf(file, sizeof file, "%s/%s", P_CARD, rel);
+	if ((slash = strrchr(file, '/'))) {
+		*slash = '\0';
+		mkdir(file, 0755);
+		*slash = '/';
+	}
+	if (!(f = atomic_open(file, 0644))) return false;
+	body(f);
+	return atomic_commit(f, file);
+}
+
+/* The next line of `*p`, cut out in place, without its CR; NULL at the end. */
+static char *zx_line(char **p)
+{
+	char *s = *p, *t;
+
+	if (!s) return NULL;
+	if ((t = strchr(s, '\n'))) { *t = '\0'; *p = t + 1; }
+	else *p = NULL;
+	if ((t = strchr(s, '\r'))) *t = '\0';
+	return s;
+}
+
+/* The next tab-separated field of `*p`, cut out in place. */
+static char *zx_field(char **p)
+{
+	char *s = *p, *t;
+
+	if (!s) return "";
+	if ((t = strchr(s, '\t'))) { *t = '\0'; *p = t + 1; }
+	else *p = NULL;
+	return s;
+}
+
+static const char *zx_known(const char *s) { return s && s[0] ? s : NULL; }
+
+static int zx_cmp_str(const void *a, const void *b)
+{
+	return strcasecmp(*(const char *const *)a, *(const char *const *)b);
+}
+
+static bool zx_is_music(int al)
+{
+	return al >= 0 && al < g_muse.nalbums && !g_muse.albums[al].book &&
+	       !g_muse.albums[al].playlist;
+}
+
+/* ---- liked songs -------------------------------------------------------------- *
+ *
+ * The playlist is the record of what is liked, in the order liked: a song on
+ * it is liked, and liking or unliking changes it. ratings.tsv keeps only the
+ * dislikes - two files saying one thing could disagree after a power cut. A
+ * playlist line for a song not on the card now is kept as it is, so a song
+ * taken off for a while comes back liked. Likes from before there was a
+ * playlist (ratings.tsv's "1" lines) move onto it the first time it is read. */
+
+#define ZX_LIKED_NAME "liked songs"
+#define ZX_LIKED_FILE ML_PLAYLISTS_DIR "/" ZX_LIKED_NAME ".m3u8"
+#define ZX_NOTE_MS    2000
+
+static const char *zx_note;          /* "added to liked songs", on Now Playing */
+static unsigned    zx_note_until;
+
+static void zx_ratings_body(FILE *f)
+{
+	int i;
+
+	for (i = 0; i < g_muse.ntracks; i++)
+		if (zx_real[i] == i && zx_rate[i] < 0)
+			fprintf(f, "%s\t-1\n", g_muse.tracks[i].path);
+}
+
+static void zx_liked_body(FILE *f)
+{
+	int i;
+
+	fprintf(f, "#EXTM3U\n# kept by Game Zune on the Pixel 2: the songs you like, in the order"
+	           " you liked them. Like or unlike a song there, or add or remove lines here.\n");
+	for (i = 0; i < zx_nliked; i++) {
+		int r = zx_liked[i];
+		const zx_meta *m = &zx_m[r];
+
+		if (m->title)
+			fprintf(f, "#EXTINF:%d,%s - %s\n", m->secs > 0 ? m->secs : -1, m->title,
+			        m->artist ? m->artist : "");
+		fprintf(f, "../%s\n", g_muse.tracks[r].path);
+	}
+	for (i = 0; i < zx_nkept; i++) fprintf(f, "%s\n", zx_kept[i]);
+}
+
+static int zx_liked_at(int r)
+{
+	int i;
+
+	for (i = 0; i < zx_nliked; i++) if (zx_liked[i] == r) return i;
+	return -1;
+}
+
+/* A playlist line as the library's own scan reads one: no byte-order mark,
+ * no spaces or tabs at either end. */
+static char *zx_trim(char *s)
+{
+	char *e;
+
+	if (!strncmp(s, "\xEF\xBB\xBF", 3)) s += 3;
+	while (*s == ' ' || *s == '\t') s++;
+	for (e = s + strlen(s); e > s && (e[-1] == ' ' || e[-1] == '\t'); e--) { }
+	*e = '\0';
+	return s;
+}
+
+/* Reads liked songs into zx_liked. `had_likes`: ratings.tsv still holds
+ * likes, from before the playlist kept them. */
+static void zx_liked_load(bool had_likes)
+{
+	int n = g_muse.ntracks, i;
+	bool listed = false, ratings = had_likes, *on = calloc((size_t)n, sizeof *on);
+	char *b = zx_slurp_card(ZX_LIKED_FILE), *p = b, *line, rel[LIB_PATH * 2];
+
+	zx_nliked = 0;
+	zx_liked_ver++;
+	if (!on) { free(b); return; }
+	while ((line = zx_line(&p))) {
+		int r;
+
+		line = zx_trim(line);
+		if (!line[0] || line[0] == '#') continue;
+		if (!ml_playlist_resolve(P_CARD, line, rel, sizeof rel) || (r = zx_find(rel)) < 0) {
+			char **k = realloc(zx_kept, sizeof *k * (size_t)(zx_nkept + 1));
+
+			if (k && (k[zx_nkept] = strdup(line))) { zx_kept = k; zx_nkept++; }
+			else if (k) zx_kept = k;
+			continue;
+		}
+		if (on[r]) { listed = true; continue; }       /* twice: once is enough */
+		if (zx_rate[r] < 0) ratings = true;            /* on the list wins */
+		zx_rate[r] = 1;
+		on[r] = true;
+		zx_liked[zx_nliked++] = r;
+	}
+	free(b);
+	for (i = 0; i < n; i++)
+		if (zx_real[i] == i && zx_rate[i] > 0 && !on[i]) {
+			zx_liked[zx_nliked++] = i;
+			listed = true;
+		}
+	free(on);
+	/* The playlist first: a cut between the two leaves a like, not a loss. */
+	if (listed) zx_write_card(ZX_LIKED_FILE, zx_liked_body);
+	if (ratings) zx_write_card(ZX_DIR "/ratings.tsv", zx_ratings_body);
+}
+
+/* ---- the index ---------------------------------------------------------------- */
+
+static int zx_r(int t) { return zx_real && t >= 0 && t < g_muse.ntracks ? zx_real[t] : t; }
+
+/* The genre an album is filed under: its first song's. */
+static const char *zx_album_genre(int al)
+{
+	const ml_album *a = &g_muse.albums[al];
+
+	return zx_m && a->n > 0 ? zx_m[zx_r(a->first)].genre : NULL;
+}
+
+/* The genres, once each whatever their case, with each album's and how
+ * many albums each has: what the genres list and its rows show. */
+static void zx_genres(void)
+{
+	int al, i, n = 0;
+
+	zx_genre = malloc(sizeof *zx_genre * (size_t)(g_muse.nalbums + 1));
+	zx_genre_n = calloc((size_t)(g_muse.nalbums + 1), sizeof *zx_genre_n);
+	zx_al_genre = malloc(sizeof *zx_al_genre * (size_t)(g_muse.nalbums + 1));
+	if (!zx_genre || !zx_genre_n || !zx_al_genre) return;
+	for (al = 0; al < g_muse.nalbums; al++) {
+		const char *g = zx_is_music(al) ? zx_album_genre(al) : NULL;
+
+		zx_al_genre[al] = -1;
+		if (g) zx_genre[n++] = g;
+	}
+	if (n > 1) qsort(zx_genre, (size_t)n, sizeof *zx_genre, zx_cmp_str);
+	for (i = 0; i < n; i++)
+		if (!zx_ngenre || strcasecmp(zx_genre[zx_ngenre - 1], zx_genre[i]))
+			zx_genre[zx_ngenre++] = zx_genre[i];
+	for (al = 0; al < g_muse.nalbums; al++) {
+		const char *g = zx_is_music(al) ? zx_album_genre(al) : NULL;
+		const char **hit = g ? bsearch(&g, zx_genre, (size_t)zx_ngenre, sizeof *zx_genre,
+		                               zx_cmp_str) : NULL;
+
+		if (hit) {
+			zx_al_genre[al] = (int)(hit - zx_genre);
+			zx_genre_n[zx_al_genre[al]]++;
+		}
+	}
+}
+
+static void zx_build(void)
+{
+	int n = g_muse.ntracks, i;
+	char *b, *p, *line;
+	bool had_likes = false;
+
+	zx_free();
+	zx_gen = g_muse_gen;
+	if (n <= 0) return;
+	for (zx_hcap = 64; zx_hcap < n * 2; zx_hcap *= 2) { }
+	zx_hash = malloc(sizeof *zx_hash * (size_t)zx_hcap);
+	zx_m = calloc((size_t)n, sizeof *zx_m);
+	zx_real = malloc(sizeof *zx_real * (size_t)n);
+	zx_alb = malloc(sizeof *zx_alb * (size_t)n);
+	zx_rate = calloc((size_t)n, sizeof *zx_rate);
+	zx_liked = malloc(sizeof *zx_liked * (size_t)n);
+	if (!zx_hash || !zx_m || !zx_real || !zx_alb || !zx_rate || !zx_liked) {
+		zx_free();
+		zx_gen = g_muse_gen;
+		return;
+	}
+	for (i = 0; i < zx_hcap; i++) zx_hash[i] = -1;
+	for (i = 0; i < n; i++) zx_alb[i] = -1;
+	/* Real tracks first - playlists come last in the library, so a path's
+	 * first appearance is its album's. */
+	for (i = 0; i < n; i++) {
+		int r = zx_find(g_muse.tracks[i].path);
+
+		if (r < 0) {
+			unsigned h = zx_fnv(g_muse.tracks[i].path) & (unsigned)(zx_hcap - 1);
+
+			while (zx_hash[h] >= 0) h = (h + 1) & (unsigned)(zx_hcap - 1);
+			zx_hash[h] = i;
+			r = i;
+		}
+		zx_real[i] = r;
+	}
+	for (i = 0; i < g_muse.nalbums; i++) {
+		const ml_album *a = &g_muse.albums[i];
+		int k;
+
+		if (!a->playlist)
+			for (k = a->first; k < a->first + a->n; k++) zx_alb[k] = i;
+	}
+
+	/* library.tsv: path title artist album genre year seconds track bpm tags */
+	if ((zx_blob = zx_slurp_card(ZX_DIR "/library.tsv"))) {
+		for (p = zx_blob; (line = zx_line(&p)); ) {
+			char *f = line;
+			int r;
+
+			if (line[0] == '#' || !line[0] || (r = zx_find(zx_field(&f))) < 0) continue;
+			zx_m[r].title  = zx_known(zx_field(&f));
+			zx_m[r].artist = zx_known(zx_field(&f));
+			zx_field(&f);                               /* album: the folder's */
+			zx_m[r].genre  = zx_known(zx_field(&f));
+			zx_m[r].year   = atoi(zx_field(&f));
+			zx_m[r].secs   = atoi(zx_field(&f));
+			zx_m[r].num    = atoi(zx_field(&f));
+		}
+	}
+	/* ratings.tsv: <path> TAB -1 (and, from before liked songs, 1) */
+	if ((b = zx_slurp_card(ZX_DIR "/ratings.tsv"))) {
+		for (p = b; (line = zx_line(&p)); ) {
+			char *f = line, *path = zx_field(&f);
+			int r, v = f ? atoi(f) : 0;
+
+			if (!v || (r = zx_find(path)) < 0) continue;
+			zx_rate[r] = (signed char)(v > 0 ? 1 : -1);
+			if (v > 0) had_likes = true;
+		}
+		free(b);
+	}
+	zx_liked_load(had_likes);
+	zx_genres();
+}
+
+static void zx_ensure(void)
+{
+	if (zx_gen != g_muse_gen) zx_build();
+}
+
+static const char *zx_title(int t)
+{
+	int r = zx_r(t);
+
+	if (zx_m && zx_m[r].title) return zx_m[r].title;
+	return g_muse.tracks[r].name;
+}
+
+static const char *zx_track_artist(int t)
+{
+	int r = zx_r(t), al = zx_alb ? zx_alb[r] : -1;
+
+	if (zx_m && zx_m[r].artist) return zx_m[r].artist;
+	return al >= 0 ? g_muse.artists[muse_artist_of(al)].name : "";
+}
+
+static int zx_album_year(int al)
+{
+	const ml_album *a = &g_muse.albums[al];
+
+	return zx_m && a->n > 0 ? zx_m[zx_r(a->first)].year : 0;
+}
+
+/* A listen, from musec: a line in plays.log, which scripts/zunesync.py
+ * reads for heavy rotation and discover. Not synced to the card: this runs
+ * on the UI thread, and a lost line on a power cut is one fewer count. */
+static void zx_on_played(const char *path)
+{
+	char dir[LIB_PATH * 2], file[LIB_PATH * 2 + 16];
+	FILE *f;
+
+	snprintf(dir, sizeof dir, "%s/%s", P_CARD, ZX_DIR);
+	mkdir(dir, 0755);
+	snprintf(file, sizeof file, "%s/plays.log", dir);
+	if ((f = fopen(file, "a"))) {
+		fprintf(f, "%ld\t%s\n", (long)time(NULL), path);
+		fclose(f);
+	}
+}
+
+/* Rate a song: 1 like, -1 dislike, 0 neither. A like puts it at the end of
+ * liked songs; anything else takes it off. */
+static void zx_rate_set(int t, int v)
+{
+	int r, at, was;
+	bool listed = false;
+
+	zx_ensure();
+	if (!zx_rate || t < 0 || t >= g_muse.ntracks) return;
+	r = zx_r(t);
+	was = zx_rate[r];
+	if (was == v) return;
+	zx_rate[r] = (signed char)v;
+	at = zx_liked_at(r);
+	if (v > 0 && at < 0) {
+		zx_liked[zx_nliked++] = r;
+		zx_note = "added to " ZX_LIKED_NAME;
+		listed = true;
+	} else if (v <= 0 && at >= 0) {
+		memmove(&zx_liked[at], &zx_liked[at + 1], sizeof *zx_liked * (size_t)(zx_nliked - at - 1));
+		zx_nliked--;
+		zx_note = "removed from " ZX_LIKED_NAME;
+		listed = true;
+	}
+	if (listed) {
+		zx_liked_ver++;
+		zx_note_until = plat_now_ms() + ZX_NOTE_MS;
+		zx_write_card(ZX_LIKED_FILE, zx_liked_body);
+	}
+	if ((was < 0) != (v < 0)) zx_write_card(ZX_DIR "/ratings.tsv", zx_ratings_body);
+}
+
+/* The note Now Playing shows for a moment after a like, and for how much
+ * longer; NULL when there is none. */
+static const char *zx_note_now(unsigned *left)
+{
+	unsigned now = plat_now_ms();
+
+	if (!zx_note || (int)(zx_note_until - now) <= 0) { zx_note = NULL; return NULL; }
+	*left = zx_note_until - now;
+	return zx_note;
+}
+
+static bool zx_loaded(void)
+{
+	mu_state s = musec_now()->state;
+
+	return s == MU_PLAYING || s == MU_PAUSED;
+}
+
+/* The real track Now Playing is on, or -1. */
+static int zx_now_track(void)
+{
+	const char *t = musec_track(musec_now()->index);
+
+	zx_ensure();
+	return zx_m && t ? zx_find(t) : -1;
+}
+
+/* Y on Now Playing: like the song, or unlike it. */
+static void zx_like_now(void)
+{
+	int r = zx_now_track();
+
+	if (r >= 0) zx_rate_set(r, zx_rate[r] > 0 ? 0 : 1);
+}
+
+/* ---- covers, small, for lists ---------------------------------------------- */
+
+#define ZC_SLOTS 64
+#define ZC_SIDE 208
+static struct { int al; unsigned gen; SDL_Texture *t; int w, h; bool none; unsigned used; } zc[ZC_SLOTS];
+static unsigned zc_clock;
+static int zc_budget;                /* loads left this frame */
+static bool zc_pending;              /* a load was put off to the next frame */
+
+static void zc_flush(void)
+{
+	int i;
+
+	for (i = 0; i < ZC_SLOTS; i++)
+		if (zc[i].t) SDL_DestroyTexture(zc[i].t);
+	memset(zc, 0, sizeof zc);
+}
+
+/* Muse has answered for some cover: albums remembered as having none are
+ * looked at again (cover_answers says which have one now). */
+static void zc_forget_none(void)
+{
+	int i;
+
+	for (i = 0; i < ZC_SLOTS; i++)
+		if (zc[i].none) memset(&zc[i], 0, sizeof zc[i]);
+}
+
+static SDL_Texture *zc_get(app *a, int al, int *w, int *h)
+{
+	char path[LIB_PATH * 2 + 8];
+	SDL_Surface *s, *small;
+	int i, slot = 0;
+
+	*w = *h = 0;
+	if (al < 0 || al >= g_muse.nalbums) return NULL;
+	for (i = 0; i < ZC_SLOTS; i++) {
+		if (zc[i].used && zc[i].al == al && zc[i].gen == g_muse_gen) {
+			zc[i].used = ++zc_clock;
+			*w = zc[i].w;
+			*h = zc[i].h;
+			return zc[i].t;
+		}
+		if (zc[i].used < zc[slot].used) slot = i;
+	}
+	if (zc_budget <= 0) { zc_pending = true; return NULL; }
+	if (!cover_file(al, path, sizeof path) &&
+	    !ml_folder_image(g_muse_root, &g_muse, al, path, sizeof path)) {
+		/* None yet: the empty tile, remembered, so nothing is asked again
+		 * every frame. If Muse was asked (cover_file did), its answer
+		 * clears this - zc_forget_none - and the cover is looked for then.
+		 * A picture in the album's folder does not wait for Muse: it is
+		 * the answer Muse would give for a record with none in its files. */
+		s = NULL;
+	} else {
+		zc_budget--;
+		s = IMG_Load(path);
+	}
+	if (zc[slot].t) SDL_DestroyTexture(zc[slot].t);
+	memset(&zc[slot], 0, sizeof zc[slot]);
+	zc[slot].al = al;
+	zc[slot].gen = g_muse_gen;
+	zc[slot].used = ++zc_clock;
+	if (!s) { zc[slot].none = true; return NULL; }
+	/* Down to the size a list draws it, so sixty-four of them are a few MB
+	 * rather than sixty-four full covers. */
+	small = SDL_CreateRGBSurfaceWithFormat(0, ZC_SIDE, ZC_SIDE * s->h / (s->w > 0 ? s->w : 1),
+	                                       32, SDL_PIXELFORMAT_ARGB8888);
+	if (small) {
+		SDL_BlitScaled(s, NULL, small, NULL);
+		zc[slot].t = SDL_CreateTextureFromSurface(a->r, small);
+		zc[slot].w = small->w;
+		zc[slot].h = small->h;
+		SDL_FreeSurface(small);
+	}
+	SDL_FreeSurface(s);
+	*w = zc[slot].w;
+	*h = zc[slot].h;
+	return zc[slot].t;
+}
+
+/* ---- lists ----------------------------------------------------------------- */
+
+typedef enum {
+	ZL_ARTISTS, ZL_ALBUMS, ZL_SONGS, ZL_GENRES, ZL_PLAYLISTS, ZL_BOOKS,
+	ZL_ARTIST_ALBUMS, ZL_GENRE_ALBUMS, ZL_TRACKS,
+} zl_kind;
+
+/* The twist's names for the music menu's sub-menus, in the Zune's order. */
+static const char *const ZL_NAME[] = {
+	[ZL_ARTISTS] = "artists", [ZL_ALBUMS] = "albums", [ZL_SONGS] = "songs",
+	[ZL_GENRES] = "genres", [ZL_PLAYLISTS] = "playlists", [ZL_BOOKS] = "audiobooks",
+	[ZL_ARTIST_ALBUMS] = "albums", [ZL_GENRE_ALBUMS] = "albums", [ZL_TRACKS] = "songs",
+};
+
+enum { ZL_NO_LEAD, ZL_SHUFFLE_ALL, ZL_PLAY_ALL };
+
+typedef struct {
+	zl_kind kind;
+	int *ids, n;          /* what each row is: artist, album, track, genre */
+	int lead;             /* row 0 is "shuffle all" or "play all", ids from row 1 */
+	int album;            /* ZL_TRACKS: whose */
+	int cursor;
+	unsigned liked_ver;   /* zx_liked_ver when filled */
+	coverflow cf;
+} zlist;
+
+/* Liked songs stands in the lists as one album past the last: an id no
+ * real album has, which the helpers below answer for. */
+static bool zx_is_liked(int al) { return al == g_muse.nalbums; }
+
+static const char *zx_al_name(int al)
+{
+	return zx_is_liked(al) ? ZX_LIKED_NAME : g_muse.albums[al].name;
+}
+
+/* A list of songs from anywhere, numbered in its own order. */
+static bool zx_al_mixed(int al) { return zx_is_liked(al) || g_muse.albums[al].playlist; }
+static int  zx_al_count(int al) { return zx_is_liked(al) ? zx_nliked : g_muse.albums[al].n; }
+
+static int zx_al_tracks(int al, int *out, int cap)
+{
+	int i, n = zx_al_count(al) < cap ? zx_al_count(al) : cap;
+
+	for (i = 0; i < n; i++) out[i] = zx_is_liked(al) ? zx_liked[i] : g_muse.albums[al].first + i;
+	return n;
+}
+
+static int zl_rows(const zlist *l) { return l->n + (l->lead ? 1 : 0); }
+static int zl_id(const zlist *l, int row)
+{
+	row -= l->lead ? 1 : 0;
+	return row >= 0 && row < l->n ? l->ids[row] : -1;
+}
+
+static bool zl_albumish(zl_kind k)
+{
+	return k == ZL_ALBUMS || k == ZL_PLAYLISTS || k == ZL_BOOKS ||
+	       k == ZL_ARTIST_ALBUMS || k == ZL_GENRE_ALBUMS;
+}
+
+/* For qsort, one comparator a kind: by name, whatever its case, and by
+ * index where two names agree, so the order is always the same. */
+static int zl_cmp(const char *p, const char *q, int a, int b)
+{
+	int c = strcasecmp(p, q);
+
+	return c ? c : a - b;
+}
+
+static int zl_by_artist(const void *x, const void *y)
+{
+	int a = *(const int *)x, b = *(const int *)y;
+
+	return zl_cmp(g_muse.artists[a].name, g_muse.artists[b].name, a, b);
+}
+
+static int zl_by_album(const void *x, const void *y)
+{
+	int a = *(const int *)x, b = *(const int *)y;
+
+	return zl_cmp(g_muse.albums[a].name, g_muse.albums[b].name, a, b);
+}
+
+static int zl_by_title(const void *x, const void *y)
+{
+	int a = *(const int *)x, b = *(const int *)y;
+
+	return zl_cmp(zx_title(a), zx_title(b), a, b);
+}
+
+static int zl_by_year(const void *x, const void *y)
+{
+	int a = *(const int *)x, b = *(const int *)y;
+	int ya = zx_album_year(a), yb = zx_album_year(b);
+
+	if (ya != yb) return ya && yb ? ya - yb : (ya ? -1 : 1);
+	return zl_by_album(x, y);
+}
+
+static void zl_sort(int *v, int n, int (*by)(const void *, const void *))
+{
+	if (n > 1) qsort(v, (size_t)n, sizeof *v, by);
+}
+
+/* Every song, by title: sorted once a library, since songs is the one list
+ * long enough for sorting it again to show. */
+static int     *zx_songs;
+static int      zx_nsongs;
+static unsigned zx_songs_gen = (unsigned)-1;
+
+static void zx_songs_ensure(void)
+{
+	int i;
+
+	if (zx_songs_gen == zx_gen) return;
+	free(zx_songs);
+	zx_nsongs = 0;
+	zx_songs_gen = zx_gen;
+	if (!zx_real || !(zx_songs = malloc(sizeof *zx_songs * (size_t)(g_muse.ntracks + 1)))) return;
+	for (i = 0; i < g_muse.ntracks; i++)
+		if (zx_real[i] == i && zx_is_music(zx_alb[i])) zx_songs[zx_nsongs++] = i;
+	zl_sort(zx_songs, zx_nsongs, zl_by_title);
+}
+
+/* Lists in name order, where a letter means something to jump by. */
+static bool zl_sorted(zl_kind k)
+{
+	return k == ZL_ARTISTS || k == ZL_ALBUMS || k == ZL_SONGS || k == ZL_GENRES ||
+	       k == ZL_BOOKS || k == ZL_GENRE_ALBUMS;
+}
+
+/* The most rows a kind can have. */
+static int zl_cap(zl_kind kind, int id)
+{
+	switch (kind) {
+	case ZL_ARTISTS: return g_muse.nartists;
+	case ZL_GENRES:  return zx_ngenre;
+	case ZL_SONGS:   return g_muse.ntracks;
+	case ZL_TRACKS:  return zx_al_count(id);
+	default:         return g_muse.nalbums + 1;      /* + liked songs */
+	}
+}
+
+/* Fill `l` with its kind's rows. `id` is the artist, genre or album. */
+static void zl_fill(zlist *l, zl_kind kind, int id)
+{
+	int i, al;
+
+	free(l->ids);
+	memset(l, 0, sizeof *l);
+	l->kind = kind;
+	l->album = kind == ZL_TRACKS ? id : -1;
+	l->lead = ZL_NO_LEAD;
+	l->liked_ver = zx_liked_ver;
+	cf_reset(&l->cf, 0);
+	l->ids = malloc(sizeof *l->ids * (size_t)(zl_cap(kind, id) + 1));
+	if (!l->ids) return;
+	switch (kind) {
+	case ZL_ARTISTS:
+		for (i = 0; i < g_muse.nartists; i++) {
+			const ml_artist *ar = &g_muse.artists[i];
+			int k;
+
+			for (k = ar->first; k < ar->first + ar->n; k++)
+				if (zx_is_music(k)) { l->ids[l->n++] = i; break; }
+		}
+		zl_sort(l->ids, l->n, zl_by_artist);
+		break;
+	case ZL_ALBUMS:
+		for (al = 0; al < g_muse.nalbums; al++) if (zx_is_music(al)) l->ids[l->n++] = al;
+		zl_sort(l->ids, l->n, zl_by_album);
+		break;
+	case ZL_PLAYLISTS:
+		/* Liked songs first, from memory; its file, when the scan read it
+		 * too, is the same list and not shown twice. */
+		if (zx_nliked > 0) l->ids[l->n++] = g_muse.nalbums;
+		for (al = 0; al < g_muse.nalbums; al++)
+			if (g_muse.albums[al].playlist && strcasecmp(g_muse.albums[al].name, ZX_LIKED_NAME))
+				l->ids[l->n++] = al;
+		break;
+	case ZL_BOOKS:
+		for (al = 0; al < g_muse.nalbums; al++)
+			if (g_muse.albums[al].book) l->ids[l->n++] = al;
+		zl_sort(l->ids, l->n, zl_by_album);
+		break;
+	case ZL_GENRES:
+		for (i = 0; i < zx_ngenre; i++) l->ids[l->n++] = i;
+		break;
+	case ZL_SONGS:
+		zx_songs_ensure();
+		memcpy(l->ids, zx_songs, sizeof *l->ids * (size_t)zx_nsongs);
+		l->n = zx_nsongs;
+		break;
+	case ZL_ARTIST_ALBUMS: {
+		const ml_artist *ar = &g_muse.artists[id];
+
+		for (al = ar->first; al < ar->first + ar->n; al++)
+			if (zx_is_music(al)) l->ids[l->n++] = al;
+		zl_sort(l->ids, l->n, zl_by_year);
+		break;
+	}
+	case ZL_GENRE_ALBUMS:
+		for (al = 0; al < g_muse.nalbums; al++)
+			if (zx_al_genre && zx_al_genre[al] == id) l->ids[l->n++] = al;
+		zl_sort(l->ids, l->n, zl_by_album);
+		break;
+	case ZL_TRACKS:
+		l->n = zx_al_tracks(id, l->ids, zl_cap(kind, id));
+		break;
+	}
+	/* The Zune's lead rows: "shuffle all" over the whole collection's
+	 * artists, albums and songs, "play all" under an artist, a genre or
+	 * inside an album. Playlists, genres and audiobooks have none. (A book
+	 * never becomes a list of tracks here: it opens Muse's book screen.) */
+	if (l->n > 0) {
+		if (kind == ZL_ARTISTS || kind == ZL_ALBUMS || kind == ZL_SONGS) l->lead = ZL_SHUFFLE_ALL;
+		if (kind == ZL_ARTIST_ALBUMS || kind == ZL_GENRE_ALBUMS || kind == ZL_TRACKS)
+			l->lead = ZL_PLAY_ALL;
+	}
+}
+
+/* The letter a row is filed under: 'a'-'z', '#' for anything else; 0 for the
+ * lead row, and in a list not in name order, where a letter says nothing. */
+static char zl_letter(const zlist *l, int row)
+{
+	const char *s;
+	int id = zl_id(l, row);
+
+	if (id < 0 || !zl_sorted(l->kind)) return 0;
+	switch (l->kind) {
+	case ZL_ARTISTS: s = g_muse.artists[id].name; break;
+	case ZL_GENRES:  s = zx_genre[id]; break;
+	case ZL_SONGS:   s = zx_title(id); break;
+	default:         s = zx_al_name(id); break;
+	}
+	if (s[0] >= 'a' && s[0] <= 'z') return s[0];
+	if (s[0] >= 'A' && s[0] <= 'Z') return (char)(s[0] + 32);
+	return '#';
+}
+
+#define ZL_PAGE 5          /* L1/R1 in a list not in name order: a screenful */
+
+/* The first row of the next (d > 0) or this-or-previous (d < 0) letter -
+ * or, where the list is not in name order, a screenful on. */
+static int zl_letter_jump(const zlist *l, int d)
+{
+	int rows = zl_rows(l), cur = l->cursor, i;
+	char c = zl_letter(l, cur);
+
+	if (rows <= 1) return cur;
+	if (!zl_sorted(l->kind)) {
+		i = cur + d * ZL_PAGE;
+		return i < 0 ? 0 : i >= rows ? rows - 1 : i;
+	}
+	if (d > 0) {
+		for (i = cur + 1; i < rows; i++) if (zl_letter(l, i) != c) return i;
+		return cur;
+	}
+	i = cur;
+	while (i > 0 && zl_letter(l, i - 1) == c && zl_letter(l, i - 1)) i--;
+	if (i != cur) return i;
+	if (i == 0) return 0;
+	c = zl_letter(l, i - 1);
+	for (i = i - 1; i > 0 && zl_letter(l, i - 1) == c && zl_letter(l, i - 1); i--) { }
+	return i;
+}
+
+/* ---- rows ------------------------------------------------------------------ */
+
+typedef struct { app *a; zlist *l; } zrow_ctx;
+
+static bool zrow_get(void *ctx, int i, zune_row *out)
+{
+	static char sub[256], num[16], right[16];
+	zrow_ctx *c = ctx;
+	zlist *l = c->l;
+	int id, k;
+
+	if (l->lead && i == 0) {
+		out->title = l->lead == ZL_SHUFFLE_ALL ? "shuffle all" : "play all";
+		out->lead = true;
+		return true;
+	}
+	if ((id = zl_id(l, i)) < 0) return false;
+	switch (l->kind) {
+	case ZL_ARTISTS: {
+		const ml_artist *ar = &g_muse.artists[id];
+		int albums = 0;
+
+		for (k = ar->first; k < ar->first + ar->n; k++) if (zx_is_music(k)) albums++;
+		out->title = ar->name;
+		snprintf(sub, sizeof sub, "%d album%s", albums, albums == 1 ? "" : "s");
+		out->sub = sub;
+		break;
+	}
+	case ZL_GENRES: {
+		int albums = zx_genre_n[id];
+
+		out->title = zx_genre[id];
+		snprintf(sub, sizeof sub, "%d album%s", albums, albums == 1 ? "" : "s");
+		out->sub = sub;
+		break;
+	}
+	case ZL_TRACKS: {
+		int r = zx_r(id);
+
+		out->title = zx_title(id);
+		if (zx_al_mixed(l->album)) {
+			snprintf(sub, sizeof sub, "%s", zx_track_artist(id));
+			out->sub = sub;
+			snprintf(num, sizeof num, "%d", i);
+		} else {
+			snprintf(num, sizeof num, "%d", zx_m[r].num > 0 ? zx_m[r].num : i);
+		}
+		out->num = num;
+		if (zx_m[r].secs > 0) {
+			snprintf(right, sizeof right, "%d:%02d", zx_m[r].secs / 60, zx_m[r].secs % 60);
+			out->right = right;
+		}
+		out->rating = zx_rate[r];
+		break;
+	}
+	case ZL_SONGS:
+		out->title = zx_title(id);
+		snprintf(sub, sizeof sub, "%s", zx_track_artist(id));
+		out->sub = sub;
+		out->rating = zx_rate[zx_r(id)];
+		break;
+	default: {           /* albums of every kind */
+		const ml_album *al;
+		int y;
+
+		if (zx_is_liked(id)) {
+			out->heart = true;
+			out->title = ZX_LIKED_NAME;
+			snprintf(sub, sizeof sub, "%d song%s", zx_nliked, zx_nliked == 1 ? "" : "s");
+			out->sub = sub;
+			break;
+		}
+		al = &g_muse.albums[id];
+		y = zx_album_year(id);
+
+		out->art = zc_get(c->a, id, &out->aw, &out->ah);
+		out->title = al->name;
+		if (al->playlist)
+			snprintf(sub, sizeof sub, "%d song%s", al->n, al->n == 1 ? "" : "s");
+		else if (l->kind == ZL_ARTIST_ALBUMS && y)
+			snprintf(sub, sizeof sub, "%d", y);
+		else if (al->book && g_book_done && g_book_done[id])
+			snprintf(sub, sizeof sub, "finished");
+		else
+			snprintf(sub, sizeof sub, "%s", g_muse.artists[muse_artist_of(id)].name);
+		out->sub = sub;
+		break;
+	}
+	}
+	return true;
+}
+
+static const zune_list_style *zl_style(const zlist *l)
+{
+	if (zl_albumish(l->kind)) return &ZUNE_ART_ROWS;
+	if (l->kind == ZL_TRACKS)
+		return zx_al_mixed(l->album) ? &ZUNE_LIST_ROWS : &ZUNE_TRACK_ROWS;
+	return &ZUNE_TEXT_ROWS;
+}
+
+/* ---- playing ----------------------------------------------------------------- */
+
+static void zx_play_tracks(const int *t, int n, int start, bool shuffle, int album)
+{
+	const char **paths;
+	int i;
+
+	if (n <= 0) return;
+	paths = malloc(sizeof *paths * (size_t)n);
+	if (!paths) return;
+	for (i = 0; i < n; i++) paths[i] = g_muse.tracks[t[i]].path;
+	if (shuffle) {
+		/* Ours, not the play mode's: "shuffle all" is this once. */
+		unsigned s = plat_now_ms() * 2654435761u + 7;
+
+		for (i = n - 1; i > 0; i--) {
+			int j;
+			const char *x;
+
+			s ^= s << 13; s ^= s >> 17; s ^= s << 5;
+			j = (int)(s % (unsigned)(i + 1));
+			x = paths[i]; paths[i] = paths[j]; paths[j] = x;
+		}
+		start = 0;
+	}
+	muse_play(paths, n, start, 0, false, 1.0, "", "");
+	g_queue_album = album >= 0 && album < g_muse.nalbums ? album : -1;
+	free(paths);
+}
+
+/* Every song, shuffled: the Zune's "shuffle all", for the in-game menu's
+ * Sound row when nothing is loaded. False with no music on the card. */
+static bool zx_shuffle_all(void)
+{
+	zx_ensure();
+	zx_songs_ensure();
+	if (zx_nsongs <= 0) return false;
+	zx_play_tracks(zx_songs, zx_nsongs, 0, true, -1);
+	return true;
+}
+
+static void zx_queue_tracks(const int *t, int n)
+{
+	const char **paths;
+	int i;
+
+	if (n <= 0 || !(paths = malloc(sizeof *paths * (size_t)n))) return;
+	for (i = 0; i < n; i++) paths[i] = g_muse.tracks[t[i]].path;
+	musec_append(paths, n, false);
+	free(paths);
+}
+
+/* The tracks one id of a kind stands for: an artist's, a genre's, an
+ * album's, or the one song. */
+static int zx_id_tracks(zl_kind kind, int id, int *out, int cap)
+{
+	int n = 0, i, al;
+
+	switch (kind) {
+	case ZL_ARTISTS: {
+		const ml_artist *ar = &g_muse.artists[id];
+
+		for (al = ar->first; al < ar->first + ar->n; al++)
+			if (zx_is_music(al))
+				for (i = 0; i < g_muse.albums[al].n && n < cap; i++)
+					out[n++] = g_muse.albums[al].first + i;
+		break;
+	}
+	case ZL_GENRES:                  /* the albums filed under it, whole */
+		for (al = 0; al < g_muse.nalbums && n < cap; al++)
+			if (zx_al_genre[al] == id) n += zx_al_tracks(al, out + n, cap - n);
+		break;
+	case ZL_SONGS: case ZL_TRACKS:
+		if (cap > 0) out[n++] = id;
+		break;
+	default:
+		n = zx_al_tracks(id, out, cap);
+		break;
+	}
+	return n;
+}
+
+/* A row's tracks: the lead row is everything in the list. */
+static int zx_row_tracks(const zlist *l, int row, int *out, int cap, int *album)
+{
+	int n = 0, k;
+
+	*album = -1;
+	if (l->lead && row == 0) {
+		for (k = 0; k < l->n && n < cap; k++) n += zx_id_tracks(l->kind, l->ids[k], out + n, cap - n);
+		if (l->kind == ZL_TRACKS) *album = l->album;
+		return n;
+	}
+	if (zl_id(l, row) < 0) return 0;
+	if (zl_albumish(l->kind)) *album = zl_id(l, row);
+	return zx_id_tracks(l->kind, zl_id(l, row), out, cap);
+}
+
+/* ---- the screens' common keys ------------------------------------------------ */
+
+#define ZT_IDLE_MS   1000   /* drawn at least this often, for the clock */
+
+/* What every music screen answers, whatever else it does: quit, power and
+ * Auto Off, volume, brightness and the lock. False when the screen must
+ * close for it. `dirty` is set when the screen should be drawn again. */
+static bool zx_common_keys(app *a, bool *dirty)
+{
+	int i;
+
+	if (a->in.quit_requested) { a->running = false; return false; }
+	if (a->in.pressed[IN_POWER] || idle_due(a)) { muse_power(a); return false; }
+	if (muse_keys(a)) {
+		muse_locked(a);
+		if (dirty) *dirty = true;
+		if (!a->running || g_muse_gone) return false;
+	}
+	for (i = 0; dirty && i < IN_COUNT; i++) if (a->in.pressed[i] || a->in.down[i]) *dirty = true;
+	return !g_muse_gone && a->running && !want_quit;
+}
+
+/* A menu's eased selection: closer to `sel` each frame, and there at last. */
+static float zx_ease_to(float pos, int sel)
+{
+	pos += ((float)sel - pos) * ZUNE_MENU_EASE;
+	return fabsf((float)sel - pos) < 0.01f ? (float)sel : pos;
+}
+
+/* ---- the twist ---------------------------------------------------------------- */
+
+/* One level of the music menu: the row across the top, and the list under
+ * it. The first level's row is the menu's sub-menus (artists, albums ...),
+ * each with its own list, filled the first time it is shown and kept - so
+ * twisting back finds the cursor where it was. Every level after it has for
+ * its row the items of the list it was entered from - other artists, other
+ * albums - so left and right go to the next one without going back. */
+typedef enum { ZT_CAT, ZT_SUB } zt_type;
+
+#define ZT_CATS     6
+#define ZT_DEPTH    4
+#define ZT_SLIDE_MS 220     /* the row's ease after a twist */
+#define ZT_SLIDE_PX 220     /* how far the list slides with it */
+#define ZT_LIST_Y   128     /* the list's top, under the row */
+
+typedef struct {
+	zt_type type;
+	zl_kind cats[ZT_CATS];
+	int ncat, cat;
+	zlist lists[ZT_CATS];    /* ZT_CAT: each sub-menu's */
+	zlist sib;               /* ZT_SUB: the row, no lead */
+	int pos;
+	zlist list;              /* ZT_SUB: the list */
+	int slide_dir;
+	unsigned slide_t0;
+} zt_level;
+
+static zlist *zt_list(zt_level *lv)
+{
+	return lv->type == ZT_CAT ? &lv->lists[lv->cat] : &lv->list;
+}
+
+static void zt_free(zt_level *lv)
+{
+	int i;
+
+	for (i = 0; i < ZT_CATS; i++) free(lv->lists[i].ids);
+	free(lv->sib.ids);
+	free(lv->list.ids);
+	memset(lv, 0, sizeof *lv);
+}
+
+static zl_kind zt_child(zl_kind sib)
+{
+	if (sib == ZL_ARTISTS) return ZL_ARTIST_ALBUMS;
+	if (sib == ZL_GENRES)  return ZL_GENRE_ALBUMS;
+	return ZL_TRACKS;
+}
+
+static void zt_refill(zt_level *lv)
+{
+	if (lv->type == ZT_CAT) zl_fill(&lv->lists[lv->cat], lv->cats[lv->cat], 0);
+	else zl_fill(&lv->list, zt_child(lv->sib.kind), lv->sib.ids[lv->pos]);
+}
+
+/* The level's list as it should be now: filled the first time it is shown,
+ * and again when a like has changed what it shows (the playlists, or liked
+ * songs itself), the cursor kept on what it was on where that is still
+ * there. */
+static void zt_keep(zt_level *lv)
+{
+	zlist *l = zt_list(lv);
+	int id, cur, rows, i;
+
+	if (!l->ids) { zt_refill(lv); return; }
+	if (l->liked_ver == zx_liked_ver) return;
+	if (l->kind != ZL_PLAYLISTS && !(l->kind == ZL_TRACKS && zx_is_liked(l->album))) {
+		l->liked_ver = zx_liked_ver;
+		return;
+	}
+	id = zl_id(l, l->cursor);
+	cur = l->cursor;
+	zt_refill(lv);
+	rows = zl_rows(l);
+	for (i = 0; id >= 0 && i < rows; i++) if (zl_id(l, i) == id) break;
+	l->cursor = id >= 0 && i < rows ? i : cur < rows ? cur : rows > 0 ? rows - 1 : 0;
+	cf_reset(&l->cf, l->cursor);
+}
+
+/* The level under `from`'s row `row`. */
+static bool zt_enter(zt_level *dst, const zlist *from, int row)
+{
+	int id = zl_id(from, row);
+
+	if (id < 0) return false;
+	memset(dst, 0, sizeof *dst);
+	dst->type = ZT_SUB;
+	dst->sib.kind = from->kind;
+	dst->sib.ids = malloc(sizeof *dst->sib.ids * (size_t)(from->n > 0 ? from->n : 1));
+	if (!dst->sib.ids) return false;
+	memcpy(dst->sib.ids, from->ids, sizeof *from->ids * (size_t)from->n);
+	dst->sib.n = from->n;
+	dst->pos = row - (from->lead ? 1 : 0);
+	zt_refill(dst);
+	return true;
+}
+
+/* Whether a sub-menu has anything in it: one that does not is not offered -
+ * no genres without the index, no playlists without any. */
+static bool zt_has(zl_kind k)
+{
+	int al;
+
+	switch (k) {
+	case ZL_ARTISTS: case ZL_ALBUMS: case ZL_SONGS: return ml_count(&g_muse, false) > 0;
+	case ZL_GENRES:  return zx_ngenre > 0;
+	case ZL_BOOKS:   return ml_count(&g_muse, true) > 0;
+	case ZL_PLAYLISTS:
+		if (zx_nliked > 0) return true;
+		for (al = 0; al < g_muse.nalbums; al++)
+			if (g_muse.albums[al].playlist && strcasecmp(g_muse.albums[al].name, ZX_LIKED_NAME))
+				return true;
+		return false;
+	default:         return false;
+	}
+}
+
+/* The first level: the sub-menus of `want` that have anything, at `start`.
+ * False when none has. */
+static bool zt_categories(zt_level *lv, const zl_kind *want, int n, zl_kind start)
+{
+	int i;
+
+	memset(lv, 0, sizeof *lv);
+	lv->type = ZT_CAT;
+	for (i = 0; i < n && lv->ncat < ZT_CATS; i++)
+		if (zt_has(want[i])) lv->cats[lv->ncat++] = want[i];
+	for (i = 0; i < lv->ncat; i++) if (lv->cats[i] == start) lv->cat = i;
+	if (lv->ncat > 0) zt_refill(lv);
+	return lv->ncat > 0;
+}
+
+static float zt_ease(const zt_level *lv)
+{
+	float u;
+
+	if (!lv->slide_t0) return 1;
+	u = (float)(plat_now_ms() - lv->slide_t0) / (float)ZT_SLIDE_MS;
+	if (u >= 1) return 1;
+	u = 1 - u;
+	return 1 - u * u * u;
+}
+
+/* What the row across the top shows, item by item - asked for only the few
+ * that fit. */
+typedef struct { app *a; zt_level *lv; } zt_row_ctx;
+
+static const char *zt_row_name(void *ctx, int i)
+{
+	zt_level *lv = ((zt_row_ctx *)ctx)->lv;
+
+	if (lv->type == ZT_CAT) return ZL_NAME[lv->cats[i]];
+	return lv->sib.kind == ZL_ARTISTS ? g_muse.artists[lv->sib.ids[i]].name
+	                                  : zx_genre[lv->sib.ids[i]];
+}
+
+static void zt_row_cover(void *ctx, int i, zune_cover *out)
+{
+	zt_row_ctx *c = ctx;
+	int al = c->lv->sib.ids[i];
+
+	memset(out, 0, sizeof *out);
+	out->heart = zx_is_liked(al);
+	out->art = zc_get(c->a, al, &out->w, &out->h);
+}
+
+/* The music menu, drawn. Returns true while something on it is moving or a
+ * cover was put off to the next frame. */
+static bool zt_draw(app *a, zt_level *lv, char letter, Uint8 letter_alpha)
+{
+	SDL_Renderer *r = a->r;
+	zlist *l = zt_list(lv);
+	zrow_ctx c = { a, l };
+	zt_row_ctx rc = { a, lv };
+	float e = zt_ease(lv), slide = (1 - e) * lv->slide_dir;
+
+	zc_budget = 3;
+	zc_pending = false;
+	zune_backdrop(r, 185);
+	if (lv->type == ZT_CAT)
+		zune_twist_text(r, lv->ncat, lv->cat, slide, zt_row_name, &rc);
+	else if (zl_albumish(lv->sib.kind))      /* inside an album: the others, as tiny covers */
+		zune_twist_covers(r, lv->sib.n, lv->pos, zx_al_name(lv->sib.ids[lv->pos]), slide,
+		                  zt_row_cover, &rc);
+	else
+		zune_twist_text(r, lv->sib.n, lv->pos, slide, zt_row_name, &rc);
+	cf_tick(&l->cf, zl_rows(l));
+	if (zl_rows(l) == 0)
+		zune_text(r, zune_font(ZF_SUB), "nothing here", 64, ZT_LIST_Y + 32, -1, ZUNE_GRAY);
+	else
+		zune_list(r, zl_style(l), &(SDL_Rect){ 32 + (int)(slide * ZT_SLIDE_PX), ZT_LIST_Y,
+		          TORTOS_SCREEN_W - 64, TORTOS_SCREEN_H - ZT_LIST_Y - 10 },
+		          zl_rows(l), l->cf.pos, l->cursor, zrow_get, &c);
+	if (letter && letter_alpha) zune_letter(r, letter, letter_alpha);
+	zune_clock(r);
+	return l->cf.active || e < 1 || zc_pending;
+}
+
+/* ---- options: what the center button held did ---------------------------------- */
+
+enum { ZA_PLAY, ZA_SHUFFLE, ZA_ADD, ZA_LIKE, ZA_DISLIKE, ZA_COUNT };
+
+/* The options a row has: play, shuffle (not for one song), add to now
+ * playing, and a song's rating. */
+static int zt_option_items(bool song, int rating, const char **items, int *acts)
+{
+	int n = 0;
+
+	items[n] = "play"; acts[n++] = ZA_PLAY;
+	if (!song) { items[n] = "shuffle"; acts[n++] = ZA_SHUFFLE; }
+	items[n] = "add to now playing"; acts[n++] = ZA_ADD;
+	if (song) {
+		items[n] = rating > 0 ? "unlike" : "rate: like"; acts[n++] = ZA_LIKE;
+		items[n] = rating < 0 ? "remove dislike" : "rate: dislike"; acts[n++] = ZA_DISLIKE;
+	}
+	return n;
+}
+
+/* The options over the menu: the action chosen, or -1. */
+static int zt_options(app *a, zt_level *lv, const char *what, bool song, int rating)
+{
+	const char *items[ZA_COUNT];
+	int acts[ZA_COUNT], n = zt_option_items(song, rating, items, acts), sel = 0;
+	unsigned last = 0;
+	bool dirty = true;
+
+	plat_input_flush();
+	memset(&a->in, 0, sizeof a->in);
+	while (!want_quit && a->running) {
+		muse_screen_poll();
+		plat_input_poll(&a->in);
+		if (!zx_common_keys(a, &dirty)) return -1;
+		if (a->in.pressed[IN_BACK] || a->in.pressed[IN_X]) return -1;
+		if (in_repeat(&a->in, IN_UP))   sel = (sel + n - 1) % n;
+		if (in_repeat(&a->in, IN_DOWN)) sel = (sel + 1) % n;
+		if (a->in.pressed[IN_ACCEPT]) return acts[sel];
+		if (dirty || plat_now_ms() - last > ZT_IDLE_MS) {
+			dirty = zt_draw(a, lv, 0, 0);
+			zune_options(a->r, what, items, n, sel);
+			plat_draw_osd(a->r);
+			plat_present();
+			last = plat_now_ms();
+		}
+		SDL_Delay(16);
+	}
+	return -1;
+}
+
+/* ---- the music menu ------------------------------------------------------------- */
+
+#define ZT_LETTER_HOLD_MS 450   /* held this long, a list is scrolling fast */
+#define ZT_LETTER_MS      600   /* and the letter shows this long after */
+#define ZT_LETTER_ALPHA   150
+
+/* Where a screen opened from the music menu leaves it: on, or closing
+ * (SELECT, power, the library gone from under it). A rescan is seen at the
+ * top of the loop, wherever it happened. */
+static bool zt_still_open(muse_exit how)
+{
+	return how != MUSE_CLOSE && !g_muse_gone;
+}
+
+/* The shelf the launcher is on, while the music is: Muse's games screen, as
+ * Muse's own shelf has it - MENU opens the menu of the screen it is on, and
+ * Muse's is the one with Rescan Folder. -1 when there is none. */
+static int zt_muse_shelf(app *a)
+{
+	int i;
+
+	for (i = 0; i < a->sys.count; i++) if (is_muse(&a->sys.systems[i])) return i;
+	return -1;
+}
+
+/* The Zune's music menu: its sub-menus across the top, entered at `start`.
+ * `now` opens on Now Playing, with the menu underneath. */
+static void zt_browse(app *a, const zl_kind *cats, int ncats, zl_kind start, bool now)
+{
+	zt_level st[ZT_DEPTH];
+	int depth = 0, i, *tmp = NULL, cap = 0;
+	screen_id prev_screen = a->screen;
+	char prev_sys[sizeof a->sys.systems[0].tag];
+	unsigned last_draw = 0, letter_until = 0, gen = 0;
+	char letter = 0;
+	bool dirty = true;
+
+	memset(st, 0, sizeof st);
+	snprintf(prev_sys, sizeof prev_sys, "%s", a->sys.systems[a->sys_cursor].tag);
+	if ((i = zt_muse_shelf(a)) >= 0) {
+		a->sys_cursor = i;
+		a->screen = SCREEN_GAMES;
+	}
+	plat_input_flush();
+	memset(&a->in, 0, sizeof a->in);
+	if (now && !zt_still_open(muse_now_screen(a))) goto out;
+	while (!want_quit && a->running) {
+		zt_level *lv;
+		zlist *l;
+		int rows, dir = 0, album, n;
+		unsigned now_ms = plat_now_ms();
+
+		/* The library rescanned - here, from Now Playing, from a book -
+		 * or this is the first pass: every index has moved, so the menu
+		 * starts over on what is there now. */
+		if (!depth || gen != g_muse_gen) {
+			while (depth > 0) zt_free(&st[--depth]);
+			zc_flush();
+			zx_ensure();
+			gen = g_muse_gen;
+			if (!zx_m || cap < g_muse.ntracks + 1) {
+				free(tmp);
+				cap = g_muse.ntracks + 1;
+				tmp = zx_m ? malloc(sizeof *tmp * (size_t)cap) : NULL;
+			}
+			if (!tmp || !zt_categories(&st[0], cats, ncats, start)) break;
+			depth = 1;
+			letter_until = 0;
+			dirty = true;
+		}
+		lv = &st[depth - 1];
+		zt_keep(lv);
+		l = zt_list(lv);
+		rows = zl_rows(l);
+
+		muse_screen_poll();
+		if (cover_answers()) { zc_forget_none(); dirty = true; }
+		plat_input_poll(&a->in);
+		if (!zx_common_keys(a, &dirty)) break;
+		if (a->in.pressed[IN_SELECT]) break;
+
+		if (a->in.pressed[IN_BACK]) {
+			zt_free(lv);
+			if (--depth == 0) break;
+			letter_until = 0;
+			continue;
+		}
+		if (a->in.pressed[IN_MENU]) {
+			if (!zt_still_open(muse_menu(a))) break;
+			continue;
+		}
+		if (a->in.pressed[IN_START] && zx_loaded()) {
+			if (!zt_still_open(muse_now_screen(a))) break;
+			continue;
+		}
+		/* The twist: left and right along the row across the top. */
+		{
+			int d = in_repeat(&a->in, IN_RIGHT) ? 1 : in_repeat(&a->in, IN_LEFT) ? -1 : 0;
+
+			if (d && lv->type == ZT_CAT && lv->ncat > 1) {
+				lv->cat = (lv->cat + d + lv->ncat) % lv->ncat;
+			} else if (d && lv->type == ZT_SUB && lv->sib.n > 1) {
+				lv->pos = (lv->pos + d + lv->sib.n) % lv->sib.n;
+				zt_refill(lv);
+			} else {
+				d = 0;
+			}
+			if (d) {
+				lv->slide_dir = d;
+				lv->slide_t0 = now_ms;
+				letter_until = 0;
+				continue;
+			}
+		}
+		if (rows > 0) {
+			if (in_repeat(&a->in, IN_UP))   { l->cursor = (l->cursor - 1 + rows) % rows; dir = -1; }
+			if (in_repeat(&a->in, IN_DOWN)) { l->cursor = (l->cursor + 1) % rows; dir = +1; }
+			if (in_repeat(&a->in, IN_L1))   l->cursor = zl_letter_jump(l, -1);
+			if (in_repeat(&a->in, IN_R1))   l->cursor = zl_letter_jump(l, +1);
+			cf_set_cursor_dir(&l->cf, l->cursor, rows, dir);
+			/* Scrolling fast - held, or a letter jump - shows the letter. */
+			if (((a->in.down[IN_UP] && now_ms - a->in.down_since[IN_UP] > ZT_LETTER_HOLD_MS) ||
+			     (a->in.down[IN_DOWN] && now_ms - a->in.down_since[IN_DOWN] > ZT_LETTER_HOLD_MS) ||
+			     a->in.pressed[IN_L1] || a->in.pressed[IN_R1]) && zl_letter(l, l->cursor)) {
+				letter = zl_letter(l, l->cursor);
+				letter_until = now_ms + ZT_LETTER_MS;
+			}
+		}
+
+		/* X: the options. A book has none - it is opened, and Muse's book
+		 * screen is where it is played from. */
+		if (a->in.pressed[IN_X] && rows > 0 && l->kind != ZL_BOOKS) {
+			bool song = (l->kind == ZL_SONGS || l->kind == ZL_TRACKS) && zl_id(l, l->cursor) >= 0;
+			int t = song ? zl_id(l, l->cursor) : -1, act;
+			zune_row zr;
+			zrow_ctx c = { a, l };
+
+			memset(&zr, 0, sizeof zr);
+			zrow_get(&c, l->cursor, &zr);
+			act = zt_options(a, lv, zr.title, song, song ? zx_rate[zx_r(t)] : 0);
+			if (!a->running || g_muse_gone) break;
+			switch (act) {
+			case ZA_PLAY: case ZA_SHUFFLE: case ZA_ADD:
+				n = zx_row_tracks(l, l->cursor, tmp, cap, &album);
+				if (act == ZA_ADD) {
+					zx_queue_tracks(tmp, n);
+					break;
+				}
+				zx_play_tracks(tmp, n, 0, act == ZA_SHUFFLE, album);
+				if (!zt_still_open(muse_now_screen(a))) goto out;
+				break;
+			case ZA_LIKE:    zx_rate_set(t, zx_rate[zx_r(t)] > 0 ? 0 : 1); break;
+			case ZA_DISLIKE: zx_rate_set(t, zx_rate[zx_r(t)] < 0 ? 0 : -1); break;
+			default: break;
+			}
+			plat_input_flush();
+			memset(&a->in, 0, sizeof a->in);
+			dirty = true;
+			continue;
+		}
+
+		if (a->in.pressed[IN_ACCEPT] && rows > 0) {
+			int row = l->cursor, id = zl_id(l, row);
+			muse_exit how = MUSE_BACK;
+
+			if (id < 0) {                            /* shuffle all / play all */
+				n = zx_row_tracks(l, row, tmp, cap, &album);
+				zx_play_tracks(tmp, n, 0, l->lead == ZL_SHUFFLE_ALL, album);
+				how = muse_now_screen(a);
+			} else if (l->kind == ZL_BOOKS) {
+				how = muse_book(a, id);
+			} else if (l->kind == ZL_SONGS || l->kind == ZL_TRACKS) {
+				/* A song plays on through the list it is in. */
+				zx_play_tracks(l->ids, l->n, row - (l->lead ? 1 : 0), false,
+				               l->kind == ZL_TRACKS ? l->album : -1);
+				how = muse_now_screen(a);
+			} else if (depth < ZT_DEPTH && zt_enter(&st[depth], l, row)) {
+				depth++;
+				letter_until = 0;
+			}
+			if (!zt_still_open(how)) break;
+			plat_input_flush();
+			memset(&a->in, 0, sizeof a->in);
+			dirty = true;
+			continue;
+		}
+
+		if (letter_until && (int)(now_ms - letter_until) > 0) { letter_until = 0; dirty = true; }
+		if (dirty || now_ms - last_draw > ZT_IDLE_MS) {
+			Uint8 la = 0;
+
+			if (letter_until) {
+				unsigned left = letter_until - now_ms;
+
+				la = (Uint8)(left > ZT_LETTER_MS / 2 ? ZT_LETTER_ALPHA
+				             : left * ZT_LETTER_ALPHA / (ZT_LETTER_MS / 2));
+			}
+			dirty = zt_draw(a, lv, letter, la) || letter_until;
+			plat_draw_osd(a->r);
+			plat_present();
+			last_draw = now_ms;
+			SDL_Delay(8);
+		} else {
+			SDL_Delay(16);
+		}
+	}
+out:
+	for (i = 0; i < ZT_DEPTH; i++) zt_free(&st[i]);
+	free(tmp);
+	/* Back on the shelf it came from, by its tag: a rescan can move every
+	 * system (rescan_all finds its own way back the same way). */
+	for (i = 0; i < a->sys.count; i++)
+		if (!strcmp(a->sys.systems[i].tag, prev_sys)) { a->sys_cursor = i; break; }
+	if (i == a->sys.count) a->sys_cursor = 0;
+	a->screen = prev_screen;
+	plat_input_flush();
+	memset(&a->in, 0, sizeof a->in);
+}
+
+static const zl_kind ZT_MUSIC[] = { ZL_ARTISTS, ZL_ALBUMS, ZL_SONGS, ZL_PLAYLISTS, ZL_GENRES };
+#define ZT_NMUSIC ((int)(sizeof ZT_MUSIC / sizeof ZT_MUSIC[0]))
+
+/* SELECT, in the Zune theme: the music menu - by way of Now Playing when
+ * something is playing, as the Zune's own button did. */
+static void zune_music(app *a, bool now)
+{
+	zt_browse(a, ZT_MUSIC, ZT_NMUSIC, ZL_ARTISTS, now);
+}
+
+/* ---- the zune menu -------------------------------------------------------------- */
+
+/* The words the zune menu offers right now: now playing while something
+ * is, then the collection's own that have anything in them - no playlists
+ * with none, no genres without the index - each opening the twist at itself,
+ * the way "game boy" lists the systems whose games are its twist. `what` is
+ * a zl_kind, or ZM_NOW. */
+#define ZM_NOW  (-1)
+#define ZM_MAX  (ZT_NMUSIC + 2)
+static int zm_items(const char **names, int *what)
+{
+	int i, n = 0;
+
+	zx_ensure();                        /* genres and liked songs are the index's */
+	if (zx_loaded()) { names[n] = "now playing"; what[n++] = ZM_NOW; }
+	for (i = 0; i < ZT_NMUSIC; i++)
+		if (zt_has(ZT_MUSIC[i])) { names[n] = ZL_NAME[ZT_MUSIC[i]]; what[n++] = (int)ZT_MUSIC[i]; }
+	if (zt_has(ZL_BOOKS)) { names[n] = ZL_NAME[ZL_BOOKS]; what[n++] = (int)ZL_BOOKS; }
+	return n;
+}
+
+static int zm_find(const int *what, int n, int w)
+{
+	int i;
+
+	for (i = 0; i < n; i++) if (what[i] == w) return i;
+	return -1;
+}
+
+/* What is playing, small, along the foot of a menu. */
+static void zm_playing_line(app *a)
+{
+	const mu_now *mn = musec_now();
+	char line[300];
+
+	if (!zx_loaded() || !mn->title[0]) return;
+	snprintf(line, sizeof line, "%s  %s%s%s", mn->state == MU_PAUSED ? "paused" : "now playing",
+	         mn->title, mn->artist[0] ? "  -  " : "", mn->artist);
+	zune_lower(line, line, sizeof line);
+	zune_text_fit(a->r, zune_font(ZF_SMALL), line, 54, TORTOS_SCREEN_H - 50,
+	              TORTOS_SCREEN_W - 108, ZUNE_SOFT);
+}
+
+static void zm_draw(app *a, int sel, float pos)
+{
+	const char *names[ZM_MAX];
+	int what[ZM_MAX], n = zm_items(names, what);
+
+	zune_backdrop(a->r, 60);
+	zune_menu_words(a->r, names, n, sel, pos);
+	zm_playing_line(a);
+	zune_clock(a->r);
+}
+
+/* "zune", from the top: the music's own menu. It opens where you last
+ * went in, artists the first time. */
+static void zune_menu_screen(app *a)
+{
+	static int went = ZL_ARTISTS;
+	const char *names[ZM_MAX];
+	int what[ZM_MAX], n = zm_items(names, what), sel = zm_find(what, n, went);
+	float pos;
+	unsigned last = 0;
+	bool dirty = true;
+
+	if (n <= 0) return;
+	if (sel < 0) sel = 0;
+	pos = (float)sel;
+	plat_input_flush();
+	memset(&a->in, 0, sizeof a->in);
+	while (!want_quit && a->running) {
+		/* "now playing" comes and goes: the cursor stays on its word. */
+		{
+			int was = what[sel], k;
+
+			n = zm_items(names, what);
+			if (n <= 0) break;                       /* the library emptied */
+			if ((k = zm_find(what, n, was)) >= 0) { pos += (float)(k - sel); sel = k; }
+			else if (sel >= n) sel = n - 1;
+		}
+		muse_screen_poll();
+		plat_input_poll(&a->in);
+		if (!zx_common_keys(a, &dirty)) break;
+		if (a->in.pressed[IN_BACK]) break;
+		if (in_repeat(&a->in, IN_UP))   sel = (sel + n - 1) % n;
+		if (in_repeat(&a->in, IN_DOWN)) sel = (sel + 1) % n;
+		if (a->in.pressed[IN_SELECT] || a->in.pressed[IN_ACCEPT]) {
+			int w = a->in.pressed[IN_SELECT] ? ZL_ARTISTS : what[sel];
+
+			g_muse_over = NULL;
+			g_muse_gone = false;
+			if (w == ZM_NOW) {
+				zune_music(a, true);
+			} else if (w == ZL_BOOKS) {
+				static const zl_kind books[] = { ZL_BOOKS };
+
+				zt_browse(a, books, 1, ZL_BOOKS, false);
+			} else {
+				zt_browse(a, ZT_MUSIC, ZT_NMUSIC, (zl_kind)w, false);
+			}
+			if (w != ZM_NOW) went = w;
+			n = zm_items(names, what);
+			if ((sel = zm_find(what, n, w)) < 0) sel = 0;
+			pos = (float)sel;
+			g_menu_closing = false;
+			plat_input_flush();
+			memset(&a->in, 0, sizeof a->in);
+			dirty = true;
+			continue;
+		}
+		if (a->in.pressed[IN_MENU]) {
+			tortos_menu(a);
+			g_menu_closing = false;         /* put down outside the menus */
+			dirty = true;
+			continue;
+		}
+		pos = zx_ease_to(pos, sel);
+		if (dirty || pos != (float)sel || plat_now_ms() - last > ZT_IDLE_MS) {
+			zm_draw(a, sel, pos);
+			plat_draw_osd(a->r);
+			plat_present();
+			last = plat_now_ms();
+			dirty = false;
+		}
+		SDL_Delay(12);
+	}
+	plat_input_flush();
+	memset(&a->in, 0, sizeof a->in);
+}
+
+/* ---- now playing ----------------------------------------------------------------- */
+
+static bool zq_get(void *ctx, int i, zune_row *out)
+{
+	static char sub[256];
+	const char *t = musec_track(i);
+	int r;
+
+	(void)ctx;
+	if (!t) return false;
+	zx_ensure();
+	if (zx_m && (r = zx_find(t)) >= 0) {
+		out->title = zx_title(r);
+		snprintf(sub, sizeof sub, "%s", zx_track_artist(r));
+		out->sub = sub;
+		out->rating = zx_rate[r];
+	} else {
+		out->title = strrchr(t, '/') ? strrchr(t, '/') + 1 : t;
+	}
+	return true;
+}
+
+/* "song list", from Now Playing's options: what plays, in its order. A
+ * plays the one chosen. */
+static void zune_queue_screen(app *a)
+{
+	static const char *const row[] = { "now playing" };
+	coverflow cf;
+	int n = musec_now()->count, cur = musec_now()->index;
+	unsigned last = 0;
+	bool dirty = true;
+
+	if (n <= 0) return;
+	cf_reset(&cf, cur);
+	plat_input_flush();
+	memset(&a->in, 0, sizeof a->in);
+	while (!want_quit && a->running) {
+		int dir = 0;
+
+		muse_screen_poll();
+		plat_input_poll(&a->in);
+		if (!zx_common_keys(a, &dirty)) return;
+		if (a->in.pressed[IN_BACK] || a->in.pressed[IN_SELECT]) return;
+		n = musec_now()->count;
+		if (n <= 0) return;
+		if (cur >= n) cur = n - 1;
+		if (in_repeat(&a->in, IN_UP))   { cur = (cur - 1 + n) % n; dir = -1; }
+		if (in_repeat(&a->in, IN_DOWN)) { cur = (cur + 1) % n; dir = 1; }
+		cf_set_cursor_dir(&cf, cur, n, dir);
+		if (a->in.pressed[IN_ACCEPT]) { musec_jump(cur); return; }
+		if (dirty || cf.active || plat_now_ms() - last > ZT_IDLE_MS) {
+			cf_tick(&cf, n);
+			zune_backdrop(a->r, 185);
+			zune_twist_text(a->r, 1, 0, 0, zune_names_at, (void *)row);
+			zune_list(a->r, &ZUNE_TEXT_ROWS, &(SDL_Rect){ 32, ZT_LIST_Y, TORTOS_SCREEN_W - 64,
+			          TORTOS_SCREEN_H - ZT_LIST_Y - 10 }, n, cf.pos, cur, zq_get, NULL);
+			zune_clock(a->r);
+			plat_draw_osd(a->r);
+			plat_present();
+			last = plat_now_ms();
+			dirty = false;
+		}
+		SDL_Delay(12);
+	}
+}
+
+static int zx_rating_now(void)
+{
+	const char *t = musec_track(musec_now()->index);
+	int r;
+
+	if (zx_gen != g_muse_gen || !zx_rate || !t || (r = zx_find(t)) < 0) return 0;
+	return zx_rate[r];
+}
+
+static void zx_set_mode(muq_mode m)
+{
+	musec_set_mode(m);
+	db_set_str(db_dev(), "muse.mode", MUSE_MODES[m].key);
+}
+
+/* Now Playing's options, as they stand: rate the song (when it is one the
+ * library knows), the song list, shuffle and repeat - the Zune's four - and,
+ * while music plays, the pocket lock. */
+enum { ZN_RATE, ZN_LIST, ZN_SHUFFLE, ZN_REPEAT, ZN_LOCK, ZN_COUNT };
+typedef struct { const char *items[ZN_COUNT]; int acts[ZN_COUNT], n; char sh[32], rp[32]; } zn_menu;
+
+static void zn_items(zn_menu *m, int rating, bool rated, muq_mode mode, bool lockable)
+{
+	m->n = 0;
+	if (rated) {
+		m->items[m->n] = rating > 0 ? "rating: like" : rating < 0 ? "rating: dislike" : "rate this song";
+		m->acts[m->n++] = ZN_RATE;
+	}
+	m->items[m->n] = "song list"; m->acts[m->n++] = ZN_LIST;
+	snprintf(m->sh, sizeof m->sh, "shuffle: %s", mode == MUQ_SHUFFLE ? "on" : "off");
+	m->items[m->n] = m->sh; m->acts[m->n++] = ZN_SHUFFLE;
+	snprintf(m->rp, sizeof m->rp, "repeat: %s",
+	         mode == MUQ_REPEAT_ALL ? "all" : mode == MUQ_REPEAT_ONE ? "one" : "off");
+	m->items[m->n] = m->rp; m->acts[m->n++] = ZN_REPEAT;
+	if (lockable) { m->items[m->n] = "lock screen"; m->acts[m->n++] = ZN_LOCK; }
+}
+
+/* The center button on Now Playing. The song is looked up each pass: the
+ * music goes on under the menu, and a rating is for the song playing now. */
+static void zune_np_options(app *a)
+{
+	int sel = 0;
+	unsigned last = 0;
+	bool dirty = true;
+
+	plat_input_flush();
+	memset(&a->in, 0, sizeof a->in);
+	while (!want_quit && a->running) {
+		muq_mode mode = musec_mode();
+		int r = zx_now_track();
+		zn_menu m;
+
+		zn_items(&m, r >= 0 ? zx_rate[r] : 0, r >= 0, mode, lock_allowed());
+		if (sel >= m.n) sel = m.n - 1;
+		muse_screen_poll();
+		plat_input_poll(&a->in);
+		if (!zx_common_keys(a, &dirty)) return;
+		if (a->in.pressed[IN_BACK]) return;
+		if (in_repeat(&a->in, IN_UP))   sel = (sel + m.n - 1) % m.n;
+		if (in_repeat(&a->in, IN_DOWN)) sel = (sel + 1) % m.n;
+		if (a->in.pressed[IN_ACCEPT] || in_repeat(&a->in, IN_LEFT) || in_repeat(&a->in, IN_RIGHT)) {
+			switch (m.acts[sel]) {
+			case ZN_RATE:    zx_rate_set(r, zx_rate[r] == 0 ? 1 : zx_rate[r] > 0 ? -1 : 0); break;
+			case ZN_LIST:    zune_queue_screen(a); return;
+			case ZN_LOCK:    muse_locked(a); return;   /* back to Now Playing, lit */
+			case ZN_SHUFFLE: zx_set_mode(mode == MUQ_SHUFFLE ? MUQ_IN_ORDER : MUQ_SHUFFLE); break;
+			case ZN_REPEAT:  zx_set_mode(mode == MUQ_REPEAT_ALL ? MUQ_REPEAT_ONE
+			                             : mode == MUQ_REPEAT_ONE ? MUQ_IN_ORDER : MUQ_REPEAT_ALL);
+			                 break;
+			}
+			continue;                         /* drawn with what it changed */
+		}
+		/* Twice a second: the time under the menu moves. */
+		if (dirty || plat_now_ms() - last > ZT_IDLE_MS / 2) {
+			np_draw(a, musec_now(), NULL);
+			zune_options(a->r, musec_now()->title, m.items, m.n, sel);
+			plat_draw_osd(a->r);
+			plat_present();
+			last = plat_now_ms();
+			dirty = false;
+		}
+		SDL_Delay(12);
+	}
+}
+
+/* ---- the shot harness ------------------------------------------------------------ */
+
+/* --zmusic SPEC: one frame of the Zune theme's music.
+ *   zune                     the zune menu
+ *   artists|albums|songs|genres|playlists    the music menu at that sub-menu
+ *   artist:N  genre:N  album:N              a level down, at that row
+ *   ... +letter / +options   with the fast-scroll letter / the options over it
+ *   npoptions                Now Playing's options (with --nowplaying) */
+static void zune_music_shot(app *a, const char *spec)
+{
+	zt_level lv, top;
+	char kind[32] = "";
+	int id = 0, i;
+	const char *over = strchr(spec, '+');
+	zlist *l;
+
+	zx_ensure();
+	if (!zx_m) return;
+	if (!strncmp(spec, "zune", 4)) { zm_draw(a, 0, 0); return; }
+	if (!strncmp(spec, "npoptions", 9)) {
+		zn_menu m;
+
+		zn_items(&m, 0, true, MUQ_REPEAT_ALL, true);
+		zune_options(a->r, musec_now()->title[0] ? musec_now()->title : "track 2", m.items, m.n, 0);
+		return;
+	}
+	sscanf(spec, "%31[a-z]:%d", kind, &id);
+	if (!strcmp(kind, "artist") || !strcmp(kind, "genre") || !strcmp(kind, "album")) {
+		zl_kind k = !strcmp(kind, "artist") ? ZL_ARTISTS : !strcmp(kind, "genre") ? ZL_GENRES : ZL_ALBUMS;
+
+		if (!zt_categories(&top, ZT_MUSIC, ZT_NMUSIC, k) || top.cats[top.cat] != k) {
+			fprintf(stderr, "shot: no %s in this library\n", ZL_NAME[k]);
+			zt_free(&top);
+			return;
+		}
+		l = zt_list(&top);
+		if (!zt_enter(&lv, l, id + (l->lead ? 1 : 0))) { zt_free(&top); return; }
+		zt_free(&top);
+	} else {
+		zl_kind k = ZL_ARTISTS;
+
+		for (i = 0; i < ZT_NMUSIC; i++)
+			if (!strcmp(ZL_NAME[ZT_MUSIC[i]], kind)) k = ZT_MUSIC[i];
+		if (!zt_categories(&lv, ZT_MUSIC, ZT_NMUSIC, k)) return;
+	}
+	l = zt_list(&lv);
+	if (zl_rows(l) > 2) { l->cursor = 2; cf_reset(&l->cf, 2); }
+	for (i = 0; i < 40 && zt_draw(a, &lv, over && !strcmp(over, "+letter") ? zl_letter(l, 2) : 0,
+	                               over && !strcmp(over, "+letter") ? ZT_LETTER_ALPHA : 0); i++)
+		if (cover_answers()) zc_forget_none();
+	if (over && !strcmp(over, "+options")) {
+		const char *items[ZA_COUNT];
+		int acts[ZA_COUNT], n = zt_option_items(false, 0, items, acts);
+		zune_row zr;
+		zrow_ctx c = { a, l };
+
+		memset(&zr, 0, sizeof zr);
+		zrow_get(&c, l->cursor, &zr);
+		zune_options(a->r, zr.title ? zr.title : "", items, n, 0);
+	}
