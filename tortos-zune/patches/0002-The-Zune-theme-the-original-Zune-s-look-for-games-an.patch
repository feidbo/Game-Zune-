+/* The Zune theme is a card set in the menu, but it is more than art: it lays
+ * both shelves out as lists, so it decides the direction too. A list runs
+ * down the screen, which is Vertical's input axis - with down as next, the
+ * way a page reads, rather than Vertical's stack that grows upward. Cubic is
+ * off while it is on: there is no cube in a list. */
+static bool zune_ui(void)      { return CARD_SETS[g_cards].zune; }
+static bool dir_both(void)     { return !zune_ui() && CARD_DIRS[g_dir].both; }
+static bool dir_vertical(void) { return zune_ui() || CARD_DIRS[g_dir].vertical; }
+/* The d-pad along a shelf: back and forward, and the letter jump across it. */
+static void shelf_keys(in_button *back, in_button *fwd, in_button *jup, in_button *jdn)
+{
+	bool vert = dir_vertical();
+
+	*back = zune_ui() ? IN_UP   : vert ? IN_DOWN : IN_LEFT;
+	*fwd  = zune_ui() ? IN_DOWN : vert ? IN_UP   : IN_RIGHT;
+	*jup  = zune_ui() ? IN_L1 : vert ? IN_LEFT  : IN_UP;
+	*jdn  = zune_ui() ? IN_R1 : vert ? IN_RIGHT : IN_DOWN;
+}
