+/* A system's games: the twist, with the systems across the top. */
+static void zune_draw_games(app *a)
+{
+	sysview *v = &a->view[a->sys_cursor];
+	const char *names[CFG_MAX_SYSTEMS];
+	int sys[CFG_MAX_SYSTEMS], n = v->list.count, ns, i;
+	float u = (float)(plat_now_ms() - g_zslide_t0) / 220.0f, slide = 0;
+	unsigned now = plat_now_ms();
+
+	if (g_zslide_t0 && u < 1) {
+		slide = (1 - (1 - (1 - u) * (1 - u) * (1 - u))) * g_zslide_dir;
+		redraw_now();
+	}
+	cf_tick(&v->cf, n);
+	if (v->cf.active) redraw_now();
+	{
+		int land = cf_landing(&v->cf, n);
+		if (land >= 0) prime_toward(a, a->sys_cursor, land);
+	}
+	if (!cf_cutting(&v->cf)) evict_far(v, TEX_KEEP_NEAR);
+
+	zune_backdrop(a->r, 185);
+	ns = zg_systems(a, sys);
+	for (i = 0; i < ns; i++) names[i] = a->sys.systems[sys[i]].name;
+	zune_twist_text(a->r, ns, zg_index(sys, ns, a->sys_cursor), slide, zune_names_at, names);
+	zune_list(a->r, &ZUNE_ART_ROWS, &(SDL_Rect){ 32 + (int)(slide * 220), 128,
+	          TORTOS_SCREEN_W - 64, TORTOS_SCREEN_H - 138 }, n, v->cf.pos, v->cursor,
+	          zune_game_row, a);
+	if (g_zletter_until > now) {
+		unsigned left = g_zletter_until - now;
+
+		zune_letter(a->r, g_zletter, (Uint8)(left > 300 ? 150 : left / 2));
+		redraw_at(now + 16);
+	}
+	zune_clock(a->r);
+}
+
+/* The games' twist: left and right to the next system. */
+static bool zune_games_twist(app *a)
+{
+	int sys[CFG_MAX_SYSTEMS], ns = zg_systems(a, sys), cur, d;
+
+	d = in_repeat(&a->in, IN_RIGHT) ? 1 : in_repeat(&a->in, IN_LEFT) ? -1 : 0;
+	if (!d || ns < 2) return false;
+	cur = zg_index(sys, ns, a->sys_cursor);
+	a->sys_cursor = sys[(cur + d + ns) % ns];
+	cf_reset(&a->cf_sys, a->sys_cursor);   /* the stock shelf's row, kept with it */
+	enter_system(a);                       /* which loads this system's covers */
+	g_zslide_dir = d;
+	g_zslide_t0 = plat_now_ms();
+	return true;
+}
+
+/* The fast-scroll letter, after a move: shown while a direction is held or
+ * a letter jump was made. */
+static void zune_games_letter(app *a)
+{
+	unsigned now = plat_now_ms();
+	sysview *v = &a->view[a->sys_cursor];
+
+	if ((a->in.down[IN_UP] && now - a->in.down_since[IN_UP] > 450) ||
+	    (a->in.down[IN_DOWN] && now - a->in.down_since[IN_DOWN] > 450) ||
+	    a->in.pressed[IN_L1] || a->in.pressed[IN_R1]) {
+		g_zletter = zune_game_letter(v);
+		g_zletter_until = now + 600;
+		redraw_now();
+	}
+}
