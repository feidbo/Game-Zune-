+/* The Zune theme's pocket lock is stricter, for a player carried in a
+ * pocket: START held on Now Playing, or its options' "lock screen", and then
+ * every button is ignored - volume and power too - but MENU, which wakes it.
+ * A wake that no other button follows within ZUNE_RELOCK_MS locks again, so
+ * MENU bumped in a pocket lights the screen for moments, not hours. Auto Off
+ * still turns the player off once the music has stopped. */
+#define ZUNE_RELOCK_MS 10000
+static unsigned g_relock_at;             /* after a MENU wake; 0 when none */
+
+/* The relock after a wake: true when it is due, the screen untouched. */
+static bool zune_relock_due(const in_state *in)
+{
+	int b;
+
+	if (!zune_ui() || !g_relock_at) return false;
+	for (b = 0; b < IN_COUNT; b++)
+		if (in->pressed[b] || in->down[b]) { g_relock_at = 0; return false; }
+	if ((int)(plat_now_ms() - g_relock_at) < 0) return false;
+	g_relock_at = 0;
+	return lock_allowed();
+}
