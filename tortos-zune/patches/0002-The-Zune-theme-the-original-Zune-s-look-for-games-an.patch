+/* Now Playing as the original Zune had it. */
+static unsigned zune_np_draw(app *a, const mu_now *mn, const char *next)
+{
+	zune_np z = { 0 };
+	char where[64] = "";
+	const char *p;
+	unsigned h = 2166136261u, note_left = 0, wait;
+	muq_mode m = musec_mode();
+
+	(void)next;
+	if (mn->count > 1) snprintf(where, sizeof where, "%d of %d", mn->index + 1, mn->count);
+	for (p = mn->album; *p; p++) { h ^= (unsigned char)*p; h *= 16777619u; }
+	z.artist = mn->artist;
+	z.album = mn->album;
+	z.title = mn->title;
+	z.where = where;
+	z.state = mn->state == MU_PLAYING ? NULL : mn->state == MU_PAUSED ? "paused" : "stopped";
+	z.at = mn->at;
+	z.len = mn->len;
+	z.cover = g_np.tex;
+	z.seed = h;
+	z.rating = musec_is_book() ? 0 : zx_rating_now();
+	z.shuffle = !musec_is_book() && m == MUQ_SHUFFLE;
+	z.repeat = musec_is_book() ? 0 : m == MUQ_REPEAT_ALL ? 1 : m == MUQ_REPEAT_ONE ? 2 : 0;
+	z.note = zx_note_now(&note_left);
+	wait = zune_now_playing(a->r, &z);
+	/* Drawn again the moment the note is due to go. */
+	return z.note && note_left < wait ? note_left : wait;
+}
