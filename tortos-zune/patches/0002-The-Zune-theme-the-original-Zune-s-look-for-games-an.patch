+/* The letter the cursor's game is filed under - the one L1/R1 jump by, so
+ * the two agree - lowercase as the Zune drew it. */
+static char zune_game_letter(const sysview *v)
+{
+	char c;
+
+	if (v->cursor < 0 || v->cursor >= v->list.count) return 0;
+	c = shelf_initial(shelf_key(v, v->cursor));
+	return c >= 'A' && c <= 'Z' ? (char)(c + 32) : c ? c : '#';
