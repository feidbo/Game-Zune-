-typedef struct { char name[128]; int first, n; bool book, singles; } ml_album;  /* tracks[first..] */
+/* `playlist`: one of the card's Playlists/<name>.m3u files, read as an album whose
+ * tracks live in other albums' folders. Its name is the file's, without the
+ * extension; its cover is kept at Playlists/.media/<name>.jpg; and it comes
+ * last in the library, under an artist of its own, so an album's index and
+ * ml_album_of's answer for a track are both the same as without it. */
+typedef struct { char name[128]; int first, n; bool book, singles, playlist; } ml_album;  /* tracks[first..] */
 #define ML_SINGLES "Singles"
+#define ML_PLAYLISTS_DIR "Playlists"
