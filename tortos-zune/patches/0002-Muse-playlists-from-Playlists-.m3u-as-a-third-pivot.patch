+/* ---- playlists -------------------------------------------------------------- */
+
+/* `path` with "." and ".." taken out, in place. False when ".." climbs above
+ * the start - out of the card. */
+static bool squash(char *path)
+{
+	char *seg[64], buf[LIB_PATH * 2], *tok, *save = NULL;
+	int n = 0, i;
+	size_t used = 0;
+
+	snprintf(buf, sizeof buf, "%s", path);
+	for (tok = strtok_r(buf, "/", &save); tok; tok = strtok_r(NULL, "/", &save)) {
+		if (!strcmp(tok, ".")) continue;
+		if (!strcmp(tok, "..")) { if (n == 0) return false; n--; continue; }
+		if (n >= 64) return false;
+		seg[n++] = tok;
+	}
+	path[0] = '\0';
+	for (i = 0; i < n; i++)
+		used += (size_t)snprintf(path + used, LIB_PATH - used, "%s%s", i ? "/" : "", seg[i]);
+	return n > 0 && used < LIB_PATH;
+}
+
+static bool audio_at(const char *card, const char *rel)
+{
+	char full[LIB_PATH * 3];
+	struct stat st;
+
+	if (!ml_is_audio(rel)) return false;
+	snprintf(full, sizeof full, "%s/%s", card, rel);
+	return stat(full, &st) == 0 && S_ISREG(st.st_mode);
+}
+
+bool ml_playlist_resolve(const char *card, const char *line, char *out, size_t n)
+{
+	char s[LIB_PATH * 2], try[LIB_PATH * 2];
+	const char *m;
+	size_t i;
+
+	snprintf(s, sizeof s, "%s", line);
+	for (i = 0; s[i]; i++) if (s[i] == '\\') s[i] = '/';
+	if (!strncmp(s, "file://", 7)) memmove(s, s + 7, strlen(s + 7) + 1);
+
+	/* Beside the playlist: "../Music/Artist/Album/01.mp3". */
+	if (s[0] != '/' && !strchr(s, ':')) {
+		snprintf(try, sizeof try, "%s/%s", ML_PLAYLISTS_DIR, s);
+		if (squash(try) && audio_at(card, try)) return snprintf(out, n, "%s", try) < (int)n;
+		/* From the card's top: "Music/Artist/Album/01.mp3". */
+		snprintf(try, sizeof try, "%s", s);
+		if (squash(try) && audio_at(card, try)) return snprintf(out, n, "%s", try) < (int)n;
+	}
+	/* From another machine, or the card mounted somewhere: the last Music or
+	 * Audiobooks folder in the path is the card's. */
+	for (m = s; (m = strstr(m, "Music/")); m++) {
+		const char *from = m;
+
+		if (m > s && m[-1] != '/') {
+			/* "Audiobooks/" is not "Music/", but "X/Music/" is. */
+			continue;
+		}
+		snprintf(try, sizeof try, "%s", from);
+		if (squash(try) && audio_at(card, try)) return snprintf(out, n, "%s", try) < (int)n;
+	}
+	if ((m = strstr(s, "Audiobooks/"))) {
+		snprintf(try, sizeof try, "%s", m);
+		if (squash(try) && audio_at(card, try)) return snprintf(out, n, "%s", try) < (int)n;
+	}
+	return false;
+}
+
+/* A playlist's track as its list shows it: the song, and whose it is, since a
+ * playlist is many artists' - "Digital Love - Daft Punk". The artist is the
+ * folder over the album's, Music/<artist>/<album>/<file>. */
+static void playlist_name(const char *rel, const char *extinf, char *out, int n)
+{
+	const char *file = strrchr(rel, '/');
+	char song[128];
+
+	if (extinf && extinf[0]) { snprintf(out, (size_t)n, "%s", extinf); return; }
+	ml_track_name(file ? file + 1 : rel, song, sizeof song);
+	if (!strncmp(rel, "Music/", 6)) {
+		const char *a = rel + 6, *slash = strchr(a, '/');
+
+		if (slash && strchr(slash + 1, '/')) {
+			char artist[128];
+
+			snprintf(artist, sizeof artist, "%.*s", (int)(slash - a), a);
+			ml_clean_words(artist);
+			snprintf(out, (size_t)n, "%s - %s", song, artist);
+			return;
+		}
+	}
+	snprintf(out, (size_t)n, "%s", song);
+}
+
+static bool is_playlist_file(const char *name)
+{
+	const char *dot = strrchr(name, '.');
+
+	return dot && (!strcasecmp(dot, ".m3u") || !strcasecmp(dot, ".m3u8"));
+}
+
+/* <card>/Playlists/<name>.m3u, after everything else, under one artist. A line
+ * that names nothing on the card is passed over, so a playlist made on
+ * another computer plays what it can; one that names nothing at all is not
+ * shown. */
+static void scan_playlists(ml_lib *out, caps *c, const char *card)
+{
+	char dir[LIB_PATH * 2];
+	names files = { 0 };
+	int i, before = out->nalbums;
+	ml_artist *ar;
+
+	snprintf(dir, sizeof dir, "%s/%s", card, ML_PLAYLISTS_DIR);
+	{
+		/* list_dir keeps only audio, so the playlists are listed here. */
+		DIR *d = opendir(dir);
+		struct dirent *e;
+
+		while (d && (e = readdir(d)))
+			if (e->d_name[0] != '.' && is_playlist_file(e->d_name))
+				names_add(&files, e->d_name);
+		if (d) closedir(d);
+		if (files.n) qsort(files.v, (size_t)files.n, sizeof *files.v, cmp_name);
+	}
+	for (i = 0; i < files.n; i++) {
+		char path[LIB_PATH * 3], line[LIB_PATH * 2], extinf[128] = "";
+		ml_album *al;
+		FILE *f;
+		int stem;
+
+		if (!is_playlist_file(files.v[i])) continue;
+		snprintf(path, sizeof path, "%s/%s", dir, files.v[i]);
+		if (!(f = fopen(path, "r"))) continue;
+		if (!grow((void **)&out->albums, out->nalbums, &c->a, sizeof *out->albums)) {
+			fclose(f);
+			break;
+		}
+		al = &out->albums[out->nalbums];
+		memset(al, 0, sizeof *al);
+		stem = (int)(strrchr(files.v[i], '.') - files.v[i]);
+		if (stem <= 0) { fclose(f); continue; }
+		snprintf(al->name, sizeof al->name, "%.*s", stem, files.v[i]);
+		al->playlist = true;
+		al->first = out->ntracks;
+		while (fgets(line, sizeof line, f)) {
+			char *p = line, rel[LIB_PATH];
+			size_t len;
+			ml_track *t;
+
+			if (!strncmp(p, "\xEF\xBB\xBF", 3)) p += 3;           /* a BOM */
+			len = strlen(p);
+			while (len && (p[len - 1] == '\n' || p[len - 1] == '\r' ||
+			               p[len - 1] == ' ' || p[len - 1] == '\t'))
+				p[--len] = '\0';
+			while (*p == ' ' || *p == '\t') p++;
+			if (!*p) continue;
+			if (*p == '#') {
+				/* #EXTINF:<seconds>,<what to call it> names the next line. */
+				const char *comma = strchr(p, ',');
+
+				if (!strncmp(p, "#EXTINF:", 8) && comma)
+					snprintf(extinf, sizeof extinf, "%s", comma + 1);
+				continue;
+			}
+			if (!ml_playlist_resolve(card, p, rel, sizeof rel)) { extinf[0] = '\0'; continue; }
+			if (!grow((void **)&out->tracks, out->ntracks, &c->t, sizeof *out->tracks)) break;
+			t = &out->tracks[out->ntracks++];
+			snprintf(t->path, sizeof t->path, "%s", rel);
+			playlist_name(rel, extinf, t->name, sizeof t->name);
+			extinf[0] = '\0';
+			al->n++;
+		}
+		fclose(f);
+		if (al->n > 0) out->nalbums++;
+		else out->ntracks = al->first;
+	}
+	names_free(&files);
+	if (out->nalbums == before) return;
+	if (!grow((void **)&out->artists, out->nartists, &c->r, sizeof *out->artists)) return;
+	ar = &out->artists[out->nartists++];
+	snprintf(ar->name, sizeof ar->name, "%s", ML_PLAYLISTS_DIR);
+	ar->first = before;
+	ar->n = out->nalbums - before;
+	ar->book = false;
+}
+
