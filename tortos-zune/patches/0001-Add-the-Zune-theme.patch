+/* SPDX-License-Identifier: MIT */
+#ifndef TORTOS_ZUNE_H
+#define TORTOS_ZUNE_H
+
+#include <SDL.h>
+#include <SDL_ttf.h>
+#include <stdbool.h>
+
+/* The Zune theme: the Zune HD's look, drawn by TortOS.
+ *
+ * Black, lowercase, and type doing all the work - huge light headings that
+ * run off the edge of the screen, a row of pivots under them, and lists of
+ * art with words beside it. One accent, the Zune's magenta, for what is
+ * selected and for what is playing.
+ *
+ * This file is the drawing only. It knows nothing about shelves, systems or
+ * Muse: main.c gathers what a screen shows and hands it over, so the theme
+ * can be read and retuned without reading the launcher. */
+
+/* Zune magenta. */
+#define ZUNE_ACCENT 0xEC008Cu
+
+typedef enum {
+	ZF_HUGE,   /* the panorama heading and Now Playing's artist  */
+	ZF_HUB,    /* the hub's words                                 */
+	ZF_PIVOT,  /* pivots                                          */
+	ZF_ROW,    /* a row's title, a track's name                   */
+	ZF_SUB,    /* a row's second line                             */
+	ZF_SMALL,  /* counts, times, hints                            */
+	ZF_COUNT
+} zune_font_role;
+
+/* Opens the theme's fonts from <root>/fonts/ (zune-light.ttf,
+ * zune-semilight.ttf, zune-regular.ttf), falling back to `fallback` for any
+ * that is missing, so a card without them still draws the theme in the
+ * launcher's own face. Cheap to call again: it opens nothing twice. */
+bool zune_init(SDL_Renderer *r, const char *root, const char *fallback);
+void zune_quit(void);
+TTF_Font *zune_font(zune_font_role role);
+
+/* ui_text, with a cache sized for screens that are mostly words: a list of
+ * five rows is ten strings, which the shared twelve-entry cache cannot hold
+ * beside a heading, a pivot row and a clock. Text is rendered white once and
+ * tinted as it is drawn, so a row changing color when it is selected costs a
+ * blit and not a render. Returns the width drawn. anchor: -1 left, 0 center,
+ * 1 right. */
+int zune_text(SDL_Renderer *r, TTF_Font *f, const char *s, int x, int y,
+              int anchor, SDL_Color col);
+int zune_text_width(TTF_Font *f, const char *s);
+/* The same, cut short with an ellipsis to fit `maxw`. */
+int zune_text_fit(SDL_Renderer *r, TTF_Font *f, const char *s, int x, int y,
+                  int maxw, SDL_Color col);
+
+/* ASCII lowercase, which is the whole of the Zune's typographic rule. */
+void zune_lower(const char *in, char *out, size_t n);
+
+/* The colors. */
+SDL_Color zune_rgb(unsigned rgb, Uint8 alpha);
+#define ZUNE_WHITE ((SDL_Color){ 255, 255, 255, 255 })
+#define ZUNE_SOFT  ((SDL_Color){ 196, 196, 196, 255 })
+#define ZUNE_GRAY  ((SDL_Color){ 128, 128, 128, 255 })
+#define ZUNE_DARK  ((SDL_Color){  72,  72,  72, 255 })
+
+void zune_clear(SDL_Renderer *r);
+
+/* The heading that runs off the right edge: `title`, lowercased, in the
+ * largest type, slid left by `slide` pixels. */
+void zune_panorama(SDL_Renderer *r, const char *title, int y, float slide,
+                   SDL_Color col);
+
+/* A row of pivots with the selected one first and bright, the rest trailing
+ * off to the right in gray - the Zune's way of saying there is more to
+ * either side. `labels` are lowercased as they are drawn. */
+void zune_pivots(SDL_Renderer *r, const char *const *labels, int n, int sel,
+                 int x, int y, unsigned accent);
+
+/* The time, top right, in the Zune's corner. */
+void zune_clock(SDL_Renderer *r);
+
+/* ---- lists --------------------------------------------------------------- */
+
+/* One row of a list: art at the left, a title, and a quieter line under it. */
+typedef struct {
+	SDL_Texture *art;   /* NULL draws an empty tile until it arrives */
+	int aw, ah;
+	const char *title;
+	const char *sub;    /* may be NULL or empty */
+	bool marked;        /* a favorite: a small accent mark before the sub */
+} zune_row;
+
+/* Fill `out` for item `i`. Return false to leave the row blank. */
+typedef bool (*zune_row_fn)(void *ctx, int i, zune_row *out);
+
+/* A vertical list of `count` rows inside `area`, scrolled so `pos` (the
+ * shelf's own continuous position) is in view, with `cursor` selected.
+ *
+ * A list that fits is laid out from the top and does not move; only the
+ * selection does. A longer one keeps the selection on the second row, so
+ * there is always one above it to say where you came from, and scrolls under
+ * it - wrapping, as the shelves do. */
+void zune_list(SDL_Renderer *r, const SDL_Rect *area, int count, float pos,
+               int cursor, zune_row_fn get, void *ctx, unsigned accent);
+
+/* The hub: the words, one per system, the selected one white. `pos` is the
+ * systems shelf's continuous position, so the column glides with it. */
+typedef const char *(*zune_word_fn)(void *ctx, int i);
+void zune_hub_words(SDL_Renderer *r, const SDL_Rect *area, int count,
+                    float pos, int cursor, zune_word_fn word, void *ctx);
+
+/* A square tile of art, contain-fitted on a dark square, as the hub's
+ * quickplay column draws them. */
+void zune_tile(SDL_Renderer *r, SDL_Texture *art, int aw, int ah,
+               const SDL_Rect *q, Uint8 alpha);
+
+/* ---- now playing --------------------------------------------------------- */
+
+typedef struct {
+	const char *artist, *album, *title;
+	const char *where;      /* "2 of 12", or a book's chapter */
+	const char *next;       /* the next track's name, or NULL */
+	const char *state;      /* NULL while playing, else "paused" and so on */
+	const char *hints;
+	double at, len;         /* seconds */
+	SDL_Texture *cover;
+	int glyph;              /* a ui_glyph for the play mode, or -1 */
+	unsigned now_ms;        /* the clock the artist's name drifts on */
+} zune_np;
+
+/* Returns how long until the picture would change by itself, in ms. */
+unsigned zune_now_playing(SDL_Renderer *r, const zune_np *np);
+
+#endif
