+/* ---------- the Zune theme ----------------------------------------------- *
+ *
+ * The same shelves, drawn as the Zune HD drew its collection: the systems as
+ * a column of words, each shelf as a list of art and names under a heading
+ * that runs off the screen, with its sort orders as the pivots. Everything
+ * here gathers what to show; src/zune.c does the drawing. */
+
+/* What the hub calls a system: Muse is the music, as the Zune said it. */
+static const char *zune_sys_name(const system_cfg *s)
+{
+	if (is_muse(s)) return muse_books_shown() ? "audiobooks" : "music";
+	return s->name;
+}
+
+static const char *zune_hub_word(void *ctx, int i)
+{
+	app *a = ctx;
+
+	if (i < 0 || i >= a->sys.count) return "";
+	return is_muse(&a->sys.systems[i]) ? "music" : a->sys.systems[i].name;
+}
+
+/* The second line of a game's row. On Favorites it is the system the game is
+ * from; elsewhere the region and dump tags the shelf's title leaves off, since
+ * that is what tells two copies of one game apart. */
+static void zune_game_sub(app *a, const sysview *v, int i, char *out, size_t n)
+{
+	const game_entry *g = &v->list.items[i];
+	const char *open, *close;
+	size_t k;
+
+	out[0] = '\0';
+	if (v->owner) {
+		zune_lower(a->sys.systems[shelf_owner(a, a->sys_cursor, i)].name, out, n);
+		return;
+	}
+	open = strchr(g->name, '(');
+	close = open ? strchr(open, ')') : NULL;
+	if (!open || !close || close - open < 2) return;
+	k = (size_t)(close - open - 1);
+	if (k >= n) k = n - 1;
+	memcpy(out, open + 1, k);
+	out[k] = '\0';
+	zune_lower(out, out, n);
+}
+
+static bool zune_game_row(void *ctx, int i, zune_row *out)
+{
+	static char sub[LIB_NAME];
+	app *a = ctx;
+	sysview *v = &a->view[a->sys_cursor];
+	const system_cfg *s = &a->sys.systems[a->sys_cursor];
+	const game_entry *g;
+	float cb;
+
+	if (i < 0 || i >= v->list.count) return false;
+	g = &v->list.items[i];
+	out->art = game_get_tex(a, i, &out->aw, &out->ah, &cb);
+	out->title = g->title;
+	if (is_muse(s)) {
+		int al = v->album ? v->album[i] : -1;
+
+		/* An album's second line is its artist; a book's says it is done,
+		 * and says nothing rather than its own name again. */
+		out->sub = g->name;
+		if (al >= 0 && g_muse.albums[al].book) {
+			if (g_book_done && g_book_done[al]) out->sub = "finished";
+			else if (!strcmp(g->name, g->title)) out->sub = "";
+		}
+		return true;
+	}
+	zune_game_sub(a, v, i, sub, sizeof sub);
+	out->sub = sub;
+	out->marked = fav_is(a->sys.systems[shelf_owner(a, a->sys_cursor, i)].tag,
+	                     g->file);
+	return true;
+}
+
+/* What is playing, along the foot of the hub, so the music is never more than
+ * a glance away - and SELECT is what opens it. */
+static void zune_hub_playing(app *a)
+{
+	const mu_now *mn = musec_now();
+	TTF_Font *fs = zune_font(ZF_SMALL);
+	char line[300];
+	int x = 48, y = TORTOS_SCREEN_H - 76;
+
+	if (!mn || (mn->state != MU_PLAYING && mn->state != MU_PAUSED) || !mn->title[0])
+		return;
+	SDL_SetRenderDrawColor(a->r, (Uint8)(ZUNE_ACCENT >> 16), (Uint8)(ZUNE_ACCENT >> 8),
+	                       (Uint8)ZUNE_ACCENT, 255);
+	SDL_RenderFillRect(a->r, &(SDL_Rect){ x, y + 8, 14, 14 });
+	x += 28;
+	x += zune_text(a->r, fs, mn->state == MU_PAUSED ? "paused" : "now playing",
+	               x, y, -1, ZUNE_GRAY) + 18;
+	snprintf(line, sizeof line, "%s%s%s", mn->title, mn->artist[0] ? "  -  " : "",
+	         mn->artist);
+	zune_lower(line, line, sizeof line);
+	zune_text_fit(a->r, fs, line, x, y, TORTOS_SCREEN_W - 48 - x, ZUNE_WHITE);
+}
+
+static void zune_draw_hub(app *a)
+{
+	int n = a->sys.count, sel = a->sys_cursor;
+	sysview *v = &a->view[sel];
+	const system_cfg *s = &a->sys.systems[sel];
+	SDL_Rect words = { 46, 92, 640, TORTOS_SCREEN_H - 92 - 104 };
+	int tile = 128, gap = 12, tx = TORTOS_SCREEN_W - 48 - tile * 2 - gap, ty = 112;
+	char line[64];
+	int k, shown;
+
+	cf_tick(&a->cf_sys, n);
+	if (a->cf_sys.active) redraw_now();
+	zune_hub_words(a->r, &words, n, a->cf_sys.pos, sel, zune_hub_word, a);
+
+	/* Quickplay: the art of where you are in the focused shelf - the game or
+	 * album the cursor was left on and the three after it. game_get_tex reads
+	 * the focused system, which is the one these belong to. */
+	shown = v->list.count < 4 ? v->list.count : 4;
+	for (k = 0; k < shown; k++) {
+		int i = (v->cursor + k) % v->list.count, w = 0, h = 0;
+		float cb;
+		SDL_Texture *t = game_get_tex(a, i, &w, &h, &cb);
+		SDL_Rect q = { tx + (k % 2) * (tile + gap), ty + (k / 2) * (tile + gap),
+		               tile, tile };
+
+		zune_tile(a->r, t, w, h, &q, k == 0 ? 255 : 200);
+	}
+	if (is_muse(s)) {
+		int albums = ml_count(&g_muse, false);
+
+		snprintf(line, sizeof line, "%d album%s", albums, albums == 1 ? "" : "s");
+	} else {
+		snprintf(line, sizeof line, "%d game%s", v->list.count,
+		         v->list.count == 1 ? "" : "s");
+	}
+	zune_text(a->r, zune_font(ZF_SMALL), line, tx, ty + 2 * (tile + gap) + 4, -1,
+	          ZUNE_GRAY);
+	zune_hub_playing(a);
+	zune_clock(a->r);
+}
+
+static void zune_draw_games(app *a)
+{
+	sysview *v = &a->view[a->sys_cursor];
+	const system_cfg *s = &a->sys.systems[a->sys_cursor];
+	SDL_Rect list = { 46, 232, TORTOS_SCREEN_W - 92, TORTOS_SCREEN_H - 232 - 16 };
+	const char *pivots[8];
+	int n = v->list.count, np = 0, k;
+
+	cf_tick(&v->cf, n);
+	if (v->cf.active) redraw_now();
+	{
+		int land = cf_landing(&v->cf, n);
+		if (land >= 0) prime_toward(a, a->sys_cursor, land);
+	}
+	if (!cf_cutting(&v->cf)) evict_far(v, TEX_KEEP_NEAR);
+
+	zune_panorama(a->r, zune_sys_name(s), -40, 0.0f, (SDL_Color){ 255, 255, 255, 230 });
+	if (is_muse(s)) {
+		for (k = 0; k < ML_ORDERS && np < 8; k++)
+			pivots[np++] = ml_order_label((ml_order)k, muse_books_shown());
+	} else {
+		for (k = 0; k < SORT_COUNT && np < 8; k++) pivots[np++] = SORTS[k].label;
+	}
+	zune_pivots(a->r, pivots, np, v->sort >= 0 && v->sort < np ? v->sort : 0,
+	            48, 150, ZUNE_ACCENT);
+	zune_list(a->r, &list, n, v->cf.pos, v->cursor, zune_game_row, a, ZUNE_ACCENT);
+	zune_clock(a->r);
+}
+
+/* Now Playing, the Zune HD's way: the artist across the top, enormous. */
+static unsigned zune_np_draw(app *a, const mu_now *mn, const char *next)
+{
+	zune_np z = { 0 };
+	char where[64] = "", hints[128];
+	const char *state = mn->state == MU_PLAYING ? NULL
+	                  : mn->state == MU_PAUSED  ? "paused" : "stopped";
+	int book = musec_is_book() ? ml_album_of(&g_muse, musec_track(mn->index)) : -1;
+
+	if (mn->state == MU_STOPPED && book >= 0 && g_book_done && g_book_done[book])
+		state = "finished";
+	if (musec_is_book() && musec_chapters() > 1)
+		snprintf(where, sizeof where, "chapter %d of %d",
+		         musec_chapter_now() + 1, musec_chapters());
+	else if (mn->count > 1)
+		snprintf(where, sizeof where, "%d of %d", mn->index + 1, mn->count);
+	snprintf(hints, sizeof hints, "a %s    l1/r1 %s    left/right seek    y %s",
+	         state ? "play" : "pause", musec_is_book() ? "chapter" : "track",
+	         musec_is_book() ? "speed" : "mode");
+	z.artist = mn->artist;
+	z.album = mn->album;
+	z.title = mn->title;
+	z.where = where;
+	z.next = next;
+	z.state = state;
+	z.hints = hints;
+	z.at = mn->at;
+	z.len = mn->len;
+	z.cover = g_np.tex;
+	z.glyph = musec_is_book() ? -1 : MUSE_MODES[musec_mode()].glyph;
+	z.now_ms = plat_now_ms();
+	return zune_now_playing(a->r, &z);
+}
