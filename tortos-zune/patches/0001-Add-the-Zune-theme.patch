new file mode 100644
index 0000000..b21ff18
--- /dev/null
+++ b/src/zune.c
@@ -0,0 +1,471 @@
+/* SPDX-License-Identifier: MIT */
+#include "zune.h"
+#include "ui.h"
+#include "platform.h"
+
+#include <math.h>
+#include <stdio.h>
+#include <string.h>
+#include <time.h>
+
+/* Sizes are in the launcher's 1024x768, which the Pixel 2 shows at 640x480:
+ * multiply by 0.625 for what reaches the panel. ZF_SMALL is the floor - 26
+ * here is 16 there, and anything under that stops being read at arm's
+ * length. */
+static const struct { int file; int pt; } ZF_SPEC[ZF_COUNT] = {
+	[ZF_HUGE]  = { 0, 168 },
+	[ZF_HUB]   = { 0,  76 },
+	[ZF_PIVOT] = { 0,  54 },
+	[ZF_ROW]   = { 1,  44 },
+	[ZF_SUB]   = { 2,  30 },
+	[ZF_SMALL] = { 2,  26 },
+};
+static const char *const ZF_FILES[3] = {
+	"zune-light.ttf", "zune-semilight.ttf", "zune-regular.ttf",
+};
+
+static TTF_Font *fonts[ZF_COUNT];
+static bool opened;
+
+bool zune_init(SDL_Renderer *r, const char *root, const char *fallback)
+{
+	char path[600];
+	int i;
+
+	(void)r;
+	if (opened) return fonts[ZF_ROW] != NULL;
+	opened = true;
+	for (i = 0; i < ZF_COUNT; i++) {
+		snprintf(path, sizeof path, "%s/fonts/%s", root, ZF_FILES[ZF_SPEC[i].file]);
+		fonts[i] = TTF_OpenFont(path, ZF_SPEC[i].pt);
+		if (!fonts[i] && fallback)
+			fonts[i] = TTF_OpenFont(fallback, ZF_SPEC[i].pt);
+		if (!fonts[i])
+			fprintf(stderr, "zune: no font for role %d: %s\n", i, TTF_GetError());
+	}
+	return fonts[ZF_ROW] != NULL;
+}
+
+/* ---- text ------------------------------------------------------------------ */
+
+#define ZT_CACHE 96
+
+static struct zt_entry {
+	TTF_Font *font;
+	char str[256];
+	SDL_Texture *tex;
+	int w, h;
+	unsigned used;
+} zt[ZT_CACHE];
+static unsigned zt_clock;
+
+void zune_quit(void)
+{
+	int i;
+
+	for (i = 0; i < ZT_CACHE; i++)
+		if (zt[i].tex) SDL_DestroyTexture(zt[i].tex);
+	memset(zt, 0, sizeof zt);
+	for (i = 0; i < ZF_COUNT; i++)
+		if (fonts[i]) { TTF_CloseFont(fonts[i]); fonts[i] = NULL; }
+	opened = false;
+}
+
+TTF_Font *zune_font(zune_font_role role)
+{
+	if (role < 0 || role >= ZF_COUNT) return NULL;
+	return fonts[role];
+}
+
+static struct zt_entry *zt_get(SDL_Renderer *r, TTF_Font *f, const char *s)
+{
+	int i, oldest = 0;
+	SDL_Surface *surf;
+
+	if (!f || !s || !*s) return NULL;
+	for (i = 0; i < ZT_CACHE; i++) {
+		if (zt[i].tex && zt[i].font == f && !strcmp(zt[i].str, s)) {
+			zt[i].used = ++zt_clock;
+			return &zt[i];
+		}
+		if (!zt[i].tex) { oldest = i; break; }
+		if (zt[i].used < zt[oldest].used) oldest = i;
+	}
+	if (zt[oldest].tex) SDL_DestroyTexture(zt[oldest].tex);
+	memset(&zt[oldest], 0, sizeof zt[oldest]);
+	surf = TTF_RenderUTF8_Blended(f, s, (SDL_Color){ 255, 255, 255, 255 });
+	if (!surf) return NULL;
+	zt[oldest].tex = SDL_CreateTextureFromSurface(r, surf);
+	zt[oldest].w = surf->w;
+	zt[oldest].h = surf->h;
+	SDL_FreeSurface(surf);
+	if (!zt[oldest].tex) return NULL;
+	SDL_SetTextureBlendMode(zt[oldest].tex, SDL_BLENDMODE_BLEND);
+	zt[oldest].font = f;
+	snprintf(zt[oldest].str, sizeof zt[oldest].str, "%s", s);
+	zt[oldest].used = ++zt_clock;
+	return &zt[oldest];
+}
+
+int zune_text(SDL_Renderer *r, TTF_Font *f, const char *s, int x, int y,
+              int anchor, SDL_Color col)
+{
+	struct zt_entry *e = zt_get(r, f, s);
+	SDL_Rect dst;
+
+	if (!e) return 0;
+	dst.w = e->w;
+	dst.h = e->h;
+	dst.x = anchor == 0 ? x - e->w / 2 : (anchor > 0 ? x - e->w : x);
+	dst.y = y;
+	SDL_SetTextureColorMod(e->tex, col.r, col.g, col.b);
+	SDL_SetTextureAlphaMod(e->tex, col.a);
+	SDL_RenderCopy(r, e->tex, NULL, &dst);
+	return e->w;
+}
+
+int zune_text_width(TTF_Font *f, const char *s)
+{
+	int w = 0;
+
+	if (f && s && *s) TTF_SizeUTF8(f, s, &w, NULL);
+	return w;
+}
+
+int zune_text_fit(SDL_Renderer *r, TTF_Font *f, const char *s, int x, int y,
+                  int maxw, SDL_Color col)
+{
+	char fit[256];
+
+	if (!f || !s || !*s) return 0;
+	if (zune_text_width(f, s) <= maxw) return zune_text(r, f, s, x, y, -1, col);
+	ui_fit_text(f, s, fit, sizeof fit, maxw);
+	return zune_text(r, f, fit, x, y, -1, col);
+}
+
+void zune_lower(const char *in, char *out, size_t n)
+{
+	size_t i;
+
+	if (!n) return;
+	for (i = 0; in && in[i] && i + 1 < n; i++)
+		out[i] = (in[i] >= 'A' && in[i] <= 'Z') ? (char)(in[i] + 32) : in[i];
+	out[i] = '\0';
+}
+
+SDL_Color zune_rgb(unsigned rgb, Uint8 alpha)
+{
+	return (SDL_Color){ (Uint8)(rgb >> 16), (Uint8)(rgb >> 8), (Uint8)rgb, alpha };
+}
+
+static SDL_Color mix(SDL_Color a, SDL_Color b, float t)
+{
+	if (t < 0) t = 0;
+	if (t > 1) t = 1;
+	return (SDL_Color){ (Uint8)(a.r + (b.r - a.r) * t), (Uint8)(a.g + (b.g - a.g) * t),
+	                    (Uint8)(a.b + (b.b - a.b) * t), (Uint8)(a.a + (b.a - a.a) * t) };
+}
+
+/* ---- chrome ---------------------------------------------------------------- */
+
+void zune_clear(SDL_Renderer *r)
+{
+	SDL_SetRenderDrawBlendMode(r, SDL_BLENDMODE_BLEND);
+	SDL_SetRenderDrawColor(r, 0, 0, 0, 255);
+	SDL_RenderClear(r);
+}
+
+void zune_panorama(SDL_Renderer *r, const char *title, int y, float slide,
+                   SDL_Color col)
+{
+	char low[256];
+
+	zune_lower(title, low, sizeof low);
+	/* The Zune hung its heading slightly off the left edge as well as the
+	 * right, so the first letter's side bearing does not read as a margin. */
+	zune_text(r, zune_font(ZF_HUGE), low, 22 - (int)slide, y, -1, col);
+}
+
+void zune_pivots(SDL_Renderer *r, const char *const *labels, int n, int sel,
+                 int x, int y, unsigned accent)
+{
+	TTF_Font *f = zune_font(ZF_PIVOT);
+	char low[128];
+	int k;
+
+	(void)accent;
+	if (n <= 0) return;
+	for (k = 0; k < n && x < TORTOS_SCREEN_W; k++) {
+		int i = (sel + k) % n;
+
+		zune_lower(labels[i], low, sizeof low);
+		x += zune_text(r, f, low, x, y, -1, k == 0 ? ZUNE_WHITE : ZUNE_DARK) + 34;
+	}
+}
+
+void zune_clock(SDL_Renderer *r)
+{
+	char buf[16];
+	time_t now = time(NULL);
+	struct tm tm;
+	int h;
+
+	if (!localtime_r(&now, &tm)) return;
+	h = tm.tm_hour % 12;
+	snprintf(buf, sizeof buf, "%d:%02d", h ? h : 12, tm.tm_min);
+	zune_text(r, zune_font(ZF_SMALL), buf, TORTOS_SCREEN_W - 28, 14, 1, ZUNE_SOFT);
+}
+
+void zune_tile(SDL_Renderer *r, SDL_Texture *art, int aw, int ah,
+               const SDL_Rect *q, Uint8 alpha)
+{
+	SDL_Rect in;
+	float k;
+
+	SDL_SetRenderDrawBlendMode(r, SDL_BLENDMODE_BLEND);
+	SDL_SetRenderDrawColor(r, 28, 28, 30, alpha);
+	SDL_RenderFillRect(r, q);
+	if (!art || aw <= 0 || ah <= 0) return;
+	k = fminf((float)q->w / aw, (float)q->h / ah);
+	in.w = (int)(aw * k + 0.5f);
+	in.h = (int)(ah * k + 0.5f);
+	in.x = q->x + (q->w - in.w) / 2;
+	in.y = q->y + (q->h - in.h) / 2;
+	SDL_SetTextureAlphaMod(art, alpha);
+	SDL_RenderCopy(r, art, NULL, &in);
+	SDL_SetTextureAlphaMod(art, 255);
+}
+
+/* ---- lists ----------------------------------------------------------------- */
+
+#define ZL_ROW_H  124
+#define ZL_ART    104
+#define ZL_GAP     26
+
+/* Where item `i` sits relative to `pos` on a ring of `count`, in rows: the
+ * shorter way round, so the item just past the end is drawn just above the
+ * first. */
+static float ring_d(int i, float pos, int count)
+{
+	float d = (float)i - pos;
+
+	d = fmodf(d, (float)count);
+	if (d > count / 2.0f) d -= count;
+	if (d <= -count / 2.0f) d += count;
+	return d;
+}
+
+static void list_row(SDL_Renderer *r, const zune_row *row, int x, int y, int w,
+                     bool sel, unsigned accent)
+{
+	SDL_Rect art = { x, y + (ZL_ROW_H - ZL_ART) / 2 - 6, ZL_ART, ZL_ART };
+	int tx = x + ZL_ART + ZL_GAP, tw = w - ZL_ART - ZL_GAP;
+	TTF_Font *ft = zune_font(ZF_ROW), *fs = zune_font(ZF_SUB);
+	int ty = art.y + 2;
+	SDL_Color tc = sel ? zune_rgb(accent, 255) : ZUNE_WHITE;
+	SDL_Color sc = sel ? ZUNE_SOFT : ZUNE_GRAY;
+
+	zune_tile(r, row->art, row->aw, row->ah, &art, sel ? 255 : 190);
+	zune_text_fit(r, ft, row->title, tx, ty, tw, tc);
+	ty += ft ? TTF_FontLineSkip(ft) : 52;
+	if (row->marked) {
+		/* A favorite: a small accent square where a heart would be, the Zune
+		 * marked things with blocks of color rather than icons. */
+		int sz = fs ? TTF_FontAscent(fs) / 2 : 10;
+		SDL_Rect m = { tx, ty + (fs ? TTF_FontAscent(fs) : 20) - sz - 3, sz, sz };
+
+		SDL_SetRenderDrawColor(r, (Uint8)(accent >> 16), (Uint8)(accent >> 8),
+		                       (Uint8)accent, 255);
+		SDL_RenderFillRect(r, &m);
+		if (row->sub && row->sub[0])
+			zune_text_fit(r, fs, row->sub, tx + sz + 12, ty, tw - sz - 12, sc);
+	} else if (row->sub && row->sub[0]) {
+		zune_text_fit(r, fs, row->sub, tx, ty, tw, sc);
+	}
+}
+
+void zune_list(SDL_Renderer *r, const SDL_Rect *area, int count, float pos,
+               int cursor, zune_row_fn get, void *ctx, unsigned accent)
+{
+	int fit = area->h / ZL_ROW_H;
+	zune_row row;
+	int i, k;
+
+	if (count <= 0) return;
+	SDL_RenderSetClipRect(r, area);
+	if (count <= fit) {
+		/* It all fits: nothing scrolls, the selection is what moves. */
+		for (i = 0; i < count; i++) {
+			memset(&row, 0, sizeof row);
+			if (!get(ctx, i, &row)) continue;
+			list_row(r, &row, area->x, area->y + i * ZL_ROW_H, area->w,
+			         i == cursor, accent);
+		}
+	} else {
+		/* The selection rides the second row and the list moves under it. */
+		int base = (int)floorf(pos);
+
+		for (k = base - 2; k <= base + fit + 1; k++) {
+			float d;
+			int y;
+
+			i = ((k % count) + count) % count;
+			d = ring_d(i, pos, count);
+			y = area->y + (int)lroundf((1.0f + d) * ZL_ROW_H);
+			if (y <= area->y - ZL_ROW_H || y >= area->y + area->h) continue;
+			memset(&row, 0, sizeof row);
+			if (!get(ctx, i, &row)) continue;
+			list_row(r, &row, area->x, y, area->w, i == cursor, accent);
+		}
+	}
+	SDL_RenderSetClipRect(r, NULL);
+}
+
+void zune_hub_words(SDL_Renderer *r, const SDL_Rect *area, int count,
+                    float pos, int cursor, zune_word_fn word, void *ctx)
+{
+	TTF_Font *f = zune_font(ZF_HUB);
+	int line = f ? TTF_FontLineSkip(f) + 6 : 110;
+	int fit = area->h / line;
+	char low[160];
+	int i, k;
+
+	if (count <= 0) return;
+	SDL_RenderSetClipRect(r, area);
+	if (count <= fit) {
+		for (i = 0; i < count; i++) {
+			/* The selection eases between words with the shelf: a word is
+			 * white in proportion to how close `pos` is to it, so a move is a
+			 * crossfade down the column rather than a jump. */
+			float near = 1.0f - fminf(1.0f, fabsf(ring_d(i, pos, count)));
+			SDL_Color c = mix(ZUNE_DARK, ZUNE_WHITE, i == cursor ? fmaxf(near, 0.35f) : near);
+
+			zune_lower(word(ctx, i), low, sizeof low);
+			zune_text(r, f, low, area->x, area->y + i * line, -1, c);
+		}
+	} else {
+		int base = (int)floorf(pos);
+
+		for (k = base - 2; k <= base + fit + 1; k++) {
+			float d, near;
+			int y;
+
+			i = ((k % count) + count) % count;
+			d = ring_d(i, pos, count);
+			y = area->y + (int)lroundf((1.0f + d) * line);
+			if (y <= area->y - line || y >= area->y + area->h) continue;
+			near = 1.0f - fminf(1.0f, fabsf(d));
+			zune_lower(word(ctx, i), low, sizeof low);
+			zune_text(r, f, low, area->x, y, -1,
+			          mix(ZUNE_DARK, ZUNE_WHITE, i == cursor ? fmaxf(near, 0.35f) : near));
+		}
+	}
+	SDL_RenderSetClipRect(r, NULL);
+}
+
+/* ---- now playing ----------------------------------------------------------- */
+
+static void mmss(char *out, size_t n, double s)
+{
+	long t = s > 0 ? (long)(s + 0.5) : 0;
+
+	if (t >= 3600) snprintf(out, n, "%ld:%02ld:%02ld", t / 3600, t / 60 % 60, t % 60);
+	else snprintf(out, n, "%ld:%02ld", t / 60, t % 60);
+}
+
+unsigned zune_now_playing(SDL_Renderer *r, const zune_np *np)
+{
+	TTF_Font *fh = zune_font(ZF_HUGE), *ft = zune_font(ZF_ROW),
+	         *fs = zune_font(ZF_SUB), *fm = zune_font(ZF_SMALL);
+	SDL_Color acc = zune_rgb(ZUNE_ACCENT, 255);
+	SDL_Rect cov = { 48, 196, 372, 372 };
+	int tx = cov.x + cov.w + 40, tw = TORTOS_SCREEN_W - tx - 48;
+	char low[256], t0[24], t1[24];
+	unsigned wait = (unsigned)-1;
+	double k = np->len > 0 ? np->at / np->len : 0;
+	int y, bar, fill, aw, travel;
+	float drift;
+
+	zune_clear(r);
+
+	/* The artist, enormous, behind everything and drifting. The Zune HD's
+	 * signature: the name pans slowly across the top of the screen while the
+	 * music plays, and holds still when it stops. */
+	zune_lower(np->artist && np->artist[0] ? np->artist : np->album, low, sizeof low);
+	aw = zune_text_width(fh, low);
+	travel = aw > TORTOS_SCREEN_W - 40 ? aw - (TORTOS_SCREEN_W - 40) + 80 : 80;
+	drift = 0.5f - 0.5f * cosf((float)(np->now_ms % 40000u) / 40000.0f * 6.2831853f);
+	if (np->state) drift = 0.0f;
+	zune_text(r, fh, low, 24 - (int)(drift * travel), -36, -1,
+	          (SDL_Color){ 255, 255, 255, 46 });
+	if (!np->state) wait = 50;
+
+	/* The cover, square, on a tile the size of the cover so a missing one
+	 * still holds its place. */
+	zune_tile(r, NULL, 0, 0, &cov, 255);
+	if (np->cover) {
+		int w, h;
+
+		SDL_QueryTexture(np->cover, NULL, NULL, &w, &h);
+		zune_tile(r, np->cover, w, h, &cov, 255);
+	}
+
+	y = cov.y + 4;
+	if (np->where && np->where[0]) {
+		int gx = tx + zune_text(r, fm, np->where, tx, y, -1, ZUNE_GRAY) + 16;
+		int gs = fm ? TTF_FontAscent(fm) : 24;
+
+		if (np->glyph >= 0)
+			ui_glyph_draw(r, (ui_glyph)np->glyph, gx + gs / 2, y + gs / 2 + 2, gs, acc);
+	}
+	y += (fm ? TTF_FontLineSkip(fm) : 32) + 18;
+	zune_lower(np->title, low, sizeof low);
+	zune_text_fit(r, ft, low, tx, y, tw, ZUNE_WHITE);
+	y += (ft ? TTF_FontLineSkip(ft) : 52) + 8;
+	zune_lower(np->artist, low, sizeof low);
+	zune_text_fit(r, fs, low, tx, y, tw, ZUNE_SOFT);
+	y += fs ? TTF_FontLineSkip(fs) : 36;
+	zune_lower(np->album, low, sizeof low);
+	zune_text_fit(r, fs, low, tx, y, tw, ZUNE_GRAY);
+	y += (fs ? TTF_FontLineSkip(fs) : 36) + 22;
+	if (np->state) {
+		zune_lower(np->state, low, sizeof low);
+		zune_text(r, fs, low, tx, y, -1, acc);
+	}
+	if (np->next && np->next[0]) {
+		int ny = cov.y + cov.h - (fm ? TTF_FontHeight(fm) : 30);
+
+		zune_lower(np->next, low, sizeof low);
+		ny -= (fm ? TTF_FontLineSkip(fm) : 32);
+		zune_text(r, fm, "up next", tx, ny, -1, ZUNE_GRAY);
+		zune_text_fit(r, fm, low, tx, ny + (fm ? TTF_FontLineSkip(fm) : 32), tw, ZUNE_SOFT);
+	}
+
+	/* Where in the track: a hairline the width of the screen, the played part
+	 * in magenta. */
+	bar = cov.y + cov.h + 40;
+	SDL_SetRenderDrawColor(r, 255, 255, 255, 46);
+	SDL_RenderFillRect(r, &(SDL_Rect){ cov.x, bar, TORTOS_SCREEN_W - cov.x * 2, 5 });
+	fill = (int)((TORTOS_SCREEN_W - cov.x * 2) * (k < 0 ? 0 : k > 1 ? 1 : k) + 0.5);
+	if (fill > 0) {
+		SDL_Color c = np->state ? mix(acc, ZUNE_DARK, 0.5f) : acc;
+
+		SDL_SetRenderDrawColor(r, c.r, c.g, c.b, 255);
+		SDL_RenderFillRect(r, &(SDL_Rect){ cov.x, bar, fill, 5 });
+	}
+	mmss(t0, sizeof t0, np->at);
+	ui_text_tabular(r, fm, t0, cov.x, bar + 16, -1, ZUNE_SOFT);
+	if (np->len > 0) {
+		char rem[32];
+
+		mmss(t1, sizeof t1, np->len > np->at ? np->len - np->at : 0);
+		snprintf(rem, sizeof rem, "-%s", t1);
+		ui_text_tabular(r, fm, rem, TORTOS_SCREEN_W - cov.x, bar + 16, 1, ZUNE_SOFT);
+	}
+	if (np->hints && np->hints[0]) {
+		zune_lower(np->hints, low, sizeof low);
+		zune_text(r, fm, low, TORTOS_SCREEN_W / 2, TORTOS_SCREEN_H - 58, 0, ZUNE_DARK);
+	}
+	zune_clock(r);
+	return wait;
+}
