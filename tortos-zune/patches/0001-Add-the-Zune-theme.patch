+/* Step the focused shelf's sort order by `d`, keeping the same game (or
+ * album) under the cursor. The menu's Sort By row, and the Zune's pivots. */
+static void shelf_resort(app *a, int d)
+{
+	sysview *v = &a->view[a->sys_cursor];
+	char keep[LIB_PATH];
