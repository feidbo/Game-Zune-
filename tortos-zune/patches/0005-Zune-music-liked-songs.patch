+/* ---- liked songs -------------------------------------------------------------- */
+
+#define ZX_LIKED_NAME "liked songs"
+#define ZX_LIKED_FILE ML_PLAYLISTS_DIR "/" ZX_LIKED_NAME ".m3u8"
+
+static const char *zx_note;          /* "added to liked songs", on Now Playing */
+static unsigned    zx_note_until;
