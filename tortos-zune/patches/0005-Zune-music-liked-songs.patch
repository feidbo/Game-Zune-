+static char *zx_slurp(const char *rel, size_t *len)
+{
+	char path[LIB_PATH];
+
+	snprintf(path, sizeof path, "%s/%s", ZX_DIR, rel);
+	return zx_slurp_card(path, len);
+}
+
+/* Write `body(f)` to the card's `rel` whole or not at all: a new file,
+ * flushed to the card, then renamed over the old one. */
+static bool zx_write_card(const char *rel, void (*body)(FILE *f))
+{
+	char file[LIB_PATH * 2], tmp[LIB_PATH * 2 + 8], *slash;
+	FILE *f;
+	bool ok;
+
+	snprintf(file, sizeof file, "%s/%s", P_CARD, rel);
+	if ((slash = strrchr(file, '/'))) {
+		*slash = '\0';
+		mkdir(file, 0755);
+		*slash = '/';
+	}
+	snprintf(tmp, sizeof tmp, "%s.new", file);
+	if (!(f = fopen(tmp, "w"))) return false;
+	body(f);
+	ok = fflush(f) == 0 && fsync(fileno(f)) == 0;
+	ok = fclose(f) == 0 && ok;
+	if (!ok || rename(tmp, file) != 0) { remove(tmp); return false; }
+	return true;
+}
