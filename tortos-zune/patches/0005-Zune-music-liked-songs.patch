+static void zx_ratings_body(FILE *f)
+{
+	int i;
+
+	for (i = 0; i < g_muse.ntracks; i++)
+		if (zx_real[i] == i && zx_rate[i])
+			fprintf(f, "%s\t%d\n", g_muse.tracks[i].path, zx_rate[i]);
+}
+
+static void zx_liked_body(FILE *f)
+{
+	int i;
+
+	fprintf(f, "#EXTM3U\n# kept by Game Zune on the Pixel 2: the songs you like, in the order you"
+	           " liked them. Like or unlike a song there to change it.\n");
+	for (i = 0; i < zx_nliked; i++) {
+		int r = zx_liked[i];
+		const zx_meta *m = &zx_m[r];
+
+		if (m->title && m->title[0])
+			fprintf(f, "#EXTINF:%d,%s - %s\n", m->secs > 0 ? m->secs : -1, m->title,
+			        m->artist ? m->artist : "");
+		fprintf(f, "../%s\n", g_muse.tracks[r].path);
+	}
+}
+
+static int zx_liked_at(int r)
+{
+	int i;
+
+	for (i = 0; i < zx_nliked; i++) if (zx_liked[i] == r) return i;
+	return -1;
+}
+
+/* What is liked, in order: the playlist's lines first, then any song rated
+ * "like" that is not on it (liked before there was a playlist). The file is
+ * written again when that is not what it says. */
+static void zx_liked_load(void)
+{
+	int n = g_muse.ntracks, i, lines = 0;
+	bool rated = false, *on = calloc((size_t)n, sizeof *on);
+	char *b = zx_slurp_card(ZX_LIKED_FILE, NULL), *line, *next, rel[LIB_PATH * 2];
+
+	zx_nliked = 0;
+	zx_liked_ver++;
+	if (!on) { free(b); return; }
+	for (line = b; line; line = next) {
+		int r;
+
+		next = strchr(line, '\n');
+		if (next) *next++ = '\0';
+		if (strchr(line, '\r')) *strchr(line, '\r') = '\0';
+		if (!line[0] || line[0] == '#') continue;
+		lines++;
+		if (!ml_playlist_resolve(P_CARD, line, rel, sizeof rel) || (r = zx_find(rel)) < 0 ||
+		    on[r] || zx_rate[r] < 0)
+			continue;
+		if (!zx_rate[r]) { zx_rate[r] = 1; rated = true; }
+		on[r] = true;
+		zx_liked[zx_nliked++] = r;
+	}
+	free(b);
+	for (i = 0; i < n; i++)
+		if (zx_real[i] == i && zx_rate[i] > 0 && !on[i]) zx_liked[zx_nliked++] = i;
+	free(on);
+	if (rated) zx_write_card(ZX_DIR "/ratings.tsv", zx_ratings_body);
+	if (zx_nliked != lines) zx_write_card(ZX_LIKED_FILE, zx_liked_body);
+}
